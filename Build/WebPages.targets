<Project>
  <PropertyGroup>
    <WebPagesSource>$(MSBuildProjectDirectory)\docs\web-index.html</WebPagesSource>
    <WebPagesGenerated>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\WebPages.Index.g.cs</WebPagesGenerated>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(WebPagesGenerated)" Condition="Exists('$(WebPagesGenerated)')" />
  </ItemGroup>
  <!-- 每个 TFM 使用独立 IntermediateOutputPath，杜绝双目标并发写同一文件。 -->
  <Target Name="GenerateWebPagesIndex"
          BeforeTargets="CoreCompile"
          Inputs="$(WebPagesSource);$(MSBuildProjectDirectory)\scripts\generate-webpages-index.ps1;$(MSBuildProjectDirectory)\Build\WebPages.targets"
          Outputs="$(WebPagesGenerated)">
    <Error Condition="!Exists('$(WebPagesSource)')"
           Text="找不到 docs/web-index.html，网页兜底内容无法生成。" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\scripts\generate-webpages-index.ps1&quot; -Root &quot;$(MSBuildProjectDirectory)&quot; -Out &quot;$(WebPagesGenerated)&quot;" />
  </Target>
</Project>