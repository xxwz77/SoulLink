<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SoulLink.Server</RootNamespace>
    <AssemblyName>SoulLink.Server</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- 版本号跟随客户端；本次联机大厅按需访问 + 发车人数 2-4 改造升版本 -->
    <Version>2.1.0</Version>
    <FileVersion>$(Version).0</FileVersion>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <AssemblyTitle>SoulLink 联机大厅服务端</AssemblyTitle>
    <Product>SoulLink</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQLite：单文件数据库，适合轻量服务器 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
  </ItemGroup>

</Project>
