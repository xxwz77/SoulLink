<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ════════════ 全局：点击不留虚线焦点框 ════════════ -->
    <!--
        WPF 默认的 FocusVisualStyle 会在按钮/列表项获得焦点时画一个虚线矩形，
        用户反馈「点击按钮出现虚线框」。这里定义一个空样式，各处显式引用。
    -->
    <Style x:Key="NoFocusVisual">
        <Setter Property="Control.Template" Value="{x:Null}" />
    </Style>

    <!-- ════════════ 色板 ════════════ -->
    <Color x:Key="Bg0">#FF05060C</Color>
    <Color x:Key="Bg1">#FF0B0F22</Color>
    <Color x:Key="Cyan">#FF4FE3FF</Color>
    <Color x:Key="Violet">#FF8B6BFF</Color>
    <Color x:Key="Magenta">#FFFF5FD2</Color>
    <Color x:Key="Mint">#FF41F0C0</Color>
    <Color x:Key="Amber">#FFFFC46B</Color>
    <Color x:Key="Rose">#FFFF6B8B</Color>

    <SolidColorBrush x:Key="TextPrimary" Color="#FFF2F5FF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#B4C2E8FF" />
    <SolidColorBrush x:Key="TextMuted" Color="#7A8CB4E0" />
    <SolidColorBrush x:Key="StrokeSoft" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="StrokeMid" Color="#3CFFFFFF" />
    <SolidColorBrush x:Key="CyanBrush" Color="#FF4FE3FF" />
    <SolidColorBrush x:Key="VioletBrush" Color="#FF8B6BFF" />
    <SolidColorBrush x:Key="MintBrush" Color="#FF41F0C0" />
    <SolidColorBrush x:Key="AmberBrush" Color="#FFFFC46B" />
    <SolidColorBrush x:Key="RoseBrush" Color="#FFFF6B8B" />
    <SolidColorBrush x:Key="MagentaBrush" Color="#FFFF5FD2" />

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF6C5CE7" Offset="0" />
        <GradientStop Color="#FF4FE3FF" Offset="0.55" />
        <GradientStop Color="#FFFF5FD2" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientSoft" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3320C7FF" Offset="0" />
        <GradientStop Color="#33A855F7" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RingGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#55FFFFFF" Offset="0.45" />
        <GradientStop Color="#004FE3FF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFF4D6D" Offset="0" />
        <GradientStop Color="#FFFF9A6B" Offset="1" />
    </LinearGradientBrush>

    <!-- 玻璃卡片：半透明 + 白描边 -->
    <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="0.7,1">
        <GradientStop Color="#26FFFFFF" Offset="0" />
        <GradientStop Color="#0EFFFFFF" Offset="0.35" />
        <GradientStop Color="#0A9BD5FF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassFillStrong" StartPoint="0,0" EndPoint="0.7,1">
        <GradientStop Color="#33FFFFFF" Offset="0" />
        <GradientStop Color="#16FFFFFF" Offset="0.4" />
        <GradientStop Color="#0FAF7BFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassStroke" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#66FFFFFF" Offset="0" />
        <GradientStop Color="#24FFFFFF" Offset="0.45" />
        <GradientStop Color="#12FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="FieldFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1CFFFFFF" Offset="0" />
        <GradientStop Color="#0DFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="InputBg" Color="#260A1226" />

    <DropShadowEffect x:Key="GlowCyan" BlurRadius="26" ShadowDepth="0" Opacity="0.85" Color="#FF4FE3FF" />
    <DropShadowEffect x:Key="GlowViolet" BlurRadius="26" ShadowDepth="0" Opacity="0.8" Color="#FF8B6BFF" />
    <DropShadowEffect x:Key="CardShadow" BlurRadius="34" ShadowDepth="10" Direction="270" Opacity="0.55" Color="#FF02040A" />
    <DropShadowEffect x:Key="SoftGlow" BlurRadius="18" ShadowDepth="0" Opacity="0.6" Color="#FF7C5CFF" />

    <!-- 主题管理器动态更新的画刷：避免 StaticResource 固定旧颜色 -->
    <SolidColorBrush x:Key="NavBackground" Color="#F20A1020" />
    <SolidColorBrush x:Key="PanelBackground" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="FieldBackground" Color="#260A1226" />
    <SolidColorBrush x:Key="WindowBackground" Color="#FF090919" />
    <!-- 菜单、弹窗、输入区与交互状态都由 ThemeManager 同时切换，避免亮色模式露出深色硬编码。 -->
    <SolidColorBrush x:Key="DialogSurface" Color="#FF11132B" />
    <SolidColorBrush x:Key="PopupBackground" Color="#F51B1935" />
    <SolidColorBrush x:Key="HoverFill" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="PressedFill" Color="#3AFFFFFF" />
    <SolidColorBrush x:Key="SelectedFill" Color="#38C9B7F4" />
    <SolidColorBrush x:Key="ButtonBackground" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="ButtonBorder" Color="#2AFFFFFF" />
    <SolidColorBrush x:Key="ControlAccentText" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SubtleSurface" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#55CFC3EF" />

    <!-- ════════════ 字体 ════════════ -->
    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- ════════════ 文本样式 ════════════ -->
    <Style x:Key="BaseText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="Title" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>

    <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="Mono" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>

    <!-- ════════════ 玻璃卡片 ════════════ -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <!-- ★ 实验标记：SOULLINK_NO_EFFECT=1 时由 ThemeManager 清空该效果（见 ThemeManager.ApplyExperimentSwitches） -->
        <Setter Property="Effect" Value="{DynamicResource CardShadow}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="GlassCardStrong" TargetType="Border" BasedOn="{StaticResource GlassCard}">
        <Setter Property="Background" Value="{DynamicResource GlassFillStrong}" />
        <Setter Property="CornerRadius" Value="20" />
    </Style>

    <!-- 侧栏 / 浮层专用：比 GlassCardStrong 更实，避免透出底下画面干扰阅读 -->
    <Style x:Key="NavSurface" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NavBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeMid}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="GlassPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <!-- ════════════ 滚动条 ════════════ -->
    <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent" Margin="1,2">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bar" CornerRadius="3" Background="{DynamicResource ScrollThumb}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
    <Style TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- ════════════ 输入框 ════════════ -->
    <Style x:Key="GlassTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="CaretBrush" Value="{StaticResource CyanBrush}" />
        <Setter Property="SelectionBrush" Value="#804FE3FF" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Shell" CornerRadius="11" Background="{DynamicResource FieldBackground}"
                                BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="1" />
                        <Border x:Name="FocusRing" CornerRadius="11" BorderThickness="1"
                                BorderBrush="{StaticResource CyanBrush}" Opacity="0" />
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource FieldBackground}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="#44FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 内联输入框：用于标题栏这类"高度受限、但要正常左对齐输入"的场景。
         ★ 与 GlassTextBox 的区别只在 Padding：12,9 太大，在 36px 高的框里
           会把文字上下裁掉（用户实测"流程名被遮挡、显示不全"）。
         ★ 与 CompactTextBox 的区别：那个是居中 + 无内边距，适合数字；
           这里是左对齐 + 适中内边距，适合文字。
         ★ 不设 Height，由使用方给最小高度，内容撑开不会裁字。 -->
    <Style x:Key="InlineTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="CaretBrush" Value="{StaticResource CyanBrush}" />
        <Setter Property="SelectionBrush" Value="#804FE3FF" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Shell" CornerRadius="9" Background="{DynamicResource FieldBackground}"
                                BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="1" />
                        <Border x:Name="FocusRing" CornerRadius="9" BorderThickness="1"
                                BorderBrush="{StaticResource CyanBrush}" Opacity="0" />
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="#44FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 紧凑输入框：用于时间/数字等窄框。
         ★ 不使用 GlassTextBox：它固定 Padding=12,9，在 60~80px 的窄框里
           会把文字挤出可视区（用户实测"输入框挡住文字"）。 -->
    <Style x:Key="CompactTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="CaretBrush" Value="{StaticResource CyanBrush}" />
        <Setter Property="SelectionBrush" Value="#804FE3FF" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Shell" CornerRadius="10"
                                Background="{DynamicResource FieldBackground}"
                                BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="1" />
                        <Border x:Name="FocusRing" CornerRadius="10" BorderThickness="1"
                                BorderBrush="{StaticResource CyanBrush}" Opacity="0" />
                        <!-- ★ 关键1：Margin 为 0，文字不会被内边距挤出去。
                             ★ 关键2：ScrollViewer 必须**撑满整个框**（Stretch），
                               否则它的可点击区域只有文字那么宽，
                               点数字右边的空白没反应（用户反馈"不能点右边"）。
                               文字居中由 TextBox 的 TextAlignment 负责，不需要 ScrollViewer 居中。 -->
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="#44FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassPasswordBox" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="CaretBrush" Value="{StaticResource CyanBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="PasswordChar" Value="●" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="Shell" CornerRadius="11" Background="{DynamicResource FieldBackground}"
                                BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="1" />
                        <Border x:Name="FocusRing" CornerRadius="11" BorderThickness="1"
                                BorderBrush="{StaticResource CyanBrush}" Opacity="0" />
                        <!-- ★★ 2.17.47 修复：密码框内容不可见 / 无光标。★★
                             这里原来写 Margin="{TemplateBinding Padding}" —— 而 PasswordBox 会把
                             Padding 再应用一次到内部内容宿主，等于上下各叠 18px。
                             在 RemoteAdminPage 那种 Height=27 的框里，可用高度算成负数，
                             密码点和光标全被裁掉，只剩背景（焦点框却正常亮，能打字但看不见）。
                             去掉这里的 Margin，Padding 交给 PasswordBox 自己处理。 -->
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource FieldBackground}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="#44FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 侧栏浮层里的纯文字导航项：和图标栏的行严格等高（38px），左内边距与图标居中位置对齐 -->
    <Style x:Key="NavTextButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverFill}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════ 按钮 ════════════ -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="Glow" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource CyanBrush}"
                                Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ButtonBorder}" />
                            <Setter TargetName="Glow" Property="Opacity" Value="0.55" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PressedFill}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.35" />
                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- ★ 2.17.25 胶囊按钮：hover 只加亮边框，**不覆盖 Background**。
         为什么需要：IconButton 派生自 GhostButton，它的 Trigger 在 IsMouseOver 时
         会把 Bg 的 Background 直接替换成 ButtonBorder，于是
         "自动运行=绿 / 已停止=灰" 这种**状态色**一悬停就看不见了。 -->
    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="13"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.65" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- 主按钮：渐变霓虹 -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ControlAccentText}" />
        <Setter Property="Padding" Value="22,11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Outer" CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.75" Color="#FF8B6BFF" />
                            </Border.Effect>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF6C5CE7" Offset="0" />
                                    <GradientStop Color="#FF4FE3FF" Offset="0.6" />
                                    <GradientStop Color="#FFFF5FD2" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="Overlay" CornerRadius="12" Background="#33FFFFFF" Opacity="0" />
                        <Border x:Name="Inner" CornerRadius="12" BorderThickness="1" BorderBrush="#55FFFFFF" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Outer" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Outer" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Outer" CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.6" Color="#FFFF4D6D" />
                            </Border.Effect>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFFF3D68" Offset="0" />
                                    <GradientStop Color="#FFFF9A6B" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="Overlay" CornerRadius="12" Background="#33FFFFFF" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Outer" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════ ToggleButton（打开/关闭 分段控件） ════════════ -->
    <Style x:Key="SegmentToggle" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="9" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverFill}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectedFill}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="#55FFFFFF" />
                            <Setter Property="Foreground" Value="{DynamicResource ControlAccentText}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════ 复选框 ════════════ -->
    <!-- 分类页签（联机大厅用）：选中时青色描边 + 淡底 -->
    <Style x:Key="ChipToggle" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Shell" CornerRadius="9" Padding="{TemplateBinding Padding}"
                            Background="#12FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="#44FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="#2E4FE3FF" />
                            <Setter TargetName="Shell" Property="BorderBrush" Value="#AA4FE3FF" />
                            <Setter Property="Foreground" Value="{DynamicResource ControlAccentText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassCheckBox" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="5"
                                Background="{DynamicResource FieldBackground}" BorderBrush="{DynamicResource StrokeMid}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="Tick" Data="M 2.5,7 L 6,11 L 13,3.5" Stroke="#FFFFFFFF" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Opacity="0" />
                        </Border>
                        <!-- ★ 必须显式把 Foreground 传给内容：
                             ContentPresenter 默认不继承 CheckBox 的 Foreground，
                             内容是字符串时会落到系统默认色（浅灰/黑），
                             深色背景上看不清（用户反馈"菜单名字颜色有问题"）。 -->
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF6C5CE7" Offset="0" />
                                        <GradientStop Color="#FF4FE3FF" Offset="1" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Box" Property="BorderBrush" Value="#88FFFFFF" />
                            <Setter TargetName="Tick" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#77FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════ 列表项 ════════════ -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="11" Background="Transparent" />
                        <Border x:Name="Bar" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left"
                                Margin="4,0,0,0" Background="{StaticResource AccentGradient}" Opacity="0" />
                        <ContentPresenter Margin="16,9" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverFill}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectedFill}" />
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource ControlAccentText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassListBox" TargetType="ListBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource NavItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 动作卡片列表 -->
    <Style x:Key="ActionCardItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="13" Background="#10FFFFFF" BorderBrush="#1EFFFFFF" BorderThickness="1" />
                        <Border x:Name="Ring" CornerRadius="13" BorderThickness="1" Opacity="0"
                                BorderBrush="{StaticResource CyanBrush}" />
                        <ContentPresenter Margin="14,11" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverFill}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource PressedFill}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ButtonBorder}" />
                            <Setter TargetName="Ring" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ActionListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ActionCardItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════ 会话行 ════════════ -->
    <Style x:Key="SessionItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="12" Background="{DynamicResource SubtleSurface}" BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="1" />
                        <ContentPresenter Margin="13,10" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverFill}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectedFill}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource StrokeMid}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════ 分隔线 ════════════ -->
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,12" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00FFFFFF" Offset="0" />
                    <GradientStop Color="#2AFFFFFF" Offset="0.5" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════ ToolTip ════════════ -->
    <Style TargetType="ToolTip">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource WindowBackground}" CornerRadius="9" BorderBrush="{DynamicResource StrokeMid}" BorderThickness="1" Padding="11,7">
                        <ContentPresenter TextBlock.Foreground="{DynamicResource TextPrimary}"
                                          TextBlock.FontFamily="{StaticResource UiFont}" TextBlock.FontSize="11.5" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════ Slider（玻璃风） ════════════ -->
    <!-- ★ 默认 WPF Slider 是白色粗条 + 方头，和本应用玻璃风完全不搭。
         这里整体重做模板：
           · 轨道 4px 圆角，已填充段用青色渐变，未填充段是低透明度白
           · 滑块 16px 圆点，带青色描边与外发光，悬停/拖动时放大
           · 去掉默认的刻度线（TickFrequency 仍保留以支持离散取值） -->
    <Style x:Key="GlassSliderThumb" TargetType="Thumb">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="18" Height="18" Background="Transparent">
                        <Ellipse x:Name="Halo" Width="18" Height="18" Opacity="0">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#884FE3FF" Offset="0.0" />
                                    <GradientStop Color="#004FE3FF" Offset="1.0" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse x:Name="Core" Width="12" Height="12" Fill="#FFFFFFFF"
                                 Stroke="{StaticResource CyanBrush}" StrokeThickness="2" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="1" />
                            <Setter TargetName="Core" Property="Width" Value="13" />
                            <Setter TargetName="Core" Property="Height" Value="13" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="1" />
                            <Setter TargetName="Core" Property="Width" Value="14" />
                            <Setter TargetName="Core" Property="Height" Value="14" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassSlider" TargetType="Slider">
        <Setter Property="Height" Value="24" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" Background="#26FFFFFF" />
                        <!-- 已填充段：用青色→紫罗兰渐变，和标题栏光晕呼应 -->
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="{StaticResource Cyan}" Offset="0" />
                                                        <GradientStop Color="{StaticResource Violet}" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource GlassSliderThumb}"
                                       Width="18" Height="18" Margin="0,0,0,0" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════ ComboBox（玻璃风） ════════════ -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border CornerRadius="10" Background="{DynamicResource FieldBackground}" BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="8" Margin="4,1" Background="Transparent" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverFill}" />
                            <Setter Property="Foreground" Value="{DynamicResource ControlAccentText}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectedFill}" />
                            <Setter Property="Foreground" Value="{DynamicResource ControlAccentText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Style="{StaticResource ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border x:Name="FocusRing" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource CyanBrush}" Opacity="0" />
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center" IsHitTestVisible="False" />
                            <Path Grid.Column="1" Data="M 0,0 L 5,5 L 10,0" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"
                                  Margin="10,2,0,0" />
                        </Grid>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade" StaysOpen="False">
                            <Border Background="{DynamicResource WindowBackground}" CornerRadius="13" BorderBrush="{DynamicResource StrokeMid}" BorderThickness="1"
                                    Margin="0,6,0,0" Padding="4,6" MinWidth="{TemplateBinding ActualWidth}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.7" Color="#FF000000" />
                                </Border.Effect>
                                <ScrollViewer MaxHeight="260">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Toggle" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ════════════ 右键菜单 ════════════ -->
    <!-- ★ ContextMenu 的默认模板是系统 Aero2，深色主题下会露出白底和系统配色。
         这里给 Template 显式指定，才能让 Background/圆角和整体一致。 -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource PopupBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeMid}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border CornerRadius="10" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ★ MenuItem 必须自带完整模板：
         Aero2 默认模板用系统高亮色、带白色勾选块，且测量宽度不含勾选列，
         实测表现为"文字被裁掉 + 白方块"，与深色主题完全不搭。 -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bg" CornerRadius="7" Background="Transparent" Padding="8,6"
                            MinWidth="180">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- 勾选标记 -->
                            <TextBlock x:Name="Check" Grid.Column="0" Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       VerticalAlignment="Center" Visibility="Collapsed"
                                       Foreground="{StaticResource CyanBrush}" />
                            <!-- 图标（可选） -->
                            <ContentPresenter x:Name="Icon" Grid.Column="0"
                                              ContentSource="Icon" VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header"
                                              RecognizesAccessKey="True" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectedFill}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="DialogHost" TargetType="Grid">
        <Setter Property="Margin" Value="16" />
        <Setter Property="Effect" Value="{DynamicResource CardShadow}" />
    </Style>

    <Style TargetType="Control">
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}" />
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>

</ResourceDictionary>
