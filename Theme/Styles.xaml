<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ════════════ 全局：点击不留虚线焦点框 ════════════ -->
    <!--
        WPF 默认的 FocusVisualStyle 会在按钮/列表项获得焦点时画一个虚线矩形，
        用户反馈「点击按钮出现虚线框」。这里定义一个空样式，各处显式引用。
    -->
    <Style x:Key="NoFocusVisual">
        <Setter Property="Control.Template" Value="{x:Null}" />
    </Style>

    <!-- ════════════ 色板 ════════════ -->
    <Color x:Key="Bg0">#FF05060C</Color>
    <Color x:Key="Bg1">#FF0B0F22</Color>
    <Color x:Key="Cyan">#FF4FE3FF</Color>
    <Color x:Key="Violet">#FF8B6BFF</Color>
    <Color x:Key="Magenta">#FFFF5FD2</Color>
    <Color x:Key="Mint">#FF41F0C0</Color>
    <Color x:Key="Amber">#FFFFC46B</Color>
    <Color x:Key="Rose">#FFFF6B8B</Color>

    <SolidColorBrush x:Key="TextPrimary" Color="#FFF2F5FF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#B4C2E8FF" />
    <SolidColorBrush x:Key="TextMuted" Color="#7A8CB4E0" />
    <SolidColorBrush x:Key="StrokeSoft" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="StrokeMid" Color="#3CFFFFFF" />
    <SolidColorBrush x:Key="CyanBrush" Color="#FF4FE3FF" />
    <SolidColorBrush x:Key="VioletBrush" Color="#FF8B6BFF" />
    <SolidColorBrush x:Key="MintBrush" Color="#FF41F0C0" />
    <SolidColorBrush x:Key="AmberBrush" Color="#FFFFC46B" />
    <SolidColorBrush x:Key="RoseBrush" Color="#FFFF6B8B" />
    <SolidColorBrush x:Key="MagentaBrush" Color="#FFFF5FD2" />

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF6C5CE7" Offset="0" />
        <GradientStop Color="#FF4FE3FF" Offset="0.55" />
        <GradientStop Color="#FFFF5FD2" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientSoft" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3320C7FF" Offset="0" />
        <GradientStop Color="#33A855F7" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RingGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#55FFFFFF" Offset="0.45" />
        <GradientStop Color="#004FE3FF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFF4D6D" Offset="0" />
        <GradientStop Color="#FFFF9A6B" Offset="1" />
    </LinearGradientBrush>

    <!-- 玻璃卡片：半透明 + 白描边 -->
    <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="0.7,1">
        <GradientStop Color="#26FFFFFF" Offset="0" />
        <GradientStop Color="#0EFFFFFF" Offset="0.35" />
        <GradientStop Color="#0A9BD5FF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassFillStrong" StartPoint="0,0" EndPoint="0.7,1">
        <GradientStop Color="#33FFFFFF" Offset="0" />
        <GradientStop Color="#16FFFFFF" Offset="0.4" />
        <GradientStop Color="#0FAF7BFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassStroke" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#66FFFFFF" Offset="0" />
        <GradientStop Color="#24FFFFFF" Offset="0.45" />
        <GradientStop Color="#12FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="FieldFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1CFFFFFF" Offset="0" />
        <GradientStop Color="#0DFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="InputBg" Color="#260A1226" />
    <SolidColorBrush x:Key="HoverFill" Color="#1FFFFFFF" />

    <DropShadowEffect x:Key="GlowCyan" BlurRadius="26" ShadowDepth="0" Opacity="0.85" Color="#FF4FE3FF" />
    <DropShadowEffect x:Key="GlowViolet" BlurRadius="26" ShadowDepth="0" Opacity="0.8" Color="#FF8B6BFF" />
    <DropShadowEffect x:Key="CardShadow" BlurRadius="34" ShadowDepth="10" Direction="270" Opacity="0.55" Color="#FF02040A" />
    <DropShadowEffect x:Key="SoftGlow" BlurRadius="18" ShadowDepth="0" Opacity="0.6" Color="#FF7C5CFF" />

    <!-- 主题管理器动态更新的画刷：避免 StaticResource 固定旧颜色 -->
    <SolidColorBrush x:Key="NavBackground" Color="#F20A1020" />
    <SolidColorBrush x:Key="PanelBackground" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="FieldBackground" Color="#260A1226" />
    <SolidColorBrush x:Key="WindowBackground" Color="#FF070A16" />

    <!-- ════════════ 字体 ════════════ -->
    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- ════════════ 文本样式 ════════════ -->
    <Style x:Key="BaseText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="Title" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>

    <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="Mono" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>

    <!-- ════════════ 玻璃卡片 ════════════ -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassFill}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Effect" Value="{StaticResource CardShadow}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="GlassCardStrong" TargetType="Border" BasedOn="{StaticResource GlassCard}">
        <Setter Property="Background" Value="{StaticResource GlassFillStrong}" />
        <Setter Property="CornerRadius" Value="20" />
    </Style>

    <!-- 侧栏 / 浮层专用：比 GlassCardStrong 更实，避免透出底下画面干扰阅读 -->
    <Style x:Key="NavSurface" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NavBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeMid}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="GlassPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <!-- ════════════ 滚动条 ════════════ -->
    <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent" Margin="1,2">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bar" CornerRadius="3" Background="#40FFFFFF" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
    <Style TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- ════════════ 输入框 ════════════ -->
    <Style x:Key="GlassTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="CaretBrush" Value="{StaticResource CyanBrush}" />
        <Setter Property="SelectionBrush" Value="#804FE3FF" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Shell" CornerRadius="11" Background="{StaticResource FieldBackground}"
                                BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1" />
                        <Border x:Name="FocusRing" CornerRadius="11" BorderThickness="1"
                                BorderBrush="{StaticResource CyanBrush}" Opacity="0" />
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            <Setter TargetName="Shell" Property="Background" Value="{StaticResource FieldBackground}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="#44FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassPasswordBox" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="CaretBrush" Value="{StaticResource CyanBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="PasswordChar" Value="●" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="Shell" CornerRadius="11" Background="{StaticResource FieldBackground}"
                                BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1" />
                        <Border x:Name="FocusRing" CornerRadius="11" BorderThickness="1"
                                BorderBrush="{StaticResource CyanBrush}" Opacity="0" />
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            <Setter TargetName="Shell" Property="Background" Value="{StaticResource FieldBackground}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="#44FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 侧栏浮层里的纯文字导航项：和图标栏的行严格等高（38px），左内边距与图标居中位置对齐 -->
    <Style x:Key="NavTextButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════ 按钮 ════════════ -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="#16FFFFFF" />
        <Setter Property="BorderBrush" Value="#2AFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="Glow" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource CyanBrush}"
                                Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#2AFFFFFF" />
                            <Setter TargetName="Glow" Property="Opacity" Value="0.55" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#3AFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.35" />
                            <Setter Property="Foreground" Value="#8AFFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- 主按钮：渐变霓虹 -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="Padding" Value="22,11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Outer" CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.75" Color="#FF8B6BFF" />
                            </Border.Effect>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF6C5CE7" Offset="0" />
                                    <GradientStop Color="#FF4FE3FF" Offset="0.6" />
                                    <GradientStop Color="#FFFF5FD2" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="Overlay" CornerRadius="12" Background="#33FFFFFF" Opacity="0" />
                        <Border x:Name="Inner" CornerRadius="12" BorderThickness="1" BorderBrush="#55FFFFFF" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Outer" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Outer" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Outer" CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.6" Color="#FFFF4D6D" />
                            </Border.Effect>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFFF3D68" Offset="0" />
                                    <GradientStop Color="#FFFF9A6B" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="Overlay" CornerRadius="12" Background="#33FFFFFF" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Outer" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════ ToggleButton（打开/关闭 分段控件） ════════════ -->
    <Style x:Key="SegmentToggle" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="9" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#18FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="#55FFFFFF" />
                            <Setter Property="Foreground" Value="#FFFFFFFF" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════ 复选框 ════════════ -->
    <Style x:Key="GlassCheckBox" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="5"
                                Background="{StaticResource FieldBackground}" BorderBrush="#3AFFFFFF" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="Tick" Data="M 2.5,7 L 6,11 L 13,3.5" Stroke="#FFFFFFFF" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Opacity="0" />
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF6C5CE7" Offset="0" />
                                        <GradientStop Color="#FF4FE3FF" Offset="1" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Box" Property="BorderBrush" Value="#88FFFFFF" />
                            <Setter TargetName="Tick" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#77FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════ 列表项 ════════════ -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="11" Background="Transparent" />
                        <Border x:Name="Bar" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left"
                                Margin="4,0,0,0" Background="{StaticResource AccentGradient}" Opacity="0" />
                        <ContentPresenter Margin="16,9" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="#FFFFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassListBox" TargetType="ListBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource NavItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 动作卡片列表 -->
    <Style x:Key="ActionCardItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="13" Background="#10FFFFFF" BorderBrush="#1EFFFFFF" BorderThickness="1" />
                        <Border x:Name="Ring" CornerRadius="13" BorderThickness="1" Opacity="0"
                                BorderBrush="{StaticResource CyanBrush}" />
                        <ContentPresenter Margin="14,11" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#1EFFFFFF" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="#3AFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#2AFFFFFF" />
                            <Setter TargetName="Ring" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ActionListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ActionCardItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════ 会话行 ════════════ -->
    <Style x:Key="SessionItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="12" Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" />
                        <ContentPresenter Margin="13,10" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#1EFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#2CFFFFFF" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="#66FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════ 分隔线 ════════════ -->
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,12" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00FFFFFF" Offset="0" />
                    <GradientStop Color="#2AFFFFFF" Offset="0.5" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════ ToolTip ════════════ -->
    <Style TargetType="ToolTip">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource WindowBackground}" CornerRadius="9" BorderBrush="#44FFFFFF" BorderThickness="1" Padding="11,7">
                        <ContentPresenter TextBlock.Foreground="{StaticResource TextPrimary}"
                                          TextBlock.FontFamily="{StaticResource UiFont}" TextBlock.FontSize="11.5" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════ ComboBox（玻璃风） ════════════ -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border CornerRadius="10" Background="{StaticResource FieldBackground}" BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="8" Margin="4,1" Background="Transparent" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#1EFFFFFF" />
                            <Setter Property="Foreground" Value="#FFFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF" />
                            <Setter Property="Foreground" Value="#FFFFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Style="{StaticResource ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border x:Name="FocusRing" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource CyanBrush}" Opacity="0" />
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center" IsHitTestVisible="False" />
                            <Path Grid.Column="1" Data="M 0,0 L 5,5 L 10,0" Stroke="#AAC8E4FF" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"
                                  Margin="10,2,0,0" />
                        </Grid>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade" StaysOpen="False">
                            <Border Background="{StaticResource WindowBackground}" CornerRadius="13" BorderBrush="#44FFFFFF" BorderThickness="1"
                                    Margin="0,6,0,0" Padding="4,6" MinWidth="{TemplateBinding ActualWidth}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.7" Color="#FF000000" />
                                </Border.Effect>
                                <ScrollViewer MaxHeight="260">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Toggle" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource WindowBackground}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeMid}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6" />
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}" />
    </Style>


    <Style TargetType="Control">
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}" />
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>

</ResourceDictionary>
