<UserControl x:Class="SoulLink.Controls.RdpGeneralSettings"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ctl="clr-namespace:SoulLink.Controls" FontFamily="{StaticResource UiFont}">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel>
   <TextBlock Text="RDP 通用设置" Style="{StaticResource Title}" />
   <TextBlock Text="以下交互设置作用于全部用户，不修改单个用户的连接参数。"
              Style="{StaticResource Caption}" Margin="0,5,0,16" TextWrapping="Wrap" />
   <Border Style="{StaticResource GlassPanel}" Padding="16,14">
    <StackPanel>
     <CheckBox x:Name="CaptureClickCheck" Style="{StaticResource GlassCheckBox}"
               Content="点击画面才捕获键鼠，移出立即释放" />
     <TextBlock Text="切页、失焦、最小化、断开时也会释放；自由视角仍可手动开启。"
                Style="{StaticResource Caption}" Margin="28,8,0,0" TextWrapping="Wrap" />

     <!-- 灵敏度：标签左、数值右。
          ★ 两个 TextBlock 必须显式指定 Grid.Column，否则都落在第 0 列叠在一起（曾经踩过）。 -->
     <Grid Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*" />
       <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="自由视角灵敏度" Style="{StaticResource Label}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" x:Name="SensitivityText" Text="4.0x" Style="{StaticResource Mono}"
                 Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center" />
     </Grid>
     <Slider x:Name="SensitivitySlider" Style="{StaticResource GlassSlider}"
             Minimum="1" Maximum="12" TickFrequency="0.1" SmallChange="0.1" LargeChange="0.5"
             Margin="0,10,0,0" ValueChanged="Sensitivity_Changed" />

     <Grid Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*" />
       <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="切换自由视角的热键" Style="{StaticResource Label}" VerticalAlignment="Center"
                 ToolTip="按一次进入自由视角，再按一次切回指针模式（可反复启停）" />
      <ctl:HotkeyRecorder Grid.Column="1" x:Name="GlobalHotkey" Style="{StaticResource GhostButton}" Width="180" Height="36" />
     </Grid>
    </StackPanel>
   </Border>
   <TextBlock x:Name="SavedText" Text="修改会立即保存，并同步到所有已打开的用户画面。"
              Style="{StaticResource Caption}" Margin="2,12,0,0" />
  </StackPanel>
 </ScrollViewer>
</UserControl>
