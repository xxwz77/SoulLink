<UserControl x:Class="SoulLink.Controls.RdpGeneralSettings"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ctl="clr-namespace:SoulLink.Controls" FontFamily="{StaticResource UiFont}">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel>
   <TextBlock Text="RDP 通用设置" Style="{StaticResource Title}" />
   <TextBlock Text="以下交互设置作用于全部用户，不修改单个用户的连接参数。"
              Style="{StaticResource Caption}" Margin="0,5,0,16" TextWrapping="Wrap" />
   <Border Style="{StaticResource GlassPanel}" Padding="16,14">
    <StackPanel>
     <CheckBox x:Name="CaptureClickCheck" Style="{StaticResource GlassCheckBox}"
               Content="点击画面才捕获键鼠，移出立即释放" />
     <TextBlock Text="切页、失焦、最小化、断开时也会释放；自由视角仍可手动开启。"
                Style="{StaticResource Caption}" Margin="28,8,0,0" TextWrapping="Wrap" />
     <Grid Margin="0,18,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock Text="自由视角灵敏度" Style="{StaticResource Label}" VerticalAlignment="Center" />
      <TextBlock x:Name="SensitivityText" Text="4.0x" Foreground="{StaticResource CyanBrush}" />
     </Grid>
     <Slider x:Name="SensitivitySlider" Minimum="1" Maximum="12" TickFrequency="0.1" ValueChanged="Sensitivity_Changed" />
     <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock Text="退出自由视角的热键" Style="{StaticResource Label}" VerticalAlignment="Center" />
      <ctl:HotkeyRecorder x:Name="GlobalHotkey" Style="{StaticResource GhostButton}" Width="180" Height="36" />
     </Grid>
    </StackPanel>
   </Border>
   <TextBlock x:Name="SavedText" Text="修改会立即保存，并同步到所有已打开的用户画面。"
              Style="{StaticResource Caption}" Margin="2,12,0,0" />
  </StackPanel>
 </ScrollViewer>
</UserControl>