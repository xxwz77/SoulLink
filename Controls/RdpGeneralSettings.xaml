<UserControl x:Class="SoulLink.Controls.RdpGeneralSettings"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ctl="clr-namespace:SoulLink.Controls" FontFamily="{StaticResource UiFont}">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel>
   <TextBlock Text="RDP 通用设置" Style="{StaticResource Title}" />
   <TextBlock Text="以下交互设置作用于全部用户，不修改单个用户的连接参数。"
              Style="{StaticResource Caption}" Margin="0,5,0,16" TextWrapping="Wrap" />
   <Border Style="{StaticResource GlassPanel}" Padding="16,14">
    <StackPanel>
     <CheckBox x:Name="CaptureClickCheck" Style="{StaticResource GlassCheckBox}"
               Content="点击画面才捕获键鼠，移出立即释放" />
     <TextBlock Text="切页、失焦、最小化、断开时也会释放；自由视角需手动开启。用于防止意外滑动影响 BGI 地图拖动。"
                Style="{StaticResource Caption}" Margin="28,8,0,0" TextWrapping="Wrap" />

     <!-- 灵敏度：标签左、数值右。
          ★ 两个 TextBlock 必须显式指定 Grid.Column，否则都落在第 0 列叠在一起（曾经踩过）。 -->
     <Grid Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*" />
       <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="自由视角灵敏度" Style="{StaticResource Label}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" x:Name="SensitivityText" Text="4.0x" Style="{StaticResource Mono}"
                 Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center" />
     </Grid>
     <Slider x:Name="SensitivitySlider" Style="{StaticResource GlassSlider}"
             Minimum="1" Maximum="12" TickFrequency="0.1" SmallChange="0.1" LargeChange="0.5"
             Margin="0,10,0,0" ValueChanged="Sensitivity_Changed" />

     <Grid Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*" />
       <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="切换自由视角的热键" Style="{StaticResource Label}" VerticalAlignment="Center"
                 ToolTip="支持单键、修饰键组合、鼠标中键/侧键；录制后立即生效" />
      <ctl:HotkeyRecorder Grid.Column="1" x:Name="GlobalHotkey" Style="{StaticResource GhostButton}" Width="180" Height="36" />
     </Grid>

     <!-- ★★ 3.2.4：全屏热键开放配置 ★★
          原来 F11 写死在代码里，而它**有概率被 RDP 控件抢走**（RDP 自己的键盘处理
          在某些时刻先于本机 LL 钩子），用户反映"进去了出不来"。
          现在两个键都可以自己改：
            · 进/出全屏：默认 F11
            · 退出全屏：默认 Esc，只在全屏时生效（非全屏不吞键），作为最后逃生通道 -->
     <Grid Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*" />
       <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="进入/退出全屏的热键" Style="{StaticResource Label}" VerticalAlignment="Center"
                 ToolTip="默认 F11。若全屏后按它没反应（被 RDP 或游戏吞掉），换成别的组合键，例如 Ctrl+Alt+F" />
      <ctl:HotkeyRecorder Grid.Column="1" x:Name="FullScreenHotkeyRecorder" Style="{StaticResource GhostButton}" Width="180" Height="36" />
     </Grid>

     <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*" />
       <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="退出全屏的备用热键" Style="{StaticResource Label}" VerticalAlignment="Center"
                 ToolTip="默认 Escape。只在全屏时生效，按下立刻退出全屏；非全屏时原样透传给画面，不拦截。" />
      <ctl:HotkeyRecorder Grid.Column="1" x:Name="ExitFullScreenHotkeyRecorder" Style="{StaticResource GhostButton}" Width="180" Height="36" />
     </Grid>

     <TextBlock Text="全屏模式下按键会送给 RDP 画面，若某个键按了没反应（例如 F11 被游戏占用），换一个即可。备用热键是全屏下的最后逃生通道，建议保留默认的 Esc。"
                Style="{StaticResource Caption}" Margin="2,8,0,0" TextWrapping="Wrap" />

     <!-- ── 保护层边框 ─────────────────────────────────────────────
          ★ 锁定态时才出现，框住 RDP 画布。默认色故意与焦点边框区分开，
            否则用户会误以为"保护层没生效、只是焦点高亮"。
          ★ 画在主窗口内部的 WPF Border 上，不是独立分层窗口。 -->
     <Border Style="{StaticResource Divider}" Margin="0,18,0,0" />
     <TextBlock Text="保护层边框" Style="{StaticResource Label}" Margin="0,14,0,0"
                ToolTip="锁定态时框住 RDP 画布的边框颜色" />

     <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="Auto" />
       <ColumnDefinition Width="*" />
       <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <!-- 颜色预览块：跟着输入实时变色 -->
      <Border Grid.Column="0" x:Name="ShieldColorPreview" Width="34" Height="34" CornerRadius="8"
              VerticalAlignment="Center" BorderThickness="1" BorderBrush="#44FFFFFF"
              Background="#CCF0C041" />
      <TextBox Grid.Column="1" x:Name="ShieldColorBox" Style="{StaticResource GlassTextBox}"
               Margin="10,0,10,0" VerticalAlignment="Center"
               FontFamily="{StaticResource MonoFont}"
               ToolTip="支持 #RGB / #RRGGBB / #AARRGGBB（前两位是透明度，FF=不透明）"
               TextChanged="ShieldColor_TextChanged" />
      <Button Grid.Column="2" x:Name="ShieldColorReset" Content="恢复默认"
              Style="{StaticResource GhostButton}" Padding="12,6" VerticalAlignment="Center"
              Click="ShieldColorReset_Click" />
     </Grid>
     <TextBlock Text="格式 #AARRGGBB，前两位是透明度（AA ≈ 67%、FF = 不透明）。留空使用主题默认色。"
                Style="{StaticResource Caption}" Margin="44,6,0,0" TextWrapping="Wrap" />

     <Grid Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*" />
       <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="边框粗细" Style="{StaticResource Label}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" x:Name="ShieldThicknessText" Text="2 px" Style="{StaticResource Mono}"
                 Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center" />
     </Grid>
     <Slider x:Name="ShieldThicknessSlider" Style="{StaticResource GlassSlider}"
             Minimum="0" Maximum="8" TickFrequency="1" SmallChange="1" LargeChange="1"
             Margin="0,10,0,0" ValueChanged="ShieldThickness_Changed" />
     <TextBlock Text="0 = 不显示保护层边框。" Style="{StaticResource Caption}" Margin="2,6,0,0" />
    </StackPanel>
   </Border>
   <TextBlock Text="支持键盘单键/组合键与鼠标中键、侧键（可带 Ctrl/Alt/Shift/Win）。录制完成立即生效；按 Esc 取消。&#x0a;旧热键在录制期间暂停。若设置左键为热键，需另用键盘打开画面，避免无法点击。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,10,0,0" />
   <TextBlock x:Name="SavedText" Text="修改会立即保存，并同步到所有已打开的用户画面。"
              Style="{StaticResource Caption}" Margin="2,12,0,0" />
  </StackPanel>
 </ScrollViewer>
</UserControl>