<UserControl x:Class="SoulLink.Controls.RdpGeneralSettings"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ctl="clr-namespace:SoulLink.Controls" FontFamily="{StaticResource UiFont}">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel>
   <TextBlock Text="RDP 通用设置" Style="{StaticResource Title}" />
   <TextBlock Text="以下交互设置作用于全部用户，不修改单个用户的连接参数。"
              Style="{StaticResource Caption}" Margin="0,5,0,16" TextWrapping="Wrap" />
   <Border Style="{StaticResource GlassPanel}" Padding="16,14">
    <StackPanel>
     <CheckBox x:Name="CaptureClickCheck" Style="{StaticResource GlassCheckBox}"
               Content="点击画面才捕获键鼠，移出立即释放" />
     <TextBlock Text="切页、失焦、最小化、断开时也会释放；自由视角需手动开启。用于防止意外滑动影响 BGI 地图拖动。"
                Style="{StaticResource Caption}" Margin="28,8,0,0" TextWrapping="Wrap" />

     <!-- 灵敏度：标签左、数值右。
          ★ 两个 TextBlock 必须显式指定 Grid.Column，否则都落在第 0 列叠在一起（曾经踩过）。 -->
     <Grid Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*" />
       <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="自由视角灵敏度" Style="{StaticResource Label}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" x:Name="SensitivityText" Text="4.0x" Style="{StaticResource Mono}"
                 Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center" />
     </Grid>
     <Slider x:Name="SensitivitySlider" Style="{StaticResource GlassSlider}"
             Minimum="1" Maximum="12" TickFrequency="0.1" SmallChange="0.1" LargeChange="0.5"
             Margin="0,10,0,0" ValueChanged="Sensitivity_Changed" />

     <Grid Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*" />
       <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="切换自由视角的热键" Style="{StaticResource Label}" VerticalAlignment="Center"
                 ToolTip="支持单键、修饰键组合、鼠标中键/侧键；录制后立即生效" />
      <ctl:HotkeyRecorder Grid.Column="1" x:Name="GlobalHotkey" Style="{StaticResource GhostButton}" Width="180" Height="36" />
     </Grid>

     <!-- ★★ 3.2.4：全屏热键开放配置 ★★
          原来 F11 写死在代码里，而它**有概率被 RDP 控件抢走**（RDP 自己的键盘处理
          在某些时刻先于本机 LL 钩子），用户反映"进去了出不来"。
          现在两个键都可以自己改：
            · 进/出全屏：默认 F11
            · 退出全屏：默认 Esc，只在全屏时生效（非全屏不吞键），作为最后逃生通道 -->
     <Grid Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*" />
       <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="进入/退出全屏的热键" Style="{StaticResource Label}" VerticalAlignment="Center"
                 ToolTip="默认 F11。若全屏后按它没反应（被 RDP 或游戏吞掉），换成别的组合键，例如 Ctrl+Alt+F" />
      <ctl:HotkeyRecorder Grid.Column="1" x:Name="FullScreenHotkeyRecorder" Style="{StaticResource GhostButton}" Width="180" Height="36" />
     </Grid>

     <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*" />
       <ColumnDefinition Width="Auto" />
       <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="退出全屏的备用热键（可选）" Style="{StaticResource Label}" VerticalAlignment="Center"
                 ToolTip="默认留空 = 不启用，全屏时只有上面那个键能进出。想加一条退路就自己录一个——注意别和游戏常用键冲突（Esc 在游戏里是菜单键，不建议）。" />
      <ctl:HotkeyRecorder Grid.Column="1" x:Name="ExitFullScreenHotkeyRecorder" Style="{StaticResource GhostButton}" Width="150" Height="36" />
      <Button Grid.Column="2" x:Name="ExitFullScreenHotkeyClear" Content="清除"
              Style="{StaticResource GhostButton}" Padding="10,6" Margin="6,0,0,0" VerticalAlignment="Center"
              ToolTip="清空 = 不钩任何键"
              Click="ExitFullScreenHotkeyClear_Click" />
     </Grid>

     <TextBlock Text="★ 默认不占用 Esc —— 游戏里 Esc 是菜单/取消键，被拦截会导致游戏没法用。若你想给自己留一条额外的退出退路，再自己录一个（例如 Ctrl+Shift+Q）。两个热键都只在全屏时生效，非全屏一律原样送给画面，绝不拦截。"
                Style="{StaticResource Caption}" Margin="2,8,0,0" TextWrapping="Wrap" />

     <!-- ══════════ 屏幕录制（3.2.8）══════════
          用户需求：「在 RDP 通用配置里增加一个设置栏目，对目标用户（RDP 配置里
                    有的用户，可多选）开启录像功能，然后用户可以设置录像时长」。
          ★ 录制在**目标会话的代理**里跑，录的是那个账号的 RDP 画面（不是主控台桌面）。
          ★ 环形缓冲：只保留最近 N 秒，SSD 平时零写入，保存时才落盘。 -->
     <Border Style="{StaticResource Divider}" Margin="0,18,0,0" />
     <TextBlock Text="屏幕录制" Style="{StaticResource Label}" Margin="0,14,0,0"
                ToolTip="在目标账号的 RDP 会话内录制画面。勾选的账号才会录。" />

     <TextBlock Text="选择要录制的账号（可多选）" Style="{StaticResource Caption}"
                Margin="2,8,0,6" TextWrapping="Wrap" />
     <Border Style="{StaticResource GlassPanel}" Padding="10,8" Margin="0,0,0,6">
      <StackPanel x:Name="RecordAccountPanel">
       <TextBlock Text="正在读取账号…" Style="{StaticResource Caption}" />
      </StackPanel>
     </Border>

     <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*" />
       <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="帧率" Style="{StaticResource Label}" VerticalAlignment="Center"
                 ToolTip="越高越流畅、占用越多。挂机看操作 10fps 通常够用。" />
      <ComboBox Grid.Column="1" x:Name="RecordFpsCombo" Width="140" Height="30"
                SelectionChanged="RecordFps_Changed">
       <ComboBoxItem Content="10 帧/秒（省资源）" Tag="10" />
       <ComboBoxItem Content="15 帧/秒（推荐）" Tag="15" />
       <ComboBoxItem Content="30 帧/秒（流畅）" Tag="30" />
      </ComboBox>
     </Grid>

     <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*" />
       <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="画质" Style="{StaticResource Label}" VerticalAlignment="Center"
                 ToolTip="越高越清晰，单帧体积也越大。" />
      <ComboBox Grid.Column="1" x:Name="RecordQualityCombo" Width="140" Height="30"
                SelectionChanged="RecordQuality_Changed">
       <ComboBoxItem Content="标准（60）" Tag="60" />
       <ComboBoxItem Content="清晰（75）" Tag="75" />
       <ComboBoxItem Content="高清晰（90）" Tag="90" />
      </ComboBox>
     </Grid>

     <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*" />
       <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="保留时长" Style="{StaticResource Label}" VerticalAlignment="Center"
                 ToolTip="环形缓冲只保留最近这么多秒，更早的帧自动丢弃。保存时才写入磁盘。" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
       <TextBox x:Name="RecordKeepBox" Width="60" Height="30" Style="{StaticResource GlassTextBox}"
                Padding="8,0,8,0" FontSize="12" VerticalContentAlignment="Center"
                TextChanged="RecordKeep_Changed" Text="30" />
       <TextBlock Text="秒" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="6,0,0,0" />
      </StackPanel>
     </Grid>

     <!-- ★ 2026-11-22：抓屏方式（对应 AppSettings.CaptureMode）
           之前只存在于配置字段、没有界面入口，用户无法切换 WGC。
           WGC 是 GPU 抓屏（实测 2~8ms），BitLlt 是 GDI（17~34ms），差 4~10 倍。 -->
     <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*" />
       <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="抓屏方式" Style="{StaticResource Label}" VerticalAlignment="Center"
                 ToolTip="自动：优先 GPU 抓屏（WGC），失败自动降级到兼容模式。WGC 实测比 BitLlt 快 4~10 倍，但需要显卡支持。" />
      <ComboBox Grid.Column="1" x:Name="CaptureModeCombo" Width="140" Height="30"
                SelectionChanged="CaptureMode_Changed">
       <ComboBoxItem Content="自动（推荐）" Tag="0" />
       <ComboBoxItem Content="GPU 抓屏（快）" Tag="1" />
       <ComboBoxItem Content="GPU 抓显示器" Tag="2" />
       <ComboBoxItem Content="兼容模式（慢）" Tag="3" />
      </ComboBox>
     </Grid>

     <!-- ★ 2026-11-22：视频码率（对应 AppSettings.VideoBitrateKbps）
          只在 H.264 直播/录像启用时生效；JPEG 模式忽略此项。 -->
     <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*" />
       <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="视频码率" Style="{StaticResource Label}" VerticalAlignment="Center"
                 ToolTip="H.264 直播/录像的码率。8 Mbps 约合每小时 3.6 GB；静态挂机画面 4 Mbps 就够，打斗场景建议 15 Mbps。" />
      <ComboBox Grid.Column="1" x:Name="BitrateCombo" Width="140" Height="30"
                SelectionChanged="Bitrate_Changed">
       <ComboBoxItem Content="4 Mbps（省流）" Tag="4000" />
       <ComboBoxItem Content="8 Mbps（标准）" Tag="8000" />
       <ComboBoxItem Content="15 Mbps（高画质）" Tag="15000" />
       <ComboBoxItem Content="25 Mbps（无损）" Tag="25000" />
      </ComboBox>
     </Grid>

     <!-- ★ 说明文字：把选择的实际含义用数字讲清楚（用户诉求：让人好判断） -->
     <TextBlock x:Name="VideoHintText" Style="{StaticResource Caption}"
                TextWrapping="Wrap" Margin="0,10,0,0"
                Text="抓屏方式与码率会影响画面流畅度和流量。" />

     <!-- ★ 实际后端状态（每 5 秒问一次代理，不是读配置）
           用户诉求：配置选了 WGC 也可能降级，要能看出真实情况。 -->
     <Border Margin="0,8,0,0" Padding="10,7" CornerRadius="6"
             Background="{DynamicResource MintSoftBrush}"
             BorderBrush="{DynamicResource MintBrush}" BorderThickness="1">
      <TextBlock x:Name="BackendStatusText" Style="{StaticResource Caption}"
                 TextWrapping="Wrap" Text="正在查询代理状态…" />
     </Border>

     <TextBlock x:Name="RecordHintText" Style="{StaticResource Caption}" Margin="2,8,0,0" TextWrapping="Wrap"
                Text="录制在目标账号的会话内进行。未勾选的账号不录。缓冲区只在内存里，点「保存」才写入磁盘。" />

     <!-- ── 保护层边框 ─────────────────────────────────────────────
          ★ 锁定态时才出现，框住 RDP 画布。默认色故意与焦点边框区分开，
            否则用户会误以为"保护层没生效、只是焦点高亮"。
          ★ 画在主窗口内部的 WPF Border 上，不是独立分层窗口。 -->
     <Border Style="{StaticResource Divider}" Margin="0,18,0,0" />
     <TextBlock Text="保护层边框" Style="{StaticResource Label}" Margin="0,14,0,0"
                ToolTip="锁定态时框住 RDP 画布的边框颜色" />

     <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="Auto" />
       <ColumnDefinition Width="*" />
       <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <!-- 颜色预览块：跟着输入实时变色 -->
      <Border Grid.Column="0" x:Name="ShieldColorPreview" Width="34" Height="34" CornerRadius="8"
              VerticalAlignment="Center" BorderThickness="1" BorderBrush="#44FFFFFF"
              Background="#CCF0C041" />
      <TextBox Grid.Column="1" x:Name="ShieldColorBox" Style="{StaticResource GlassTextBox}"
               Margin="10,0,10,0" VerticalAlignment="Center"
               FontFamily="{StaticResource MonoFont}"
               ToolTip="支持 #RGB / #RRGGBB / #AARRGGBB（前两位是透明度，FF=不透明）"
               TextChanged="ShieldColor_TextChanged" />
      <Button Grid.Column="2" x:Name="ShieldColorReset" Content="恢复默认"
              Style="{StaticResource GhostButton}" Padding="12,6" VerticalAlignment="Center"
              Click="ShieldColorReset_Click" />
     </Grid>
     <TextBlock Text="格式 #AARRGGBB，前两位是透明度（AA ≈ 67%、FF = 不透明）。留空使用主题默认色。"
                Style="{StaticResource Caption}" Margin="44,6,0,0" TextWrapping="Wrap" />

     <Grid Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*" />
       <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="边框粗细" Style="{StaticResource Label}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" x:Name="ShieldThicknessText" Text="2 px" Style="{StaticResource Mono}"
                 Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center" />
     </Grid>
     <Slider x:Name="ShieldThicknessSlider" Style="{StaticResource GlassSlider}"
             Minimum="0" Maximum="8" TickFrequency="1" SmallChange="1" LargeChange="1"
             Margin="0,10,0,0" ValueChanged="ShieldThickness_Changed" />
     <TextBlock Text="0 = 不显示保护层边框。" Style="{StaticResource Caption}" Margin="2,6,0,0" />
    </StackPanel>
   </Border>
   <TextBlock Text="支持键盘单键/组合键与鼠标中键、侧键（可带 Ctrl/Alt/Shift/Win）。录制完成立即生效；按 Esc 取消。&#x0a;旧热键在录制期间暂停。若设置左键为热键，需另用键盘打开画面，避免无法点击。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,10,0,0" />
   <TextBlock x:Name="SavedText" Text="修改会立即保存，并同步到所有已打开的用户画面。"
              Style="{StaticResource Caption}" Margin="2,12,0,0" />
  </StackPanel>
 </ScrollViewer>
</UserControl>