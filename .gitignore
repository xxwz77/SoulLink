# .NET build outputs
bin/
obj/
dist/
dist-test/
out/
publish/

tools/*
rdptest/
relaytest/
sysdiag/
systest/
*.tmp
*.log
*.pdb

# Local application configuration and credentials
config.json
config.portable.json
*.config.json
*.secret.json
*.secrets.json
appsettings*.Local.json
*.user
*.suo

# Temporary interop/test downloads
MSTSCLib.dll
AxMSTSCLib.dll

# OS/editor files
.vs/
.vscode/
.idea/
*.swp
*.bak
Thumbs.db
Desktop.ini

# Release binaries are kept locally for rollback, not in git
releases/**/*.exe

# Portable distribution packages (large binaries)
releases/*.zip
releases/SoulLink-v*-portable/

# Stable variant binaries
dist/stable/
out/

# 服务端发布产物（大二进制，不入库）
dist-server/
dist-server-win/

# 更新包目录（只保留源码，bin 通过 Git LFS 或外部分发）
releases/SoulLink-v*-Update/

# 研究用生成的中间产物（脚本保留，提取出的字符串转储不入库）
research/**/out/
__pycache__/

# 样张/验证工具的构建产物
tools/*/bin/
tools/*/obj/

# Test tools, experiments and screenshots（7za 是构建依赖，例外保留）
tools/*
!tools/7za
# 多画面样张与布局验证工具（源码入库，构建产物忽略）
!tools/view-demo
!tools/view-demo/Program.cs
!tools/view-demo/app.manifest
!tools/view-demo/SoulLink.ViewDemo.csproj
!tools/view-demo/shot.ps1
!tools/view-demo/forcefg.ps1
!tools/layout-check
!tools/layout-check/LayoutCheck.cs
!tools/layout-check/LayoutCheck.csproj
# Broker 独立安装器（源码入库，构建产物忽略）—— 2.17.45 起它同时支持
# SoulLink.exe 与 SoulLink-Stable.exe 两个身份，必须跟主程序一起演进。
!tools/broker-setup
!tools/broker-setup/Program.cs
!tools/broker-setup/SoulLink.BrokerSetup.csproj

# ★ 云更新器：主程序启动它来替换文件，必须随包分发，源码必须入库。
!tools/updater
!tools/updater/Program.cs
!tools/updater/SoulLink.Updater.csproj
!tools/updater/app.manifest

# ★ 一键救援程序：主程序卡死时的兜底工具，源码必须入库。
!tools/rescue
!tools/rescue/Program.cs
!tools/rescue/Rescue.csproj
# ── 本地构建 / 发布 / 备份产物（体积大，不入库；2026-11-20 补）────────────
# 为什么补：git add -A 会把 7.4 GB 的 dist-*/backups/artifacts/releases 全吞进去。
dist-*/
dist-backup-*/
dist-fix-*/
backups/
artifacts/
releases/
tools/**/obj*/
tools/**/bin*/
tools/**/out/


release-build/
