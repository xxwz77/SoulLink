{
  // ★ 锁定构建用的 .NET SDK 版本。
  //   本机装了 8 / 9 / 10 / 11 四套 SDK，不锁的话会悄悄漂移，排查时无法复现。
  //
  //   ★ 为什么最终选 11：见 build.bat 里的说明。
  //     简言之——自包含单文件在 .NET 11 上有 WPF 混合模式程序集的回归，
  //     但「框架依赖发布」完全正常，且体积只有 3.2MB、启动还更快。
  //     我们采用框架依赖发布，要求用户安装 .NET 11 桌面运行时。
  //
  //   rollForward=latestPatch：只允许 11.0.1xx 这一档，不跳大版本。
  //   allowPrerelease=false：绝不解析到 rc / preview 版 SDK。
  //
  //   ★ 这个文件只影响"编译这个仓库的机器"，不会被打进 exe。
  "sdk": {
    "version": "11.0.100",
    "rollForward": "latestPatch",
    "allowPrerelease": false
  }
}
