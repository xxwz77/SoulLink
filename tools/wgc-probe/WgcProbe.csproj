<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WGC (Windows.Graphics.Capture) 最小探测程序 —— 只读 Spike。

    目的：在目标 RDP 会话内验证 Windows.Graphics.Capture（BetterGI 的
    "WindowsGraphicsCaptureV2" 底层同款 API）能否创建 capture item、
    能否收到帧、帧到达频率与单帧耗时，从而判断 60fps 是否可行。

    依赖策略：
      - WinRT 投影直接用本机 nuget 缓存里已存在的
        Microsoft.Windows.SDK.NET.dll (10.0.22621.86) + WinRT.Runtime.dll (2.3.1.0)，
        通过 <Reference> 直连，避免走 CsWinRT 源码生成 / Windows App SDK。
      - D3D11/DXGI 用 Vortice（与 tools/media-probe 一致，本机已缓存 3.6.2）。

    只读性：只创建/销毁自己的 D3D 设备、WinRT capture session、frame pool。
    不写配置、不改注册表、不碰游戏窗口、不注入输入、不落盘任何帧内容。
    唯一落盘是 -Out 指定的文本报告。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>15.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>WgcProbe</RootNamespace>
    <AssemblyName>wgc-probe</AssemblyName>
    <SatelliteResourceLanguages>zh-CN;en-US</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416;CA1420;SYSLIB1054;SYSLIB1096;CS8618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinRT 投影：直连本机缓存里的两个 DLL（net11 兼容 net9 程序集） -->
    <Reference Include="Microsoft.Windows.SDK.NET">
      <HintPath>$(UserProfile)\.nuget\packages\microsoft.windows.sdk.net.ref\10.0.22621.87\lib\net9.0\Microsoft.Windows.SDK.NET.dll</HintPath>
    </Reference>
    <Reference Include="WinRT.Runtime">
      <HintPath>$(UserProfile)\.nuget\packages\microsoft.windows.sdk.net.ref\10.0.22621.87\lib\net9.0\WinRT.Runtime.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
