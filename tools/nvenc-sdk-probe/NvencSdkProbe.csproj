<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>15.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>NvencSdkProbe</RootNamespace>
    <AssemblyName>nvenc-sdk-probe</AssemblyName>
    <SatelliteResourceLanguages>zh-CN;en-US</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416;CA1420;SYSLIB1054;SYSLIB1096;CS8618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
  </ItemGroup>
</Project>
