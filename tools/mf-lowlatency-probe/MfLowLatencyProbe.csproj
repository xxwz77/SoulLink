<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>15.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>MfLowLatencyProbe</RootNamespace>
    <AssemblyName>mf-lowlatency-probe</AssemblyName>
    <NoWarn>$(NoWarn);CA1416;CA1420;SYSLIB1054;CS8618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
    <PackageReference Include="SharpGen.Runtime.COM" Version="2.4.2-beta" />
  </ItemGroup>
</Project>
