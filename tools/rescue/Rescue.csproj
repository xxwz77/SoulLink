<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>sl-rescue</AssemblyName>

    <!-- ★ 框架依赖发布：从 33 MB 降到几十 KB。
         原来的产物是自包含发布，把整个 .NET 8 运行时打了进去（33 MB），
         而本程序只做 5 个 Win32 调用（ClipCursor / ShowCursor /
         mouse_event / GetAsyncKeyState / SetSystemMetrics），
         用不到 WPF 或任何重型组件。

         ★ 为什么可以依赖 .NET：主程序本身是框架依赖的（3.4 MB，
           要求 .NET 11 桌面运行时）。用户既然装了主程序，
           机器上必然已有运行时，sl-rescue 不增加任何前置条件。

         ★ 目标框架也跟随主程序从 net8.0 升到 net11.0，
           避免用户装的是 .NET 11 却没有 .NET 8 的情况。 -->
    <RollForward>LatestMajor</RollForward>

    <!-- ★★ 3.2.4 关键修复：必须打成**单文件** ★★
         原来这里没配 PublishSingleFile，dotnet publish 出来的是
         apphost(sl-rescue.exe) + sl-rescue.dll + runtimeconfig.json + deps.json 四件套。
         而发布流程只把 sl-rescue.exe 拷到 dist，其余三个被丢下 ——
         用户双击救援程序会看到：
           The application to execute does not exist: '...\sl-rescue.dll'
         也就是**救援程序完全失效**（实测复现，退出码 -2147450726）。
         挂机版全屏出不来时，这是唯一的逃生通道，不能坏。
         ★ 用 IncludeNativeLibrariesForSelfExtract 保证依赖也进单文件。 -->
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(RuntimeIdentifier)' != ''">true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <!-- ★ 框架依赖 + 单文件**不能开压缩**（NETSDK1176）：
         与 build.bat 里主程序的处理保持一致。 -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>

    <Version>3.2.6</Version>
    <FileVersion>$(Version).0</FileVersion>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <AssemblyTitle>SoulLink 一键救援</AssemblyTitle>
    <Product>SoulLink</Product>
    <Description>解除光标裁剪、释放鼠标按键、结束 SoulLink 进程</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
