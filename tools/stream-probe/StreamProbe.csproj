<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>15.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>StreamProbe</RootNamespace>
    <AssemblyName>stream-probe</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <SatelliteResourceLanguages>zh-CN;en-US</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416;CA1420;SYSLIB1054;SYSLIB1096;CS8618;CS8632</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinRT 投影：直连本机缓存（net11 兼容 net9 程序集） -->
    <Reference Include="Microsoft.Windows.SDK.NET">
      <HintPath>$(UserProfile)\.nuget\packages\microsoft.windows.sdk.net.ref\10.0.26100.87\lib\net9.0\Microsoft.Windows.SDK.NET.dll</HintPath>
    </Reference>
    <Reference Include="WinRT.Runtime">
      <HintPath>$(UserProfile)\.nuget\packages\microsoft.windows.sdk.net.ref\10.0.26100.87\lib\net9.0\WinRT.Runtime.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
