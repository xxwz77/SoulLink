<Project Sdk="Microsoft.NET.Sdk">  <PropertyGroup>    <OutputType>WinExe</OutputType>    <TargetFrameworks>net11.0-windows;net11.0-windows10.0.26100.0</TargetFrameworks>    <UseWPF>true</UseWPF>    <UseWindowsForms>true</UseWindowsForms>    <Nullable>enable</Nullable>    <LangVersion>15.0</LangVersion>    <ImplicitUsings>disable</ImplicitUsings>    <RootNamespace>SoulLink</RootNamespace>    <AssemblyName>SoulLink</AssemblyName>    <ApplicationManifest>app.manifest</ApplicationManifest>    <!-- ★ 版本号唯一来源：改这里即可，FileVersion/AssemblyVersion 自动派生。         历史教训：标签打到 v1.4.3 而这里仍是 1.4.1，标题栏一直显示旧版本。 -->    <Version>3.3.33</Version>    <FileVersion>$(Version).0</FileVersion>    <AssemblyVersion>$(Version).0</AssemblyVersion>    <AssemblyTitle>SoulLink 多用户挂机中控台</AssemblyTitle>    <Product>SoulLink</Product>    <Description>多用户会话中控台：内嵌 RDP 画面 + 跨会话投送 + 鼠标注入转视角</Description>    <SatelliteResourceLanguages>zh-CN;en-US</SatelliteResourceLanguages>    <GenerateDocumentationFile>false</GenerateDocumentationFile>    <NoWarn>$(NoWarn);CS8618;CA1416;WPF0001</NoWarn>    <!-- ★ tools 是独立试验程序、releases 是版本归档与 WIP 备份，         都必须排除：其中的 .cs 副本被通配符编译进来会造成类型重复定义（AutoStart 已踩过）。 -->    <!-- ★ Server\** 是独立的服务端项目（有自己的 csproj），必须排除，         否则客户端会把 Server/obj 里的 AssemblyInfo 也编译进来，导致特性重复。 -->    <!-- ★ Assets\RdpWrap 里的 dll 已显式声明为 EmbeddedResource，         这里排除掉默认的 None/Content 通配，避免同一文件被重复包含导致编译报错。 -->    <!-- ★ backups** 必须排���：源码备份（backupssrc-x.y.z-时间戳）里是**完整的 .cs 副本**，         不排除就会被默认通配符编译进来，造成和主树里同名类型重复定义（2.17.45 发布时踩过）。 -->    <DefaultItemExcludes>$(DefaultItemExcludes);tools\**;releases\**;backups\**;artifacts\**;Server\**;dist-server\**;dist-server-win\**</DefaultItemExcludes>    <ApplicationIcon Condition="Exists('Assets\soullink.ico')">Assets\soullink.ico</ApplicationIcon>    <!-- ★★ 2.19.0：改为「框架依赖 + 单文件」发布，要求用户安装 .NET 11 桌面运行时。         runtimeconfig 里写 rollForward=LatestMajor，         意思是「装了任何 >= 11 的桌面运行时都能跑」，不要求版本号精确匹配。         好处：用户装了 .NET 12 / 13 也不会因为版本对不上而启动失败。         代价：跨大版本有理论上的兼容风险 —— WPF 应用实际不会出事。 -->    <RollForward>LatestMajor</RollForward>  </PropertyGroup>  <ItemGroup Condition="Exists('Assets\soullink.ico')">    <Resource Include="Assets\soullink.ico" />  </ItemGroup>  <!-- ★ RDP Wrapper 运行时文件（内嵌进 exe）       用户诉求：新机器不用再去找文件夹、不用手动导 reg。       安装时由 RdpWrapService 从内嵌资源释放到目标目录，再按实际路径写注册表。       ★ 只带运行时必需的文件：         TermWrap.dll  核心         Zydis.dll     反汇编依赖，缺了 TermWrap 加载不起来（最容易漏）         UmWrap.dll    会话/相机重定向补丁         EndpWrap.dll  音频端点补丁       不带 .lib / .exp（编译产物）、.pdb（调试符号）、*Test.exe（诊断用）、       .reg（路径是硬编码的，换机器就错）。       ★ 全部为 x64，与 SoulLink 自身架构一致（已核对 PE 头）。 -->  <ItemGroup>    <EmbeddedResource Include="Assets\RdpWrap\TermWrap.dll" Condition="Exists('Assets\RdpWrap\TermWrap.dll')" />    <EmbeddedResource Include="Assets\RdpWrap\Zydis.dll" Condition="Exists('Assets\RdpWrap\Zydis.dll')" />    <EmbeddedResource Include="Assets\RdpWrap\UmWrap.dll" Condition="Exists('Assets\RdpWrap\UmWrap.dll')" />    <EmbeddedResource Include="Assets\RdpWrap\EndpWrap.dll" Condition="Exists('Assets\RdpWrap\EndpWrap.dll')" />  </ItemGroup>  <ItemGroup>  </ItemGroup>  <ItemGroup>    <Content Include="tools\broker-*.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="11.0.0" />  </ItemGroup>  <!-- ★ 自带 7za.exe（官方 7-Zip 命令行工具，1.2 MB）       用于解压 BGI 更新包：519MB/2244 文件实测 5.3 秒。       把它作为独立文件放在 exe 旁边，用户不需要装 7-Zip。 -->  <Target Name="Copy7zaToOutput" AfterTargets="AfterBuild">    <Copy SourceFiles="$(MSBuildProjectDirectory)\tools\7za\7za.exe" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\tools\7za\7za.exe')" />  </Target>  <Target Name="Copy7zaToPublish" AfterTargets="Publish">    <Copy SourceFiles="$(MSBuildProjectDirectory)\tools\7za\7za.exe" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)\tools\7za\7za.exe')" />  </Target>  <!-- ★ Broker 独立安装器：必须作为**独立文件**放到 exe 旁边的 tools\ 目录。       用户实测：点「安装 / 修复服务」报「找不到独立安装器」。       ★ 为什么必须用 Target 复制，而不是 None/Content 项：         单文件发布（PublishSingleFile）会把带 CopyToPublishDirectory 的         托管程序集**合并进 exe**。实测：加 None 项后 exe 从 67MB 涨到 97.9MB，         而程序是在 exe 旁的 tools 目录里找它 —— 打进去等于没放。         Target 是构建结束后直接复制文件，不参与打包决策。       ★ 2026-11-21：改为**自动发布**，不再依赖手工维护的 33.6 MB 文件。         原来是从 dist\tools\SoulLink.BrokerSetup.exe 复制，而那是一个         **自包含**发布产物（整个 .NET 运行时打进去，33.6 MB）。         该程序只做三件事（复制文件、建服务、改 ACL），和主程序一样跑在         框架依赖上即可 —— 用户能用到它，前提是已装主程序，也就必然有 .NET 11。         改为 框架依赖 + 单文件：33.6 MB → 约 1.1 MB，全量更新包因此         从 ~32 MB 降到 ~3.3 MB。 -->  <Target Name="PublishBrokerSetup" BeforeTargets="AfterBuild" Condition="Exists('$(MSBuildProjectDirectory)\tools\broker-setup\SoulLink.BrokerSetup.csproj')">    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\tools\broker-setup\SoulLink.BrokerSetup.csproj&quot; -c $(Configuration) -r win-x64 --self-contained false -p:PublishSingleFile=true -p:DebugType=none -o &quot;$(MSBuildProjectDirectory)\artifacts\broker-build&quot; --nologo -v q"          ContinueOnError="true" />  </Target>  <Target Name="CopyBrokerSetupToOutput" AfterTargets="AfterBuild">    <Copy SourceFiles="$(MSBuildProjectDirectory)\artifacts\broker-build\SoulLink.BrokerSetup.exe"          DestinationFolder="$(TargetDir)tools"          SkipUnchangedFiles="true"          Condition="Exists('$(MSBuildProjectDirectory)\artifacts\broker-build\SoulLink.BrokerSetup.exe')" />  </Target>  <Target Name="CopyBrokerSetupToPublish" AfterTargets="Publish">    <Copy SourceFiles="$(MSBuildProjectDirectory)\artifacts\broker-build\SoulLink.BrokerSetup.exe"          DestinationFolder="$(PublishDir)tools"          SkipUnchangedFiles="true"          Condition="Exists('$(MSBuildProjectDirectory)\artifacts\broker-build\SoulLink.BrokerSetup.exe')" />  </Target>  <!-- ★ 独立更新器：必须作为**独立文件**放在 exe 旁边。       单文件发布会把托管程序集合并进 exe，所以用 Target 在构建后复制，       与 CopyBrokerSetupToOutput 同理。 -->  <Target Name="BuildUpdater" BeforeTargets="AfterBuild" Condition="Exists('$(MSBuildProjectDirectory)\tools\updater\SoulLink.Updater.csproj')">    <MSBuild Projects="$(MSBuildProjectDirectory)\tools\updater\SoulLink.Updater.csproj"             Targets="Restore;Build"             Properties="Configuration=$(Configuration)" />  </Target>  <Target Name="CopyUpdaterToOutput" AfterTargets="AfterBuild">    <Copy SourceFiles="$(MSBuildProjectDirectory)\tools\updater\bin\$(Configuration)\net11.0-windows\SoulLink.Updater.exe"          DestinationFolder="$(TargetDir)"          SkipUnchangedFiles="true"          Condition="Exists('$(MSBuildProjectDirectory)\tools\updater\bin\$(Configuration)\net11.0-windows\SoulLink.Updater.exe')" />  </Target>  <Target Name="CopyUpdaterToPublish" AfterTargets="Publish">    <Copy SourceFiles="$(MSBuildProjectDirectory)\tools\updater\bin\$(Configuration)\net11.0-windows\SoulLink.Updater.exe"          DestinationFolder="$(PublishDir)"          SkipUnchangedFiles="true"          Condition="Exists('$(MSBuildProjectDirectory)\tools\updater\bin\$(Configuration)\net11.0-windows\SoulLink.Updater.exe')" />  </Target>  <!-- ★ 一键救援程序 sl-rescue.exe：放在 exe 旁边，主程序卡死时用户双击即可。       从 33 MB（自包含）降到 ~72 KB（框架依赖），见 tools/rescue/Rescue.csproj 注释。 -->  <Target Name="PublishRescue" BeforeTargets="AfterBuild" Condition="Exists('$(MSBuildProjectDirectory)\tools\rescue\Rescue.csproj')">    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\tools\rescue\Rescue.csproj&quot; -c $(Configuration) -r win-x64 --self-contained false -o &quot;$(MSBuildProjectDirectory)\artifacts\rescue-build&quot; --nologo -v q"          ContinueOnError="true" />  </Target>  <Target Name="CopyRescueToOutput" AfterTargets="AfterBuild">    <Copy SourceFiles="$(MSBuildProjectDirectory)\artifacts\rescue-build\sl-rescue.exe"          DestinationFolder="$(TargetDir)"          SkipUnchangedFiles="true"          Condition="Exists('$(MSBuildProjectDirectory)\artifacts\rescue-build\sl-rescue.exe')" />  </Target>  <Target Name="CopyRescueToPublish" AfterTargets="Publish">    <Copy SourceFiles="$(MSBuildProjectDirectory)\artifacts\rescue-build\sl-rescue.exe"          DestinationFolder="$(PublishDir)"          SkipUnchangedFiles="true"          Condition="Exists('$(MSBuildProjectDirectory)\artifacts\rescue-build\sl-rescue.exe')" />  </Target>  <!-- ★★ WGC（Windows.Graphics.Capture）抓屏需要版本化 TFM 才能拿到 WinRT 投影。      多目标 = 同时产「无版本 net11.0-windows（给 tools 引用，零改动）」和       「版本化 net11.0-windows10.0.26100.0（给 WGC 用 WinRT）」。      验证见 docs/research/WGC-TFM-VERIFY-20261122.md。      TargetPlatformMinVersion 只对版本化 TFM 生效，无版本 TFM 设了会 NETSDK1135。 -->  <PropertyGroup Condition="'$(TargetFramework)' != 'net11.0-windows'">    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>    <DefineConstants>$(DefineConstants);WGC</DefineConstants>  </PropertyGroup>  <!-- WGC 相关文件通过 #if WGC 条件编译：版本化 TFM 定义了 WGC 符号才有实现，      无版本 TFM 没有 WGC 符号，文件内容为空（两个 TFM 都能编译）。 -->  <!-- ★★ WGC 读回用 Vortice（与 tools/media-probe 同版本 3.6.2）。      手写 ID3D11DeviceContext 的 CopyResource/Map vtable 槽位极易错位（Mp4Writer 曾翻车 3 次），      用成熟互操作库拿到精确 HRESULT，代价约 900KB。 -->  <ItemGroup>    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />  </ItemGroup>  <!-- ★★ WinRT 投影 DLL 外置（不进单文件）：      版本化 TFM 会引用整个 Microsoft.Windows.SDK.NET.dll（约 26MB），      打进单文件会让 exe 从 4.84MB 涨到 31.42MB 且启动慢 200~500ms。      外置 = exe 保持 4.84MB、启动不变慢，旁边多几个 DLL（约 27MB），      全量 zip 压缩后约 8MB（与打进单文件相同）。      只在版本化 TFM 生效（无版本 TFM 不引用这些 DLL，无需排除）。 -->  <!-- ★★ WinRT 投影 DLL 外置（不进单文件）：      版本化 TFM 会引用整个 Microsoft.Windows.SDK.NET.dll（约 26MB），      打进单文件会让 exe 从 4.84MB 涨到 31.42MB 且启动慢。      外置 = exe 保持 4.84MB、启动不变慢，旁边多几个 DLL。      只在版本化 TFM 生效。      实现：在 ResolveFileToPublish 之后，把这几个运行时包程序集标记 ExcludeFromSingleFile。 -->  <Target Name="ExcludeWinRTRuntimePacksFromSingleFile"       Condition="'$(TargetFramework)' != 'net11.0-windows' and '$(PublishSingleFile)' == 'true'"       AfterTargets="ResolveFileToPublish"       BeforeTargets="_ComputeFilesToBundle">    <ItemGroup>      <!-- ★ 2026-11-22 补：Vortice 系列也外置。
           原因：它们同样是"被 SDK 隐藏"的托管程序集，单文件打包时未正确包含，
           导致 publish 目录缺 DLL、程序启动即退出（实测 exit code 0 闪退）。
           外置后由 build.bat / publish 脚本一并复制到 dist。 -->
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Microsoft.Windows.SDK.NET.dll' or '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'Microsoft.Windows.UI.Xaml.dll' or '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'WinRT.Runtime.dll' or $([System.String]::Copy('%(ResolvedFileToPublish.Filename)').StartsWith('Vortice.')) or $([System.String]::Copy('%(ResolvedFileToPublish.Filename)').StartsWith('SharpGen.'))">        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>      </ResolvedFileToPublish>    </ItemGroup>  </Target>  </Project>