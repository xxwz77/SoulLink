<UserControl x:Class="SoulLink.Views.SessionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SoulLink.Controls"
             FontFamily="{StaticResource UiFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource GlassCardStrong}" Padding="18,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="2,0,2,14">
                    <StackPanel>
                        <TextBlock Text="在线会话" Style="{StaticResource Title}" />
                        <TextBlock x:Name="CountText" Text="正在读取 query user…" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <CheckBox x:Name="AutoRefresh" Content="自动刷新" Style="{StaticResource GlassCheckBox}"
                                  VerticalAlignment="Center" Margin="0,0,12,0" IsChecked="True" />
                        <Button Style="{StaticResource GhostButton}" Click="Refresh_Click" Padding="14,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="刷新" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <DataGrid Grid.Row="1" x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None" Background="Transparent"
                          RowBackground="Transparent" BorderThickness="0" CanUserAddRows="False"
                          SelectionMode="Single" SelectionChanged="Grid_SelectionChanged"
                          Foreground="{DynamicResource TextSecondary}" FontSize="12" RowHeight="42"
                          AlternatingRowBackground="#08FFFFFF">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="{DynamicResource StrokeSoft}" />
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource HoverFill}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SelectedFill}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="用户" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <ctl:GlowDot Width="14" Height="14" VerticalAlignment="Center" Color="{Binding DotBrush.Color}" Pulse="{Binding IsActive}" />
                                        <TextBlock Text="{Binding UserName}" Margin="9,0,0,0" VerticalAlignment="Center"
                                                   FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="会话 ID" Binding="{Binding Session.Id}" Width="80" />
                        <DataGridTextColumn Header="连接" Binding="{Binding Session.SessionName}" Width="120" />
                        <DataGridTextColumn Header="状态" Binding="{Binding Session.Badge}" Width="70" />
                        <DataGridTextColumn Header="空闲" Binding="{Binding Session.IdleDisplay}" Width="120" />
                        <DataGridTextColumn Header="登录时间" Binding="{Binding Session.LogonDisplay}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 右侧：会话详情 / 快捷操作 -->
        <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="18,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="会话详情" Style="{StaticResource Title}" Margin="2,0,0,14" />
                    <Border Style="{StaticResource GlassPanel}" Padding="14,12">
                        <StackPanel>
                            <TextBlock x:Name="DetailUser" Text="—" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock x:Name="DetailSub" Text="未选择会话" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            <Border Style="{StaticResource Divider}" Margin="0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="会话 ID" Style="{StaticResource Caption}" />
                                    <TextBlock x:Name="DetailSid" Text="—" Style="{StaticResource Mono}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="连接方式" Style="{StaticResource Caption}" />
                                    <TextBlock x:Name="DetailConn" Text="—" Style="{StaticResource Mono}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                    <TextBlock Text="对该会话" Style="{StaticResource Label}" Margin="2,18,0,8" />
                    <Button Style="{StaticResource PrimaryButton}" Click="ConnectConsole_Click" Margin="0,0,0,8" Padding="18,11">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="接入中控台画面" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="OpenProgram_Click" Margin="0,0,0,8" Padding="18,11">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="在该用户桌面打开程序" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="ViewProcesses_Click" Padding="18,11">
                        <TextBlock Text="查看并结束其中的程序" />
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="SaveAsAction_Click" Padding="18,11" Margin="0,8,0,0">
                        <TextBlock Text="保存为快捷动作…" />
                    </Button>

                    <Border Style="{StaticResource Divider}" Margin="0,16" />
                    <TextBlock Text="提示" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource CyanBrush}" Margin="2,0,0,6" />
                    <TextBlock Text="新登录的用户可能需要几秒钟才会出现在列表里；点「刷新」即可。断开连接的会话同样可以操作，程序会在它原来的桌面上运行。"
                               FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="2,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
