<Window x:Class="SoulLink.Views.MiyousheQrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="米游社扫码登录" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}">
    <StackPanel Margin="20">
        <TextBlock x:Name="AccountText" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" />
        <!-- ★ t42 复查（真实数据订正）：米游社 URL 约 132 字符 → QR 57 模块。
             生成侧已改 GetGraphic(6, drawQuietZones:true)：57×6=342px + 静默区 4×2×6=48px = 390px。
             带 4 模块白边（二维码规范必需）、尺寸匹配窗口（460-40 margin=420 可用 > 390）、
             6px/模块在高 DPI（150%/200%）下仍清晰。Stretch=None 自然尺寸 + NearestNeighbor，
             不缩放不插值，定位角与静默区完整可见可扫。 -->
        <Border Margin="0,12,0,12" BorderBrush="#20FFFFFF" BorderThickness="1"
                Background="White" HorizontalAlignment="Center" Padding="0">
            <Image x:Name="QrImage" Stretch="None" Margin="0"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Border>
        <TextBlock x:Name="StatusText" FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondary}" TextAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Button x:Name="BtnRegen" Content="重新生成" Padding="12,6" Margin="0,0,10,0"
                    Style="{StaticResource GhostButton}" Click="BtnRegen_Click" Visibility="Collapsed" />
            <Button x:Name="BtnClose" Content="关闭" Padding="12,6"
                    Style="{StaticResource GhostButton}" Click="BtnClose_Click" />
        </StackPanel>
    </StackPanel>
</Window>
