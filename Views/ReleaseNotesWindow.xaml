<Window x:Class="SoulLink.Views.ReleaseNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="更新说明" Width="660" Height="600" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" Background="{DynamicResource DialogSurface}" FontFamily="{StaticResource UiFont}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Border Padding="20,14,20,18" BorderBrush="{DynamicResource StrokeMid}" BorderThickness="1"
            Background="{DynamicResource DialogSurface}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="更新说明" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
                <Button HorizontalAlignment="Right" IsCancel="True" Click="Close_Click"
                        AutomationProperties.Name="关闭更新说明" ToolTip="关闭"
                        Style="{StaticResource WindowButton}">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </Grid>
            <Border Grid.Row="1" Margin="0,12,0,0" Padding="14,10,6,10" CornerRadius="8"
                    Background="{DynamicResource FieldBackground}" BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="1">
                <FlowDocumentScrollViewer x:Name="HistoryViewer" IsToolBarVisible="False" Background="Transparent"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          AutomationProperties.Name="桌面版更新历史" />
            </Border>
        </Grid>
    </Border>
</Window>
