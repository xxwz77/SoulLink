<Window x:Class="SoulLink.Views.MyDepartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SoulLink.Controls"
        Title="SoulLink" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource DialogSurface}"
        ShowInTaskbar="False" FontFamily="{StaticResource UiFont}">

    <Border CornerRadius="16" BorderBrush="{DynamicResource StrokeMid}" BorderThickness="1" Margin="10" Background="{DynamicResource DialogSurface}">

        <Grid ClipToBounds="True">
            <ctl:AuroraBackdrop Opacity="0.48" />
        <StackPanel Margin="22,20,22,18">
            <TextBlock Text="发车动作" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" />
            <TextBlock Text="为每个账号单独设置：房间发车时，该账号要执行什么。"
                       FontSize="11" Foreground="{DynamicResource TextMuted}"
                       Margin="0,6,0,2" TextWrapping="Wrap" />
            <TextBlock Text="切换账号可分别设置；每点一次「保存当前账号」就会立即生效。"
                       FontSize="10" Foreground="{DynamicResource TextMuted}"
                       Margin="0,0,0,16" TextWrapping="Wrap" />

            <!-- ① 先选账号 -->
            <TextBlock Text="为哪个账号设置" FontSize="10.5"
                       Foreground="{DynamicResource TextMuted}" />
            <ComboBox x:Name="UserCombo" Height="38" Margin="0,5,0,0"
                      Padding="11,0,6,0" FontSize="13"
                      Foreground="{DynamicResource TextPrimary}"
                      Background="{DynamicResource SubtleSurface}" BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="1"
                      SelectionChanged="User_Changed" />

            <!-- 该账号的 BGI 路径（只读展示，让人知道用的是哪个） -->
            <TextBlock Text="该账号的 BGI 路径" FontSize="10.5"
                       Foreground="{DynamicResource TextMuted}" Margin="0,14,0,0" />
            <Border CornerRadius="9" Padding="11,9" Margin="0,5,0,0"
                    Background="{DynamicResource SubtleSurface}" BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="1">
                <TextBlock x:Name="BgiPathText" Text="—" FontSize="10.5"
                           FontFamily="Consolas" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondary}" />
            </Border>

            <!-- ② 动作模式 -->
            <TextBlock Text="发车时执行" FontSize="10.5"
                       Foreground="{DynamicResource TextMuted}" Margin="0,14,0,0" />
            <ComboBox x:Name="ModeCombo" Height="38" Margin="0,5,0,0"
                      Padding="11,0,6,0" FontSize="13"
                      Foreground="{DynamicResource TextPrimary}"
                      Background="{DynamicResource SubtleSurface}" BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="1"
                      SelectionChanged="Mode_Changed">
                <ComboBoxItem Content="不执行任何动作" Tag="" IsSelected="True" />
                <ComboBoxItem Content="执行快捷动作" Tag="action" />
                <ComboBoxItem Content="启动 BGI 跑一条龙" Tag="dragon" />
                <ComboBoxItem Content="启动 BGI 跑配置组" Tag="groups" />
            </ComboBox>

            <!-- 快捷动作 -->
            <StackPanel x:Name="ActionPanel" Visibility="Collapsed" Margin="0,14,0,0">
                <TextBlock Text="选择动作" FontSize="10.5"
                           Foreground="{DynamicResource TextMuted}" />
                <ComboBox x:Name="ActionCombo" Height="38" Margin="0,5,0,0"
                          Padding="11,0,6,0" FontSize="13"
                          Foreground="{DynamicResource TextPrimary}"
                          Background="{DynamicResource SubtleSurface}" BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="1" />
            </StackPanel>

            <!-- 一条龙：和「快捷动作」一样用普通 ComboBox（原生模板能正常显示选中项） -->
            <StackPanel x:Name="DragonPanel" Visibility="Collapsed" Margin="0,14,0,0">
                <TextBlock Text="一条龙名称" FontSize="10.5"
                           Foreground="{DynamicResource TextMuted}" />
                <ComboBox x:Name="DragonCombo" Height="38" Margin="0,5,0,0"
                          Padding="11,0,6,0" FontSize="13"
                          Foreground="{DynamicResource TextPrimary}"
                          Background="{DynamicResource SubtleSurface}" BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="1" />
                <TextBlock x:Name="DragonHint" Text="" FontSize="9.5"
                           Foreground="{DynamicResource TextMuted}"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>

            <!-- 配置组：多选列表 + 已选文本框 -->
            <StackPanel x:Name="GroupsPanel" Visibility="Collapsed" Margin="0,14,0,0">
                <TextBlock Text="配置组（点列表项添加，可多选）" FontSize="10.5"
                           Foreground="{DynamicResource TextMuted}" />

                <Border CornerRadius="9" Padding="4" Margin="0,5,0,0"
                        Background="{DynamicResource SubtleSurface}" BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="1"
                        MaxHeight="130">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="GroupList" />
                    </ScrollViewer>
                </Border>

                <TextBlock Text="已选（多个用空格分隔，可手动改）" FontSize="10"
                           Foreground="{DynamicResource TextMuted}" Margin="0,10,0,0" />
                <TextBox x:Name="GroupsBox" Height="38" Margin="0,5,0,0"
                         Style="{StaticResource GlassTextBox}"
                         Padding="11,0,11,0" FontSize="13"
                         VerticalContentAlignment="Center" />

                <TextBlock x:Name="GroupsHint" Text="" FontSize="9.5"
                           Foreground="{DynamicResource TextMuted}"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>

            <!-- 概览：所有账号的配置状态 -->
            <TextBlock Text="全部账号" FontSize="10.5"
                       Foreground="{DynamicResource TextMuted}" Margin="0,16,0,0" />
            <StackPanel x:Name="OverviewPanel" Margin="0,6,0,0" />

            <!-- 发车前的准备动作（只影响该账号自己的进程） -->
            <TextBlock Text="发车前的准备" FontSize="10.5"
                       Foreground="{DynamicResource TextMuted}" Margin="0,16,0,0" />

            <CheckBox x:Name="StopBgiCheck" Content="先停止该账号正在跑的 BGI 脚本（必需）"
                      Style="{StaticResource GlassCheckBox}" IsChecked="True"
                      IsEnabled="False"
                      Margin="0,8,0,0" FontSize="11.5" />
            <TextBlock Text="运行一条龙和配置组之前，BGI 必须是空闲的，否则会冲突。这一步固定执行，只停这个账号的脚本，不会碰别人的。"
                       FontSize="9.5" Foreground="{DynamicResource TextMuted}"
                       TextWrapping="Wrap" Margin="20,2,0,0" />

            <CheckBox x:Name="CloseGenshinCheck" Content="先关闭该账号的原神"
                      Style="{StaticResource GlassCheckBox}"
                      Margin="0,10,0,0" FontSize="11.5" />
            <TextBlock Text="只在需要重新登录时勾选。按会话过滤，不影响其他用户。"
                       FontSize="9.5" Foreground="{DynamicResource TextMuted}"
                       TextWrapping="Wrap" Margin="20,2,0,0" />

            <TextBlock x:Name="ErrorText" Text="" FontSize="10.5"
                       Foreground="{DynamicResource RoseBrush}" TextWrapping="Wrap"
                       Margin="0,10,0,0" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource GhostButton}" Padding="18,8" Click="Cancel_Click">
                    <TextBlock Text="关闭" FontSize="12" />
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Padding="22,8" Margin="10,0,0,0"
                        Click="Save_Click">
                    <TextBlock Text="保存当前账号" FontSize="12.5" FontWeight="SemiBold" />
                </Button>
            </StackPanel>
        </StackPanel>
        </Grid>
    </Border>
</Window>
