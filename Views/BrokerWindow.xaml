<Window x:Class="SoulLink.Views.BrokerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SoulLink.Controls"
        Title="管理员代理服务" Width="720" Height="540" MinHeight="460"
        WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource WindowBackground}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" ResizeMode="CanResizeWithGrip" UseLayoutRounding="True">
    <!-- ★ T17：原 AllowsTransparency=True + Transparent（分层窗口）是 2.17.47 批量整改时
         漏网的第 15 个对话框（HANDOFF-2.17.47-BUGFIX-20261121：分层窗口引起焦点丢失、
         黑边等问题，其余对话框已全部改回 False）。
         ★ 圆角完全交给 DWM（WindowChrome + GlassFrameThickness=0 + CornerRadius=0），
         不再画内层边框/阴影——与 MainWindow.xaml 同一做法。 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Grid Margin="0">
        <Border CornerRadius="0" Background="{DynamicResource WindowBackground}"
                BorderThickness="0" ClipToBounds="True">
            <Grid>
                <ctl:AuroraBackdrop Opacity="0.42" IsHitTestVisible="False" />
                <Grid Margin="28,24,28,24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid MouseLeftButtonDown="DragArea">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="12" Background="#224FE3FF" VerticalAlignment="Top">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0">
                            <TextBlock Text="管理员代理服务" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="SYSTEM Broker · 仅测试版" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource WindowButton}" Height="30" Width="32" Click="Close_Click">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                        </Button>
                    </Grid>
                    <TextBlock Grid.Row="1" Margin="0,20,0,16" Foreground="{DynamicResource TextSecondary}" FontSize="12" LineHeight="21" TextWrapping="Wrap"
                               Text="服务负责在指定会话中启动并验证管理员代理，不直接执行鼠标键盘输入。不会修改挂机版或 UAC 设置。" />
                    <Border Grid.Row="2" Style="{StaticResource GlassPanel}" Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource AmberBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="StatusTitle" Text="正在检测服务…" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" x:Name="StatusText" Text="请稍候" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" LineHeight="20" Margin="0,12,0,14" />
                            <Border Grid.Row="2" Background="#24050612" CornerRadius="10" Padding="12,9">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <TextBlock Text="固定安装目录" FontSize="10" Foreground="{DynamicResource TextMuted}" />
                                    <TextBox Grid.Row="1" x:Name="InstallPath" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextSecondary}" FontSize="11" Padding="0,5" TextWrapping="Wrap" />
                                    <TextBox Grid.Row="2" x:Name="Diagnostics" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextMuted}" FontSize="10.5" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" />
                                </Grid>
                            </Border>
                            <TextBlock Grid.Row="3" Text="服务未运行时请先安装；启用通道请在设置页操作。" Foreground="{DynamicResource TextMuted}" FontSize="10.5" Margin="0,12,0,0" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="3" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button Content="复制诊断" Style="{StaticResource GhostButton}" Padding="12,9" HorizontalAlignment="Left" Click="Copy_Click" />
                        <Button Grid.Column="1" Content="卸载测试服务" Style="{StaticResource GhostButton}" Padding="14,9" Click="Uninstall_Click" />
                        <Button Grid.Column="2" Content="重新检测" Style="{StaticResource GhostButton}" Padding="14,9" Margin="8,0,0,0" Click="Detect_Click" />
                        <Button Grid.Column="3" Content="安装 / 修复服务" Style="{StaticResource PrimaryButton}" Padding="20,9" Margin="8,0,0,0" Click="Install_Click" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>