<Window x:Class="SoulLink.Views.LogoffTransitionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正在注销" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Topmost="False" ShowActivated="False"
        FontFamily="{StaticResource UiFont}" Focusable="False" IsHitTestVisible="False">
    <Window.Resources>
        <Storyboard x:Key="SpinnerStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                             Storyboard.TargetProperty="Angle" From="0" To="360"
                             Duration="0:0:1.1" />
        </Storyboard>
    </Window.Resources>
    <Border Background="#FF050811">
        <Grid>
            <Border Width="340" Height="220" VerticalAlignment="Center" HorizontalAlignment="Center"
                    CornerRadius="22" Background="#0D8B6BFF" BorderBrush="#20FFFFFF" BorderThickness="1" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid Width="54" Height="54" HorizontalAlignment="Center">
                    <Ellipse Stroke="#227C8CFF" StrokeThickness="2" />
                    <Ellipse x:Name="SpinnerArc" Stroke="{StaticResource CyanBrush}" StrokeThickness="2"
                             StrokeDashArray="16 82" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotation" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
                <TextBlock x:Name="StatusText" Text="正在注销…" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,23,0,0" />
                <TextBlock x:Name="DetailText" Text="正在安全关闭会话与画面" FontSize="11.5"
                           Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,9,0,0" />
                <ProgressBar IsIndeterminate="True" Width="150" Height="3" Margin="0,20,0,0"
                             Foreground="{StaticResource CyanBrush}" Background="#18FFFFFF" BorderThickness="0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>