<UserControl x:Class="SoulLink.Views.LobbyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- ══════════ 左：房间列表 ══════════ -->
        <Border Grid.Column="0" Style="{StaticResource GlassCardStrong}" Padding="18,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />   <!-- 标题 + 状态 -->
                    <RowDefinition Height="Auto" />   <!-- 分类页签 -->
                    <RowDefinition Height="Auto" />   <!-- 操作按钮 -->
                    <RowDefinition Height="*" />      <!-- 房间列表 -->
                </Grid.RowDefinitions>

                    <!-- 第一行：标题 + 连接状态 -->
                    <Grid Grid.Row="0" Margin="2,0,2,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="联机大厅" Style="{StaticResource Title}"
                                       VerticalAlignment="Center" />
                            <Ellipse x:Name="ConnDot" Width="7" Height="7"
                                     VerticalAlignment="Center" Margin="14,3,5,0"
                                     Fill="#8B9CC8" />
                            <TextBlock x:Name="ConnText" Text="连接中…" FontSize="10.5"
                                       Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center" Margin="0,3,0,0" />
                            <TextBlock x:Name="SubText" Text="" Style="{StaticResource Caption}"
                                       Margin="10,3,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <!-- 第三行：操作按钮 -->
                    <Grid Grid.Row="2" Margin="2,0,2,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Click="Refresh_Click" Padding="12,7" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="刷新" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11.5" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="MyDepart_Click" Padding="12,7" Margin="0,0,8,0"
                                    ToolTip="设置房间发车时，你的客户端要执行什么">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="我的发车动作" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11.5" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="Join_Click" Padding="12,7" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8FA;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="加入房间" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11.5" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PrimaryButton}" Click="CreateRoom_Click" Padding="12,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="新建房间" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11.5" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 第二行：分类页签 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,0,2,10"
                                VerticalAlignment="Center">
                        <ToggleButton x:Name="TabAll" Content="全部" IsChecked="True" Click="Tab_Click"
                                      Style="{StaticResource ChipToggle}" Tag="all" />
                        <ToggleButton x:Name="TabFour" Content="私人房间" Click="Tab_Click"
                                      Style="{StaticResource ChipToggle}" Tag="four" Margin="8,0,0,0" />
                        <ToggleButton x:Name="TabTwo" Content="私人·大小号" Click="Tab_Click"
                                      Style="{StaticResource ChipToggle}" Tag="two" Margin="8,0,0,0" />
                    </StackPanel>

                <!-- 房间卡片列表 -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="RoomList" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ══════════ 右：详情 ══════════ -->
        <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="DetailTitle" Text="房间详情"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" Margin="2,0,0,12" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="DetailPanel">
                        <TextBlock Text="点击左侧房间查看详情" FontSize="11.5"
                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 底部操作 -->
                <StackPanel Grid.Row="2" x:Name="ActionPanel" Margin="0,12,0,0"
                            Visibility="Collapsed">
                    <Button x:Name="BtnJoin" Style="{StaticResource PrimaryButton}"
                            Padding="14,10" Click="Join_Click" Margin="0,0,0,8">
                        <TextBlock Text="加入房间" FontSize="12.5" FontWeight="SemiBold" />
                    </Button>
                    <Button x:Name="BtnDepart" Style="{StaticResource PrimaryButton}"
                            Padding="14,10" Click="Depart_Click" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="发车" Margin="8,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnEditCode" Style="{StaticResource GhostButton}"
                            Padding="14,9" Click="EditCode_Click" Margin="0,0,0,8">
                        <TextBlock Text="修改房间码" FontSize="12" />
                    </Button>
                    <Button x:Name="BtnLeave" Style="{StaticResource GhostButton}"
                            Padding="14,9" Click="Leave_Click" Margin="0,0,0,8">
                        <TextBlock Text="离开房间" FontSize="12" />
                    </Button>
                    <Button x:Name="BtnDelete" Style="{StaticResource GhostButton}"
                            Padding="14,9" Click="Delete_Click">
                        <TextBlock Text="关闭房间" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
