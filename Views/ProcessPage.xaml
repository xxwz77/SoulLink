<UserControl x:Class="SoulLink.Views.ProcessPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <Border Style="{StaticResource GlassCardStrong}" Padding="18,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Grid Grid.Row="0" Margin="2,0,2,12">
                <StackPanel>
                    <TextBlock Text="会话进程" Style="{StaticResource Title}" />
                    <TextBlock x:Name="SubText" Text="选择一个在线的用户，查看它桌面里运行的程序" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <!-- 工具条 -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" x:Name="UserCombo" Height="40" SelectionChanged="UserCombo_SelectionChanged"
                          ToolTip="选择要查看的用户会话">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Session.UserName}" FontSize="12.5" />
                                <TextBlock Text="{Binding TagText}" FontSize="10.5" Foreground="#8899B8E0" Margin="7,1,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Border Grid.Column="2" CornerRadius="11" Background="#1CFFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="12,0,8,0" />
                        <TextBox Grid.Column="1" x:Name="SearchBox" Style="{StaticResource GlassTextBox}"
                                 Background="Transparent" BorderThickness="0" Padding="0,9" TextChanged="SearchBox_TextChanged" />
                    </Grid>
                </Border>

                <Button Grid.Column="4" Style="{StaticResource GhostButton}" Height="40" Padding="16,0" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="刷新" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="6" x:Name="BtnKill" Style="{StaticResource DangerButton}" Height="40" Padding="18,0"
                        Click="Kill_Click" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="结束进程" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 进程表 -->
            <Border Grid.Row="2" CornerRadius="14" Background="#0CFFFFFF" BorderBrush="#1EFFFFFF" BorderThickness="1" Padding="2">
                <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None" Background="Transparent"
                          RowBackground="Transparent" BorderThickness="0" CanUserAddRows="False"
                          SelectionMode="Extended" SelectionChanged="Grid_SelectionChanged"
                          Foreground="{StaticResource TextSecondary}" FontSize="12" RowHeight="38">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="#22FFFFFF" />
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#14FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#3055E0FF" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="程序" Binding="{Binding Name}" Width="190" />
                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" />
                        <DataGridTextColumn Header="窗口标题" Binding="{Binding Title}" Width="*" />
                        <DataGridTextColumn Header="路径" Binding="{Binding ExePath}" Width="300" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 底部 -->
            <Grid Grid.Row="3" Margin="2,12,2,0">
                <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Padding="14,8" Click="OpenNew_Click">
                        <TextBlock Text="在这个会话打开程序" FontSize="11.5" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>