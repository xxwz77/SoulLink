<UserControl x:Class="SoulLink.Views.ProcessPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <Border Style="{StaticResource GlassCardStrong}" Padding="18,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Grid Grid.Row="0" Margin="2,0,2,12">
                <StackPanel>
                    <TextBlock Text="会话瘦身" Style="{StaticResource Title}" />
                    <TextBlock x:Name="SubText" Text="清理会话里与挂机无关的外围进程，降低内存与 CPU 占用" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <!-- 工具条 -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" x:Name="UserCombo" Height="40" SelectionChanged="UserCombo_SelectionChanged"
                          ToolTip="选择要查看的用户会话">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Session.UserName}" FontSize="12.5" />
                                <TextBlock Text="{Binding TagText}" FontSize="10.5" Foreground="#8899B8E0" Margin="7,1,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>


                <Button Grid.Column="4" Style="{StaticResource GhostButton}" Height="40" Padding="16,0" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="刷新" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                
            </Grid>

            <!-- 进程表 -->
            <!-- ★ 会话瘦身面板：统计 + 清理 + 按账号勾选的启动项优化 -->
            <Border Grid.Row="2" CornerRadius="12" Margin="0,0,0,12" Padding="14,12"
                    Background="{DynamicResource FieldBackground}" BorderBrush="#28FFFFFF" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="会话瘦身" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock x:Name="SlimSummary" FontSize="11" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                       Text="选择会话后显示进程构成" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnSlim" Style="{StaticResource PrimaryButton}"
                                    Padding="16,7" Margin="0,0,8,0" Click="Slim_Click">
                                <TextBlock Text="清理外围进程" FontSize="12" />
                            </Button>
                            <Button x:Name="BtnPolicy" Style="{StaticResource GhostButton}"
                                    Padding="14,7" Click="Policy_Click">
                                <TextBlock Text="应用启动项优化" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="PolicyHint" FontSize="10.5" Margin="0,9,0,0"
                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                               Text="启动项优化只作用于下方勾选的账号，未勾选的完全不受影响。" />

                    <ItemsControl x:Name="PolicyList" Margin="0,9,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="10,6" Margin="0,0,8,6"
                                        Background="{DynamicResource ButtonBackground}"
                                        MouseLeftButtonUp="PolicyRow_Click" Cursor="Hand"
                                        ToolTip="点击切换该账号是否参与优化">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- ★ 用圆点开关代替系统 CheckBox：
                                             默认勾选框在深色玻璃主题里是白底方块，很扎眼。
                                             这里做成「空心圆 = 关 / 实心圆 = 开」，
                                             跟随主题色，点击整行都能切换。 -->
                                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                                            <Ellipse x:Name="DotOff" Width="14" Height="14"
                                                     Stroke="{DynamicResource TextMuted}" StrokeThickness="1.2"
                                                     Fill="Transparent">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <Ellipse Width="14" Height="14" Fill="{StaticResource CyanBrush}">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>
                                        <TextBlock Text="{Binding UserName}" FontSize="12"
                                                   Margin="7,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="{Binding StateText}" FontSize="10"
                                                   Margin="7,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMuted}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ★ 白名单透明化：明确告诉用户会动哪些、不会动哪些 -->
            <Border Grid.Row="3" CornerRadius="10" Margin="0,0,0,10" Padding="12,9"
                    Background="{DynamicResource ButtonBackground}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="清理范围" FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" />
                        <Button Grid.Column="1" x:Name="BtnResetList" Style="{StaticResource GhostButton}"
                                Padding="10,4" Click="ResetList_Click">
                            <TextBlock Text="恢复默认" FontSize="10.5" />
                        </Button>
                    </Grid>

                    <!-- 当前生效的清理名单（内置 + 用户添加），每项可单独移除 -->
                    <ItemsControl x:Name="KillListItems" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="8,4" Margin="0,0,6,5"
                                        Background="{DynamicResource FieldBackground}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="10.5"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Text="{Binding SourceText}" FontSize="9"
                                                   Margin="5,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMuted}" />
                                        <Button Style="{StaticResource GhostButton}"
                                                Padding="4,0" Margin="6,0,0,0"
                                                Visibility="{Binding RemoveVisibility}"
                                                Click="RemoveOne_Click" Tag="{Binding Name}">
                                            <TextBlock Text="✕" FontSize="9" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="WhitelistText" FontSize="10.5" Margin="0,6,0,0"
                               TextWrapping="Wrap" LineHeight="17"
                               Foreground="{DynamicResource TextMuted}" />
                </StackPanel>
            </Border>

            <!-- ★ 高级区：默认折叠。需要看/杀单个进程时展开 -->
            <Expander Grid.Row="4" x:Name="AdvancedPanel" Margin="0,0,0,10"
                      Foreground="{DynamicResource TextSecondary}"
                      IsExpanded="True">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="进程列表" FontSize="11.5"
                                   Foreground="{DynamicResource TextMuted}" />
                        <TextBlock x:Name="ProcessCountText" Text="" FontSize="11"
                                   Margin="7,0,0,0"
                                   Foreground="{DynamicResource TextMuted}" />
                    </StackPanel>
                </Expander.Header>
                <!-- ★ 必须用 Grid 而不是 StackPanel：StackPanel 在垂直方向不限制
                     子元素高度，DataGrid 会因虚拟化拿不到可用高度而渲染为 0 行。
                     Grid 配合 * 行高才能让 DataGrid 正常撑开并滚动。 -->
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                <Border Grid.Row="0" MinHeight="180" CornerRadius="12" Background="#0CFFFFFF" BorderBrush="#1EFFFFFF" BorderThickness="1" Padding="2">
                    <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None" Background="Transparent"
                              BorderThickness="0" SelectionMode="Extended"
                              SelectionChanged="Grid_SelectionChanged">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="#22FFFFFF" />
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#14FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#3055E0FF" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <!-- ★ 友好名称 + 图标：进程名（如 CrossDeviceService.exe）
                             普通用户不认识，用图标 + 中文说明帮助识别 -->
<DataGridTemplateColumn Header="程序" Width="240" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2,0">
                                        <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Width="18" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                        <!-- ★ 单行显示「中文名（进程名）」，不再上下叠：
                                             两行会让列显得很挤，而且同一进程重复时更难扫读。 -->
                                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" FontSize="11.5"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   Text="{Binding DisplayLabel}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="PID" Binding="{Binding PidText}" Width="88" />
                        <DataGridTextColumn Header="路径" Binding="{Binding ExePath}" Width="*" />
                        
                    </DataGrid.Columns>
                </DataGrid>
                </Border>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <TextBlock Text="可多选后结束选中进程" FontSize="10.5" VerticalAlignment="Center"
                               Margin="0,0,10,0" Foreground="{DynamicResource TextMuted}" />
                    <Button x:Name="BtnAddToList" Style="{StaticResource GhostButton}"
                            Padding="14,6" Margin="0,0,8,0" IsEnabled="False" Click="AddToList_Click">
                        <TextBlock Text="加入清理名单" FontSize="11.5" />
                    </Button>
                    <Button x:Name="BtnKillAdvanced" Style="{StaticResource DangerButton}"
                            Padding="14,6" IsEnabled="False" Click="Kill_Click">
                        <TextBlock Text="结束进程" FontSize="11.5" />
                    </Button>
                </StackPanel>
                </Grid>
            </Expander>

        </Grid>
    </Border>
</UserControl>