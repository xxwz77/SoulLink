<Window x:Class="SoulLink.Views.ActionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SoulLink.Controls"
        Title="快捷动作" Width="580" SizeToContent="Height" MaxHeight="940" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}">

    <Grid Margin="16">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.8" Color="#FF04060E" />
        </Grid.Effect>

        <Border CornerRadius="20" BorderBrush="#44FFFFFF" BorderThickness="1" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF0A1020" Offset="0" />
                    <GradientStop Color="#FF14112B" Offset="0.55" />
                    <GradientStop Color="#FF0B0F22" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <ctl:AuroraBackdrop Opacity="0.75" />

                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,4,0">
                <StackPanel Margin="26,22,26,4">
                    <!-- 标题 -->
                    <Grid x:Name="TitleRow" Background="Transparent" MouseLeftButtonDown="TitleRow_MouseLeftButtonDown">
                        <StackPanel>
                            <TextBlock x:Name="HeaderText" Text="新建快捷动作" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="选择账号与程序，直接复用账号已保存的加密凭据"
                                       FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource WindowButton}" HorizontalAlignment="Right" Height="28"
                                Click="Cancel_Click">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                        </Button>
                    </Grid>

                    <Border Style="{StaticResource Divider}" Margin="0,14" />

                    <!-- ① 动作名称 -->
                    <TextBlock Text="动作名称" Style="{StaticResource Label}" />
                    <TextBox x:Name="NameBox" Style="{StaticResource GlassTextBox}" />

                    <TextBlock Text="① 以哪个用户身份运行" Style="{StaticResource Label}" Margin="0,16,0,6" />
                    <ComboBox x:Name="UserCombo" IsEditable="True" Height="40"
                              TextSearch.TextPath="UserName"
                              TextBoxBase.TextChanged="UserCombo_TextChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding UserName}" FontSize="12.5" />
                                    <TextBlock Text="（已保存）" FontSize="10.5" Foreground="#8899B8E0" Margin="6,1,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock x:Name="UserHint" Style="{StaticResource Caption}" Margin="2,6,0,0"
                               Text="输入 Windows 用户名（不带域名），已有的账号会自动带出。"
                               TextWrapping="Wrap" />

                    <TextBlock Text="使用账号配置中已保存的加密凭据；修改密码请到通用设置 → 已保存的账号。"
                               Style="{StaticResource Caption}" Margin="2,10,0,0" />

                    <TextBlock Text="② 要操作的程序 + 打开还是关闭" Style="{StaticResource Label}" Margin="0,16,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="ExeBox" Style="{StaticResource GlassTextBox}" />
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Padding="12,0" Height="40" Click="Browse_Click">
                            <TextBlock Text="浏览" FontSize="12" />
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Padding="12,0" Height="40" Click="PickRunning_Click" ToolTip="从该用户当前运行的程序里选">
                            <TextBlock Text="从运行中选择" FontSize="12" />
                        </Button>
                    </Grid>

                    <!-- 动作分段 -->
                    <Border CornerRadius="12" Background="#14FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1"
                            Padding="4" Margin="0,14,0,0" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="KindOpen" Style="{StaticResource SegmentToggle}" Content="打开" IsChecked="True"
                                          Checked="Kind_Checked" />
                            <ToggleButton x:Name="KindClose" Style="{StaticResource SegmentToggle}" Content="关闭"
                                          Checked="Kind_Checked" />
                            <ToggleButton x:Name="KindRestart" Style="{StaticResource SegmentToggle}" Content="重启"
                                          Checked="Kind_Checked" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="KindHint" Style="{StaticResource Caption}" Margin="2,8,0,0"
                               Text="启动参数只在「打开 / 重启」时生效；关闭动作会忽略它。" TextWrapping="Wrap" />

                    <!-- 启动参数 -->
                    <TextBlock x:Name="ArgsTitle" Text="③ 启动参数（可不填）" Style="{StaticResource Label}" Margin="0,16,0,6" />
                    <Grid x:Name="ArgsRow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 预设下拉 -->
                        <ComboBox Grid.Column="0" x:Name="PresetCombo" Width="196" Height="40"
                                  ToolTip="选择预设的启动方式，前缀参数由程序自动带上"
                                  SelectionChanged="PresetCombo_SelectionChanged">
                            <ComboBoxItem Content="无参数（默认）" IsSelected="True" Tag="" />
                            <ComboBoxItem Content="一条龙" Tag="--startOneDragon " />
                            <ComboBoxItem Content="自定义…" Tag="__custom__" />
                        </ComboBox>

                        <!-- 一条龙的配置名（用户自己填） -->
                        <Border Grid.Column="1" x:Name="DragonNameShell" Margin="8,0,0,0" CornerRadius="11"
                                Background="#1A41F0C0" BorderBrush="#8841F0C0" BorderThickness="1" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="8" Background="#3341F0C0" Padding="8,4"
                                        VerticalAlignment="Center" Margin="7,0,0,0">
                                    <TextBlock x:Name="DragonArgText" Text="--startOneDragon" FontFamily="{StaticResource MonoFont}"
                                               FontSize="11.5" FontWeight="SemiBold" Foreground="#FFA8FFE0" />
                                </Border>
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="DragonNameBox" Style="{StaticResource GlassTextBox}"
                                             Background="Transparent" BorderThickness="0" Padding="9,9,10,9"
                                             TextChanged="DragonNameBox_TextChanged" />
                                    <TextBlock x:Name="DragonPlaceholder" Text="填配置名，如 启动" IsHitTestVisible="False"
                                               Foreground="#66C8E0FF" FontSize="12.5" VerticalAlignment="Center"
                                               Margin="12,0,0,0" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 自定义参数 -->
                        <TextBox Grid.Column="1" x:Name="ArgsBox" Style="{StaticResource GlassTextBox}" Margin="8,0,0,0"
                                 Visibility="Collapsed" TextChanged="ArgsBox_TextChanged" />
                    </Grid>

                    <TextBlock x:Name="ArgsHint" Style="{StaticResource Caption}" Margin="2,7,0,0"
                               Text="选一个预设，前缀参数由 SoulLink 自动拼好；后面的配置名由你自己填。"
                               TextWrapping="Wrap" />

                    <!-- 高级 -->
                    <Expander x:Name="Advanced" Margin="0,16,0,0" Foreground="{StaticResource TextMuted}"
                              HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <TextBlock Text="高级选项（可不填）" FontSize="11.5" Foreground="{StaticResource TextSecondary}" />
                        </Expander.Header>
                        <StackPanel Margin="0,10,0,0">
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="延时执行（秒）" Style="{StaticResource Label}" />
                                    <TextBox x:Name="DelayBox" Style="{StaticResource GlassTextBox}" Text="0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="固定会话 ID（0=自动）" Style="{StaticResource Label}" />
                                    <TextBox x:Name="SessionBox" Style="{StaticResource GlassTextBox}" Text="0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Expander>

                </StackPanel>
                </ScrollViewer>

                <!-- 底部固定区：错误提示 + 生成命令 + 按钮，永远可见 -->
                <StackPanel Grid.Row="1" Margin="26,0,26,20">
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource RoseBrush}" FontSize="11.5"
                               Margin="2,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

                    <Border Style="{StaticResource Divider}" Margin="0,10,0,12" />

                    <!-- 生成命令（独占一行，不压住按钮） -->
                    <Border CornerRadius="10" Background="#14000000" BorderBrush="#22FFFFFF" BorderThickness="1"
                            Padding="10,7" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="CmdHint" Style="{StaticResource Mono}"
                                       TextTrimming="CharacterEllipsis" Foreground="#FF9FC6E8"
                                       VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="26" Height="26"
                                    Click="CopyCmd_Click" ToolTip="复制这条命令">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 底部按钮 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostButton}" Click="Cancel_Click" Padding="20,10">
                            <TextBlock Text="取消" />
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="10,0,0,0" Padding="26,10">
                            <TextBlock Text="保存" />
                        </Button>
                    </StackPanel>
                </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>