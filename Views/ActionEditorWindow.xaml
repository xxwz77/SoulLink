<Window x:Class="SoulLink.Views.ActionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SoulLink.Controls"
        Title="快捷动作" Width="580" Height="900" MaxHeight="940" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}">

    <Grid Margin="16">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.8" Color="#FF04060E" />
        </Grid.Effect>

        <Border CornerRadius="20" BorderBrush="#44FFFFFF" BorderThickness="1" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF0A1020" Offset="0" />
                    <GradientStop Color="#FF14112B" Offset="0.55" />
                    <GradientStop Color="#FF0B0F22" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <ctl:AuroraBackdrop Opacity="0.75" />

                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,4,0">
                <StackPanel Margin="26,22,26,4">
                    <!-- 标题 -->
                    <Grid x:Name="TitleRow" Background="Transparent" MouseLeftButtonDown="TitleRow_MouseLeftButtonDown">
                        <StackPanel>
                            <TextBlock x:Name="HeaderText" Text="新建快捷动作" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="选择账号与程序，直接复用账号已保存的加密凭据"
                                       FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource WindowButton}" HorizontalAlignment="Right" Height="28"
                                Click="Cancel_Click">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                        </Button>
                    </Grid>

                    <Border Style="{StaticResource Divider}" Margin="0,14" />

                    <!-- ① 动作名称 -->
                    <TextBlock Text="动作名称" Style="{StaticResource Label}" />
                    <TextBox x:Name="NameBox" Style="{StaticResource GlassTextBox}" />

                    <TextBlock Text="① 以哪个用户身份运行" Style="{StaticResource Label}" Margin="0,16,0,6" />
                    <!-- 用户名：输入区 + 下拉按钮合成一个整体，下拉列表用 Popup 贴在该框正下方 -->
                    <Grid x:Name="UserFieldHost">
                        <Border x:Name="UserFieldShell" Height="40" CornerRadius="11"
                                Background="{StaticResource FieldBackground}"
                                BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 输入框自身无边框、无背景，完全融进外层 Border -->
                                <TextBox x:Name="UserBox" Grid.Column="0"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TextPrimary}"
                                         CaretBrush="{StaticResource CyanBrush}"
                                         SelectionBrush="#804FE3FF"
                                         FontFamily="{StaticResource UiFont}" FontSize="13"
                                         Padding="12,0" VerticalContentAlignment="Center"
                                         TextChanged="UserBox_TextChanged" />

                                <Button x:Name="UserDropButton" Grid.Column="1" Width="38"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Click="UserDrop_Click"
                                        ToolTip="从已保存账号中选择">
                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               Foreground="{StaticResource TextSecondary}" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 下拉列表：宽度与输入框一致，紧贴其下沿。
                             ★ 用**半透明**深色底（约 88%）：纯 GlassPanel 的 #18FFFFFF 太透，
                               下面正文会透出来和菜单文字叠在一起；
                               但也不该做成全不透明，否则破坏整体的玻璃拟态风格。 -->
                        <Popup x:Name="UserPopup" PlacementTarget="{Binding ElementName=UserFieldShell}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               PopupAnimation="Fade" VerticalOffset="4">
                            <Border CornerRadius="12" Padding="4"
                                    Background="#E6111A33"
                                    BorderBrush="#55FFFFFF" BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, ElementName=UserFieldShell}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Opacity="0.55" />
                                </Border.Effect>
                                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="UserPopupList" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <TextBlock x:Name="UserHint" Style="{StaticResource Caption}" Margin="2,6,0,0"
                               Text="输入 Windows 用户名（不带域名），已有的账号会自动带出。"
                               TextWrapping="Wrap" />

                    <TextBlock Text="使用账号配置中已保存的加密凭据；修改密码请到通用设置 → 已保存的账号。"
                               Style="{StaticResource Caption}" Margin="2,10,0,0" />

                    <TextBlock x:Name="ExeTitle" Text="② 要操作的程序"
                               Style="{StaticResource Label}" Margin="0,16,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="ExeBox" Style="{StaticResource GlassTextBox}"
                                 TextChanged="ExeBox_TextChanged" />
                        <!-- BGI 快捷按钮：首次点提示绑定路径，之后同用户默认记住 -->
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Padding="12,0" Height="40" Click="PickBgi_Click"
                                ToolTip="一键填入该用户的 BetterGI 路径（首次需要指定）">
                            <TextBlock Text="BGI" FontSize="12" FontWeight="SemiBold" />
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Padding="12,0" Height="40" Click="Browse_Click">
                            <TextBlock Text="浏览" FontSize="12" />
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Padding="12,0" Height="40" Click="PickRunning_Click" ToolTip="从该用户当前运行的程序里选">
                            <TextBlock Text="从运行中选择" FontSize="12" />
                        </Button>
                    </Grid>

                    <!-- ③ 启动参数（左）+ 动作（右）：两栏**各占一半** -->
                    <Grid Margin="0,16,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左：启动参数 -->
                        <TextBlock x:Name="ArgsTitle" Grid.Column="0"
                                   Text="③ 启动方式"
                                   Style="{StaticResource Label}" VerticalAlignment="Center" />
                        <!-- 右：动作（选了一条龙/配置组时整块隐藏） -->
                        <TextBlock x:Name="KindTitle" Grid.Column="2"
                                   Text="动作"
                                   Style="{StaticResource Label}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid x:Name="ArgsKindGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" x:Name="ArgsRow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 启动方式（按 BGI 官方命令行文档 bettergi.com/feats/command）
                             无参数：什么都不带
                             启动：BetterGI.exe start
                             一条龙：startOneDragon 前缀 + 可选配置名
                             配置组：startGroups 前缀 + 多个组名（空格分隔）
                             自定义：原样传入 -->
                        <ComboBox Grid.Column="0" x:Name="PresetCombo" Width="160" Height="44"
                                  FontSize="13.5"
                                  ToolTip="选择启动方式，参数由 SoulLink 按 BGI 官方命令行规则拼好"
                                  SelectionChanged="PresetCombo_SelectionChanged">
                            <ComboBoxItem Content="无参数" IsSelected="True" Tag="" />
                            <ComboBoxItem Content="启动" Tag="__start__" />
                            <ComboBoxItem Content="一条龙" Tag="__onedragon__" />
                            <ComboBoxItem Content="配置组" Tag="__scriptgroup__" />
                            <ComboBoxItem Content="自定义…" Tag="__custom__" />
                        </ComboBox>

                        <!-- 一条龙：选一个配置名（留空则用页面选定的）。
                             不再放"一条龙"小标签 —— 它占宽度，导致下拉框被挤得很窄，
                             列表里配置名一长就看不全。 -->
                        <Grid Grid.Column="1" x:Name="DragonPickShell" Margin="8,0,0,0" Visibility="Collapsed">
                            <ComboBox x:Name="DragonCombo" Height="44" FontSize="13.5"
                                      ToolTip="该账号 User 目录下 OneDragon 的配置；留空则执行页面选定的那条"
                                      SelectionChanged="DragonCombo_SelectionChanged" />
                        </Grid>

                        <!-- 配置组：可多选（BGI 支持一次传多个组名，空格分隔） -->
                        <Grid Grid.Column="1" x:Name="GroupPickShell" Margin="8,0,0,0" Visibility="Collapsed">
                            <Grid>
                                <Border x:Name="GroupFieldShell" Height="44" CornerRadius="11"
                                        Background="{StaticResource FieldBackground}"
                                        BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="GroupSummary"
                                                   Grid.Column="0" Margin="11,0,0,0"
                                                   VerticalAlignment="Center" FontSize="13.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   Text="（未选择）" />
                                        <Button Grid.Column="1" Width="38" Background="Transparent"
                                                BorderThickness="0" Cursor="Hand" Click="GroupPick_Click"
                                                ToolTip="选择要执行的配置组（可多选）">
                                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                       Foreground="{StaticResource TextSecondary}" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- 多选列表：贴在该框正下方 -->
                                <Popup x:Name="GroupPopup" PlacementTarget="{Binding ElementName=GroupFieldShell}"
                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                       PopupAnimation="Fade" VerticalOffset="4">
                                    <Border CornerRadius="12" Padding="4"
                                            Background="#E6111A33"
                                            BorderBrush="#55FFFFFF" BorderThickness="1"
                                            MinWidth="{Binding ActualWidth, ElementName=GroupFieldShell}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="3" Opacity="0.6" />
                                        </Border.Effect>
                                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="GroupPopupList" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>

                        <!-- 自定义参数 -->
                        <TextBox Grid.Column="1" x:Name="ArgsBox" Style="{StaticResource GlassTextBox}" Margin="8,0,0,0"
                                 Visibility="Collapsed" TextChanged="ArgsBox_TextChanged" />
                        </Grid>

                        <!-- 右：动作分段（打开 / 关闭 / 重启）。选了一条龙/配置组时隐藏 -->
                        <Border Grid.Column="2" x:Name="KindShell"
                                CornerRadius="12" Background="#14FFFFFF" BorderBrush="#28FFFFFF"
                                BorderThickness="1" Padding="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="KindOpen" Style="{StaticResource SegmentToggle}" Content="打开" IsChecked="True"
                                              Checked="Kind_Checked" />
                                <ToggleButton x:Name="KindClose" Style="{StaticResource SegmentToggle}" Content="关闭"
                                              Checked="Kind_Checked" />
                                <ToggleButton x:Name="KindRestart" Style="{StaticResource SegmentToggle}" Content="重启"
                                              Checked="Kind_Checked" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="ArgsHint" Style="{StaticResource Caption}" Margin="2,7,0,0"
                               Text="选一个预设，前缀参数由 SoulLink 自动拼好；后面的配置名由你自己填。"
                               TextWrapping="Wrap" />

                    <!-- 高级 -->
                    <Expander x:Name="Advanced" Margin="0,16,0,0" Foreground="{StaticResource TextMuted}"
                              HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <TextBlock Text="高级选项（可不填）" FontSize="11.5" Foreground="{StaticResource TextSecondary}" />
                        </Expander.Header>
                        <StackPanel Margin="0,10,0,0">
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- 会话 ID 已移除：执行时统一按用户名查找当前会话 -->
                                <StackPanel Grid.Column="0" Grid.ColumnSpan="3">
                                    <TextBlock Text="延时执行（秒）" Style="{StaticResource Label}" />
                                    <TextBox x:Name="DelayBox" Style="{StaticResource GlassTextBox}" Text="0" />
                                </StackPanel>
                            </Grid>

                            <!-- 执行前先停掉 BGI：一条龙必须从干净状态启动 -->
                            <CheckBox x:Name="StopBgiCheck" Style="{StaticResource GlassCheckBox}"
                                      Margin="0,14,0,0" IsChecked="True"
                                      Content="执行前先停止正在运行的 BGI（一条龙需要 BGI 处于停止状态）" />
                            <TextBlock Style="{StaticResource Caption}" Margin="24,3,0,0" TextWrapping="Wrap"
                                       Text="优先发该账号 BGI 里的「停止当前脚本」快捷键；未配置快捷键则直接结束该账号的 BetterGI 进程。只影响目标账号。" />

                            <!-- 关闭原神 -->
                            <CheckBox x:Name="CloseGenshinCheck" Style="{StaticResource GlassCheckBox}"
                                      Margin="0,10,0,0"
                                      Content="同时关闭该账号的原神（YuanShen.exe）" />
                            <TextBlock Style="{StaticResource Caption}" Margin="24,3,0,0" TextWrapping="Wrap"
                                       Text="只结束目标账号会话里的游戏进程，其他账号不受影响。" />

                            <!-- 停止后额外缓冲 -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="停止后额外等待（秒）"
                                           Style="{StaticResource Label}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" x:Name="StopWaitBox"
                                         Style="{StaticResource GlassTextBox}" Text="2" Margin="10,0,0,0" />
                                <TextBlock Grid.Column="2" Text="进程完全退出后再等这么久才启动"
                                           Style="{StaticResource Caption}" VerticalAlignment="Center"
                                           Margin="10,0,0,0" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <!-- ══════════ 定时执行 ══════════ -->
                    <Expander x:Name="ScheduleExpander" Margin="0,14,0,0" Foreground="{StaticResource TextMuted}"
                              HorizontalContentAlignment="Stretch" IsExpanded="False">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="定时执行" FontSize="11.5" Foreground="{StaticResource TextSecondary}" />
                                <TextBlock x:Name="ScheduleSummary" Text="（未启用）" FontSize="11"
                                           Foreground="{StaticResource TextMuted}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Expander.Header>

                        <StackPanel Margin="0,10,0,0">
                            <!-- ① 是否启用 + 用哪种方式运行 -->
                            <CheckBox x:Name="ScheduleEnabledCheck" Style="{StaticResource GlassCheckBox}"
                                      Content="启用定时执行" Checked="ScheduleEnabled_Changed"
                                      Unchecked="ScheduleEnabled_Changed" />

                            <StackPanel x:Name="ScheduleBody" Margin="24,10,0,0" IsEnabled="False" Opacity="0.45">
                                <!-- 定时类型 -->
                                <TextBlock Text="执行周期" Style="{StaticResource Label}" Margin="0,12,0,6" />
                                <WrapPanel x:Name="ScheduleKindPanel">
                                    <ToggleButton x:Name="KindDaily" Style="{StaticResource SegmentToggle}"
                                                  Content="每天" IsChecked="True" Checked="ScheduleKind_Checked" Margin="0,0,6,6" />
                                    <ToggleButton x:Name="KindWeekly" Style="{StaticResource SegmentToggle}"
                                                  Content="每周" Checked="ScheduleKind_Checked" Margin="0,0,6,6" />
                                    <ToggleButton x:Name="KindMonthly" Style="{StaticResource SegmentToggle}"
                                                  Content="每月" Checked="ScheduleKind_Checked" Margin="0,0,6,6" />
                                    <ToggleButton x:Name="KindYearly" Style="{StaticResource SegmentToggle}"
                                                  Content="每年" Checked="ScheduleKind_Checked" Margin="0,0,6,6" />
                                    <ToggleButton x:Name="KindInterval" Style="{StaticResource SegmentToggle}"
                                                  Content="固定间隔" Checked="ScheduleKind_Checked" Margin="0,0,6,6" />
                                    <ToggleButton x:Name="KindOnce" Style="{StaticResource SegmentToggle}"
                                                  Content="只一次" Checked="ScheduleKind_Checked" Margin="0,0,6,6" />
                                </WrapPanel>

                                <!-- 时间：时 分 秒 -->
                                <StackPanel x:Name="TimeRow">
                                    <TextBlock Text="执行时刻（精确到秒）" Style="{StaticResource Label}" Margin="0,10,0,6" />
                                    <!-- ★ 不用 GlassTextBox：它固定 Padding=12,9，
                                         在 64px 宽的窄框里会把数字挤出去（用户实测"挡住文字"）。
                                         这里用裸 TextBox + 外层 Border 自绘，Padding 为 0。 -->
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="62" Height="40" CornerRadius="10"
                                                Background="{StaticResource FieldBackground}"
                                                BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1">
                                            <TextBox x:Name="HourBox" Text="4" Background="Transparent"
                                                     BorderThickness="0" Padding="0" TextAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     Foreground="{StaticResource TextPrimary}"
                                                     CaretBrush="{StaticResource CyanBrush}"
                                                     FontSize="15" TextChanged="ScheduleInput_Changed" />
                                        </Border>
                                        <TextBlock Text="时" VerticalAlignment="Center" Margin="6,0,10,0"
                                                   Foreground="{StaticResource TextMuted}" />
                                        <Border Width="62" Height="40" CornerRadius="10"
                                                Background="{StaticResource FieldBackground}"
                                                BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1">
                                            <TextBox x:Name="MinuteBox" Text="0" Background="Transparent"
                                                     BorderThickness="0" Padding="0" TextAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     Foreground="{StaticResource TextPrimary}"
                                                     CaretBrush="{StaticResource CyanBrush}"
                                                     FontSize="15" TextChanged="ScheduleInput_Changed" />
                                        </Border>
                                        <TextBlock Text="分" VerticalAlignment="Center" Margin="6,0,10,0"
                                                   Foreground="{StaticResource TextMuted}" />
                                        <Border Width="62" Height="40" CornerRadius="10"
                                                Background="{StaticResource FieldBackground}"
                                                BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1">
                                            <TextBox x:Name="SecondBox" Text="0" Background="Transparent"
                                                     BorderThickness="0" Padding="0" TextAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     Foreground="{StaticResource TextPrimary}"
                                                     CaretBrush="{StaticResource CyanBrush}"
                                                     FontSize="15" TextChanged="ScheduleInput_Changed" />
                                        </Border>
                                        <TextBlock Text="秒" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   Foreground="{StaticResource TextMuted}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- 星期（Weekly） -->
                                <StackPanel x:Name="WeekRow" Visibility="Collapsed">
                                    <TextBlock Text="星期几（可多选）" Style="{StaticResource Label}" Margin="0,10,0,6" />
                                    <WrapPanel x:Name="WeekDayPanel">
                                        <CheckBox Content="周日" Tag="0" Style="{StaticResource GlassCheckBox}" Margin="0,0,10,6" />
                                        <CheckBox Content="周一" Tag="1" Style="{StaticResource GlassCheckBox}" Margin="0,0,10,6" />
                                        <CheckBox Content="周二" Tag="2" Style="{StaticResource GlassCheckBox}" Margin="0,0,10,6" />
                                        <CheckBox Content="周三" Tag="3" Style="{StaticResource GlassCheckBox}" Margin="0,0,10,6" />
                                        <CheckBox Content="周四" Tag="4" Style="{StaticResource GlassCheckBox}" Margin="0,0,10,6" />
                                        <CheckBox Content="周五" Tag="5" Style="{StaticResource GlassCheckBox}" Margin="0,0,10,6" />
                                        <CheckBox Content="周六" Tag="6" Style="{StaticResource GlassCheckBox}" Margin="0,0,10,6" />
                                    </WrapPanel>
                                </StackPanel>

                                <!-- 几号 / 几月（Monthly / Yearly） -->
                                <StackPanel x:Name="DayOfMonthRow" Orientation="Horizontal" Visibility="Collapsed" Margin="0,10,0,0">
                                    <TextBlock x:Name="MonthLabel" Text="日期" Style="{StaticResource Label}"
                                               VerticalAlignment="Center" Visibility="Collapsed" />
                                    <TextBox x:Name="MonthBox" Width="64" Height="40" Text="1"
                                             Style="{StaticResource CompactTextBox}"
                                             Margin="6,0,0,0" Visibility="Collapsed" TextChanged="ScheduleInput_Changed" />
                                    <TextBlock x:Name="MonthUnit" Text="月" VerticalAlignment="Center" Margin="6,0,10,0"
                                               Foreground="{StaticResource TextMuted}" Visibility="Collapsed" />
                                    <TextBox x:Name="DayBox" Width="64" Height="40" Text="1"
                                             Style="{StaticResource CompactTextBox}" TextChanged="ScheduleInput_Changed" />
                                    <TextBlock Text="号" VerticalAlignment="Center" Margin="6,0,0,0"
                                               Foreground="{StaticResource TextMuted}" />
                                </StackPanel>

                                <!-- 固定间隔 -->
                                <StackPanel x:Name="IntervalRow" Orientation="Horizontal" Visibility="Collapsed" Margin="0,10,0,0">
                                    <TextBlock Text="每" Style="{StaticResource Label}" VerticalAlignment="Center" />
                                    <TextBox x:Name="IntervalBox" Width="80" Height="40" Text="60"
                                             Style="{StaticResource CompactTextBox}" Margin="8,0,0,0" TextChanged="ScheduleInput_Changed" />
                                    <ComboBox x:Name="IntervalUnitCombo" Width="90" Height="40" Margin="8,0,0,0" SelectionChanged="ScheduleUnit_Changed"
                                              SelectedIndex="1">
                                        <ComboBoxItem Content="秒" Tag="1" />
                                        <ComboBoxItem Content="分钟" Tag="60" />
                                        <ComboBoxItem Content="小时" Tag="3600" />
                                    </ComboBox>
                                    <TextBlock Text="执行一次" Style="{StaticResource Label}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>

                                <!-- 只一次 -->
                                <StackPanel x:Name="OnceRow" Visibility="Collapsed" Margin="0,10,0,0">
                                    <TextBlock Text="执行时间" Style="{StaticResource Label}" Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="OnceDateBox" Width="150" Height="40" Text="2026-01-01"
                                                 Style="{StaticResource CompactTextBox}" TextChanged="ScheduleInput_Changed" />
                                        <TextBox x:Name="OnceTimeBox" Width="110" Height="40" Text="04:00:00"
                                                 Style="{StaticResource CompactTextBox}" Margin="8,0,0,0" TextChanged="ScheduleInput_Changed" />
                                        <TextBlock Text="（日期  时:分:秒）" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- ★ 每次执行后延后 -->
                                <TextBlock Text="每次执行后延后" Style="{StaticResource Label}" Margin="0,14,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="PostDelayBox" Width="80" Height="40" Text="0"
                                             Style="{StaticResource CompactTextBox}" TextChanged="ScheduleInput_Changed" />
                                    <ComboBox x:Name="PostDelayUnitCombo" Width="90" Height="40" Margin="8,0,0,0" SelectionChanged="ScheduleUnit_Changed"
                                              SelectedIndex="1">
                                        <ComboBoxItem Content="秒" Tag="1" />
                                        <ComboBoxItem Content="分钟" Tag="60" />
                                        <ComboBoxItem Content="小时" Tag="3600" />
                                        <ComboBoxItem Content="天" Tag="86400" />
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="例：基准 4:00 延后 1 分钟 → 第2 次 4:01、第3 次 4:02。延后 1 天则是隔一天后的 4:00。" />

                                <!-- 下次执行预览 -->
                                <Border CornerRadius="8" Background="#18000000" Padding="10,7" Margin="0,12,0,0">
                                    <TextBlock x:Name="NextRunHint" Text="下次执行：—"
                                               FontSize="11" Foreground="{StaticResource TextSecondary}"
                                               TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                </StackPanel>
                </ScrollViewer>

                <!-- 底部固定区：错误提示 + 生成命令 + 按钮，永远可见 -->
                <StackPanel Grid.Row="1" Margin="26,0,26,20">
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource RoseBrush}" FontSize="11.5"
                               Margin="2,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

                    <Border Style="{StaticResource Divider}" Margin="0,10,0,12" />

                    <!-- 生成命令（独占一行，不压住按钮） -->
                    <Border CornerRadius="10" Background="#14000000" BorderBrush="#22FFFFFF" BorderThickness="1"
                            Padding="10,7" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="CmdHint" Style="{StaticResource Mono}"
                                       TextTrimming="CharacterEllipsis" Foreground="#FF9FC6E8"
                                       VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="26" Height="26"
                                    Click="CopyCmd_Click" ToolTip="复制这条命令">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 底部按钮 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostButton}" Click="Cancel_Click" Padding="20,10">
                            <TextBlock Text="取消" />
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="10,0,0,0" Padding="26,10">
                            <TextBlock Text="保存" />
                        </Button>
                    </StackPanel>
                </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>