<Window x:Class="SoulLink.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SoulLink.Controls"
        xmlns:vm="clr-namespace:SoulLink.Views"
        Title="SoulLink · 跨会话执行器"
        Width="1240" Height="820" MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <!-- 外层容器。圆角由 DWM 负责，这里只铺底色，不再画边框（避免和内部玻璃层叠出两道框） -->
    <Grid x:Name="RootLayer" Margin="0">
        <Border x:Name="Shell" CornerRadius="0" Background="{DynamicResource WindowBackground}" BorderThickness="0">
            <Grid>
                <ctl:AuroraBackdrop x:Name="Backdrop" />

                <!-- ★ 不再画内层边框：它的 Margin 会形成一圈矩形，和 DWM 的弧形边不一致，
                     看起来就是「圆角窗口里套了个方框」。圆角完全交给 DWM。 -->

                <!-- ★ 顶部留 10px：DWM 圆角半径约 8px，内容顶到边缘会把角盖成方形 -->
                <Grid Margin="20,10,20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ═══ 标题栏 ═══ -->
                    <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="34" Height="34">
                                <Ellipse Fill="#22FFFFFF" />
                                <Ellipse Width="26" Height="26">
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF7C5CFF" Offset="0" />
                                            <GradientStop Color="#FF4FE3FF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.9" Color="#FF4FE3FF" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Ellipse Width="9" Height="9" Fill="#FFFFFFFF" />
                            </Grid>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SoulLink" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock x:Name="VersionText" FontSize="10.5" Foreground="{DynamicResource TextMuted}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                            <Border CornerRadius="12" Padding="11,5" Margin="0,0,12,0" Background="{DynamicResource ButtonBackground}" BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <ctl:GlowDot Width="9" Height="9" x:Name="EngineDot" VerticalAlignment="Center"
                                                 Color="#FF41F0C0" />
                                    <TextBlock x:Name="EngineText" Text="引擎就绪" Margin="7,0,0,0" FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Button x:Name="BtnCollapseNav" Style="{StaticResource WindowButton}"
                                    Width="34" Margin="0,0,6,0" Click="BtnToggleNav_Click"
                                    ToolTip="收起 / 展开侧栏">
                                <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                            </Button>
                            <Button x:Name="BtnMin" Style="{StaticResource WindowButton}" Click="BtnMin_Click" ToolTip="最小化">
                                <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                            </Button>
                            <Button x:Name="BtnMax" Style="{StaticResource WindowButton}" Click="BtnMax_Click" ToolTip="最大化">
                                <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                            </Button>
                            <Button x:Name="BtnClose" Style="{StaticResource WindowButton}" Click="BtnClose_Click" ToolTip="关闭">
                                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ═══ 主体 ═══ -->
                    <Grid Grid.Row="1" x:Name="SideNavHost">
                        <Grid.ColumnDefinitions>
                            <!-- ★ 图标栏固定 56 宽，列宽 76 = 56 + 20 间距。
                                 ★ rail 不能再设 Margin：列宽已经包含间距，
                                   再加 Margin 会把 rail 挤窄或者让间距消失（实测两者重叠）。
                                 收起时放图标栏，展开时侧栏以浮层盖在上面，画面尺寸**永不变化**，所以不会闪。 -->
                            <!-- ★ 展开时列宽跟着变，否则右侧内容会压住加宽后的侧栏（层级不够）。
                                 收起 76 = 56(rail) + 20(间距)；展开 200 = 180(rail) + 20(间距)。 -->
                            <ColumnDefinition x:Name="NavColumn" Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- ① 图标栏：恒定 56px 宽，永远占位
                             ★ 垂直必须与右侧内容卡片**完全等高**：主体 Grid 已经是内容区，
                               上下边距由外层 Margin(20,10,20,16) 提供，这里不能再加 Margin，
                               否则会比右卡矮一截（实测顶差 4 DIP、底差 16 DIP）。
                             ★ 左边距**不能在这里加**：外层内容区已有 Margin(20,...)，
                               再加一次会和右侧卡片错位（实测 rail 跑到 40 DIP，右卡仍是 20 DIP）。
                               所以 Margin 只留右边距 20，把图标栏和内容卡片隔开。 -->
                        <!-- ★ 侧栏：单个 Border，自身通过 Width 动画展开，不产生第二个窗口。
                             展开时右侧出现文字，收起时只剩图标。
                             这样彻底没有空域/翻边/越界/盖任务栏的问题。 -->
                        <!-- ★ Grid.ColumnSpan="2"：让侧栏横跨两列并左对齐。
                             这样它加宽时是**盖在右侧内容之上**，而不是把内容挤开
                             （用户要求：侧栏层级最高，展开时覆盖内容，内容位置不变）。
                             列宽保持 76 不变，右侧内容永远不动。 -->
                        <Border Grid.Column="0" Grid.ColumnSpan="2" x:Name="NavRail" Panel.ZIndex="99"
                                Style="{StaticResource NavSurface}"
                                HorizontalAlignment="Left" Width="56"
                                Margin="0" Padding="3,12"
                                ClipToBounds="True"
                                MouseEnter="NavRail_MouseEnter" MouseLeave="NavRail_MouseLeave">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                                <!-- 上：图标 + 文字 -->
                                <StackPanel Grid.Row="0" x:Name="RailIcons" VerticalAlignment="Top">
                                    <!-- 汉堡：展开时文字显示「控制台」 -->
                                    <Grid Height="36">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnHamburger" Grid.Column="0" Style="{StaticResource WindowButton}"
                                                Width="42" Height="36" HorizontalAlignment="Left"
                                                Click="BtnToggleNav_Click" ToolTip="展开 / 收起侧栏">
                                            <TextBlock x:Name="HamburgerGlyph" Text="&#xE700;"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                        </Button>
                                        <TextBlock x:Name="NavTitleText" Grid.Column="1" Text="控制台"
                                                   Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                   Margin="6,0,0,0" Visibility="Collapsed" />
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource StrokeSoft}" Margin="9,10,9,10" />

                                    <!-- 导航行：图标 +（展开时）文字 -->
                                    <Grid Height="38" Tag="launch" ToolTip="启动台"
                                          Background="Transparent" MouseLeftButtonUp="NavRow_Click">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE768;" Width="42" TextAlignment="Center"
                                                   VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource TextMuted}" />
                                        <TextBlock x:Name="NavTextLaunch" Grid.Column="1" Text="启动台"
                                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource TextPrimary}" FontSize="12.5"
                                                   Visibility="Collapsed" />
                                    </Grid>
                                    <Grid Height="38" Tag="console" ToolTip="中控台"
                                          Background="Transparent" MouseLeftButtonUp="NavRow_Click">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE7F4;" Width="42" TextAlignment="Center"
                                                   VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource TextMuted}" />
                                        <TextBlock x:Name="NavTextConsole" Grid.Column="1" Text="中控台"
                                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource TextPrimary}" FontSize="12.5"
                                                   Visibility="Collapsed" />
                                    </Grid>
                                    <Grid Height="38" Tag="datacenter" ToolTip="数据中心"
                                          Background="Transparent" MouseLeftButtonUp="NavRow_Click">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE9D9;" Width="42" TextAlignment="Center"
                                                   VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource TextMuted}" />
                                        <TextBlock x:Name="NavTextDataCenter" Grid.Column="1" Text="数据中心"
                                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource TextPrimary}" FontSize="12.5"
                                                   Visibility="Collapsed" />
                                    </Grid>
                                    <Grid Height="38" Tag="update" ToolTip="更新 BGI"
                                          Background="Transparent" MouseLeftButtonUp="NavRow_Click">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE896;" Width="42" TextAlignment="Center"
                                                   VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource TextMuted}" />
                                        <TextBlock x:Name="NavTextUpdate" Grid.Column="1" Text="更新 BGI"
                                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource TextPrimary}" FontSize="12.5"
                                                   Visibility="Collapsed" />
                                    </Grid>
                                    <Grid Height="38" Tag="routeupdate" ToolTip="路线更新"
                                          Background="Transparent" MouseLeftButtonUp="NavRow_Click">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE8B7;" Width="42" TextAlignment="Center"
                                                   VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource TextMuted}" />
                                        <TextBlock x:Name="NavTextRouteUpdate" Grid.Column="1" Text="路线更新"
                                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource TextPrimary}" FontSize="12.5"
                                                   Visibility="Collapsed" />
                                    </Grid>
                                    <Grid Height="38" Tag="remote" ToolTip="远程管理"
                                          Background="Transparent" MouseLeftButtonUp="NavRow_Click">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE968;" Width="42" TextAlignment="Center"
                                                   VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource TextMuted}"
                                                   Background="Transparent" MouseLeftButtonUp="NavRow_Click" />
                                        <TextBlock x:Name="NavTextRemote" Grid.Column="1" Text="远程管理"
                                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource TextPrimary}" FontSize="12.5"
                                                   Visibility="Collapsed" MouseLeftButtonUp="NavRow_Click" />
                                    </Grid>
                                    <Grid Height="38" Tag="sessions" ToolTip="联机大厅"
                                          Background="Transparent" MouseLeftButtonUp="NavRow_Click">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE772;" Width="42" TextAlignment="Center"
                                                   VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource TextMuted}" />
                                        <TextBlock x:Name="NavTextSessions" Grid.Column="1" Text="联机大厅"
                                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource TextPrimary}" FontSize="12.5"
                                                   Visibility="Collapsed" />
                                    </Grid>
                                    <Grid Height="38" Tag="procs" ToolTip="会话进程"
                                          Background="Transparent" MouseLeftButtonUp="NavRow_Click">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE9D9;" Width="42" TextAlignment="Center"
                                                   VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource TextMuted}" />
                                        <TextBlock x:Name="NavTextProcs" Grid.Column="1" Text="会话进程"
                                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource TextPrimary}" FontSize="12.5"
                                                   Visibility="Collapsed" />
                                    </Grid>
                                    <Grid Height="38" Tag="cli" ToolTip="命令行"
                                          Background="Transparent" MouseLeftButtonUp="NavRow_Click">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE756;" Width="42" TextAlignment="Center"
                                                   VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource TextMuted}" />
                                        <TextBlock x:Name="NavTextCli" Grid.Column="1" Text="命令行"
                                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource TextPrimary}" FontSize="12.5"
                                                   Visibility="Collapsed" />
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource StrokeSoft}" Margin="9,10,9,10" />
                                </StackPanel>

                                <!-- 下：悬停开关 + 当前会话 + 主题/设置（贴底） -->
                                <Grid Grid.Row="1" VerticalAlignment="Bottom">
                                    <!-- ★ 必须有 4 行：分隔线 / 悬停开关 / 当前会话 / 主题设置。
                                         少了第 4 行时 Row="3" 会回落到第 0 行，底部 UI 重叠（用户实测）。 -->
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- ★ 这两块原先在旧 Popup 面板里，重建侧栏时必须搬过来，
                                         否则展开后看不到「鼠标悬停展开」和「当前会话」（用户实测丢失）。 -->
                                    <Border x:Name="NavExpandedDivider" Grid.Row="0" Height="1" Background="{DynamicResource StrokeSoft}"
                                            Margin="6,6,6,8" Visibility="Collapsed" />

                                    <CheckBox Grid.Row="1" x:Name="AutoHideNavCheck" Style="{StaticResource GlassCheckBox}"
                                              Content="鼠标悬停展开" Margin="6,0,0,8"
                                              Visibility="Collapsed"
                                              Checked="AutoHideNav_Changed" Unchecked="AutoHideNav_Changed" />

                                    <Border x:Name="NavSessionPanel" Grid.Row="2" Style="{StaticResource GlassPanel}" Padding="10,8"
                                            Margin="4,0,4,6"
                                            Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="当前会话" Style="{StaticResource Caption}" />
                                            <TextBlock x:Name="SelfSessionText" Text="—" Style="{StaticResource Mono}"
                                                       Margin="0,3,0,0" />
                                            <TextBlock x:Name="SelfUserText" Text="—" Style="{StaticResource Caption}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Row="3">
                                        <Button x:Name="BtnThemeBottom" Style="{StaticResource WindowButton}" Width="42" Height="38"
                                                HorizontalAlignment="Left" Click="BtnTheme_Click" ToolTip="主题：跟随系统">
                                            <TextBlock x:Name="ThemeGlyphBottom" Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource TextMuted}" />
                                        </Button>
                                        <Button x:Name="BtnSettingsBottom" Style="{StaticResource WindowButton}" Width="42" Height="38"
                                                HorizontalAlignment="Left" Click="GeneralSettings_Click" ToolTip="应用设置">
                                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource TextMuted}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 展开时 NavRail 会移入 OwnedOverlayWindow（见 MainWindow.xaml.cs）。
                             它属于主窗口、非 Topmost、不抢焦点，可覆盖 RDP 的 HWND 空域；
                             收起时 NavRail 放回 NavHomeHost，页面宽度始终不变。 -->
                        <Grid x:Name="NavHomeHost" Grid.Column="0" HorizontalAlignment="Left"
                              Width="56" Height="0" IsHitTestVisible="False" />

                        <!-- 右侧页面容器 -->
                        <Grid Grid.Column="1">
                            <Grid x:Name="PageAutomation" Visibility="Collapsed">
                                <vm:AutomationPage x:Name="AutomationView" />
                            </Grid>
                            <Grid x:Name="PageLaunch" Visibility="Visible">
                                <vm:LaunchPage x:Name="LaunchView" />
                            </Grid>
                            <Grid x:Name="PageConsole" Visibility="Collapsed">
                                <vm:ConsolePage x:Name="ConsoleView" />
                            </Grid>
                            <Grid x:Name="PageDataCenter" Visibility="Collapsed">
                                <vm:DataCenterPage x:Name="DataCenterView" />
                            </Grid>
                            <Grid x:Name="PageUpdate" Visibility="Collapsed">
                                <vm:BgiUpdatePage x:Name="UpdateView" />
                            </Grid>
                            <Grid x:Name="PageRouteUpdate" Visibility="Collapsed">
                                <vm:RouteUpdatePage x:Name="RouteUpdateView" />
                            </Grid>
                            <Grid x:Name="PageRemote" Visibility="Collapsed">
                                <vm:RemoteAdminPage x:Name="RemoteView" />
                            </Grid>
                            <Grid x:Name="PageSessions" Visibility="Collapsed">
                                <vm:LobbyPage x:Name="LobbyView" />
                            </Grid>
                            <Grid x:Name="PageProcs" Visibility="Collapsed">
                                <vm:ProcessPage x:Name="ProcsView" />
                            </Grid>
                            <Grid x:Name="PageCli" Visibility="Collapsed">
                                <vm:CliPage x:Name="CliView" />
                            </Grid>
                            <Grid x:Name="PageSettings" Visibility="Collapsed">
                                <vm:SettingsPage x:Name="SettingsView" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- 拖拽缩放区 -->
                <Grid Margin="8" Background="Transparent" IsHitTestVisible="False" />
            </Grid>
        </Border>
    </Grid>
</Window>


