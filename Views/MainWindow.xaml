<Window x:Class="SoulLink.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SoulLink.Controls"
        xmlns:vm="clr-namespace:SoulLink.Views"
        Title="SoulLink · 跨会话执行器"
        Width="1240" Height="820" MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource WindowBackground}"
        ResizeMode="CanResizeWithGrip" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <Style x:Key="DesktopNavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Height" Value="43" />
            <Setter Property="Margin" Value="0,0,5,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" CornerRadius="0,7,7,0" Background="{TemplateBinding Background}">
                            <Grid>
                                <Border x:Name="Marker" Width="5" Visibility="Collapsed" HorizontalAlignment="Left"
                                        CornerRadius="0,3,3,0" Background="{DynamicResource DesktopAccent}" />
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="{DynamicResource HoverFill}" />
                            </Trigger>
                            <Trigger Property="Selector.IsSelected" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="{DynamicResource DesktopSelection}" />
                                <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Plate" Property="BorderBrush" Value="{DynamicResource DesktopAccent}" />
                                <Setter TargetName="Plate" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <!-- 外层容器。圆角由 DWM 负责，这里只铺底色，不再画边框（避免和内部玻璃层叠出两道框） -->
    <Grid x:Name="RootLayer" Margin="0">
        <Border x:Name="Shell" CornerRadius="0" Background="{DynamicResource WindowBackground}" BorderThickness="0">
            <Grid>
                <!-- ★ 不再画内层边框：它的 Margin 会形成一圈矩形，和 DWM 的弧形边不一致，
                     看起来就是「圆角窗口里套了个方框」。圆角完全交给 DWM。 -->

                <!-- ★ 顶部留 10px：DWM 圆角半径约 8px，内容顶到边缘会把角盖成方形 -->
                <!-- ChromeGrid / TitleRow：RDP 全屏时由 SetChromeFullscreen 收纳为零 -->
                <Grid x:Name="ChromeGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="TitleRow" Height="49" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ═══ 标题栏 ═══ -->
                    <Grid Grid.Row="0" Background="{DynamicResource DesktopChrome}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource StrokeSoft}" />
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="19,0,0,0"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid Width="28" Height="26">
                                <Ellipse Width="16" Height="16" Stroke="{DynamicResource DesktopAccent}" StrokeThickness="2.2"
                                         HorizontalAlignment="Left" />
                                <Ellipse Width="16" Height="16" Stroke="{DynamicResource DesktopAccent}" StrokeThickness="2.2"
                                         HorizontalAlignment="Right" />
                            </Grid>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="SoulLink" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                    <!-- ★ 挂机验证版标识：只有非默认身份才显示。
                                         没有它时两个窗口标题都是 SoulLink，分不清哪个在挂机
                                         （实测用户会点到错误的窗口操作）。 -->
                                    <Border x:Name="IdentityBadge" Visibility="Collapsed"
                                            CornerRadius="5" Padding="6,1" Margin="7,0,0,0"
                                            VerticalAlignment="Center"
                                            Background="Transparent" BorderBrush="{DynamicResource DesktopAccent}" BorderThickness="1">
                                        <TextBlock x:Name="IdentityBadgeText" Text="挂机版" FontSize="9.5"
                                                   Foreground="{DynamicResource DesktopAccent}" />
                                    </Border>
                                </StackPanel>
                                <!-- 版本号：点击检查更新；有新版时变琥珀色并显示红点 -->
                                <!-- ★ 用 Button 而不是 StackPanel+MouseLeftButtonUp：
                                     本窗口是自定义标题栏（WindowChrome），标题栏区域默认
                                     只用于拖动窗口，鼠标事件到不了普通 WPF 元素 ——
                                     即使加 WindowChrome.IsHitTestVisibleInChrome 也不可靠
                                     （它不向下传递给嵌套的子元素，实测点击仍无反应）。
                                     Button 自带命中测试并会阻止拖动，最稳。 -->
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="VersionButton" Click="VersionText_Click"
                                            Cursor="Hand" ToolTip="点击检查更新"
                                            WindowChrome.IsHitTestVisibleInChrome="True"
                                            Background="Transparent" BorderThickness="0" Padding="0"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            HorizontalContentAlignment="Left">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="UpdateDot" Width="6" Height="6" Margin="0,0,4,0"
                                                     VerticalAlignment="Center" Visibility="Collapsed"
                                                     Fill="{DynamicResource AmberBrush}" />
                                            <TextBlock x:Name="VersionText" FontSize="10.5"
                                                       Foreground="{DynamicResource TextMuted}" />
                                            <!-- ★ 3.2.3：光靠版本号变琥珀色 + 一个小圆点，用户看不出是什么意思
                                                 （实测反馈："有更新的时候应该是有文字告诉别人有新版本"）。
                                                 这里直接写出文字，并显示目标版本号。 -->
                                            <TextBlock x:Name="UpdateHintText" Margin="6,0,0,0" FontSize="10"
                                                       VerticalAlignment="Center" Visibility="Collapsed"
                                                       Foreground="{DynamicResource AmberBrush}"
                                                       Text="有新版本" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ReleaseNotesButton" Margin="6,0,0,0" Padding="4,1"
                                            Style="{StaticResource DesktopLink}" Click="ReleaseNotes_Click"
                                            WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center"
                                            Foreground="{DynamicResource DesktopAccent}" FontSize="10.5"
                                            Content="更新说明" ToolTip="查看本版及历史更新" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                            <Border Padding="11,4" Margin="0,0,5,0" Background="Transparent"
                                    x:Name="EngineBadge" MouseLeftButtonUp="EngineBadge_Click">
                                <StackPanel Orientation="Horizontal">
                                    <!-- ★ 2026-11-24 修「引擎就绪」造假：XAML 默认值改中性态（检测中…+灰点），
                                         真实状态由 EnsureEngineAsync/OnEngineStatus 渲染——启动间隙不再显示假就绪。
                                         ★ 2026-11-24 P0-2：Tooltip 统一由 RenderEngine 写三方版本
                                           「当前程序 X · 服务 Y · 注入代理 Z」（数据源 AgentSync.Inspect，
                                           不另造口径）；未检测前不显示任何版本，避免默认值骗人。 -->
                                    <ctl:GlowDot Width="9" Height="9" x:Name="EngineDot" VerticalAlignment="Center"
                                                 Color="#FF8B9CC8" />
                                    <!-- ★ 2026-11-24 P0-2：Tooltip 挂在 Border（EngineBadge）上，
                                         整个徽章可悬停；TextBlock 自身的 Tooltip 在 RenderEngine 里清空。 -->
                                    <TextBlock x:Name="EngineText" Text="检测中…" Margin="7,0,0,0" FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Button x:Name="BtnCollapseNav" Style="{StaticResource WindowButton}"
                                    Width="34" Margin="0,0,6,0" Click="BtnToggleNav_Click"
                                    ToolTip="收起 / 展开侧栏 · 右键设置悬停展开">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="AutoHideNavCheck" Header="鼠标悬停展开" IsCheckable="True"
                                                  Checked="AutoHideNav_Changed" Unchecked="AutoHideNav_Changed" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <TextBlock x:Name="HamburgerGlyph" Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                            </Button>
                            <Button x:Name="BtnMin" Style="{StaticResource WindowButton}" Click="BtnMin_Click" ToolTip="最小化">
                                <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                            </Button>
                            <Button x:Name="BtnMax" Style="{StaticResource WindowButton}" Click="BtnMax_Click" ToolTip="最大化">
                                <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                            </Button>
                            <Button x:Name="BtnClose" Style="{StaticResource WindowButton}" Click="BtnClose_Click" ToolTip="关闭">
                                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ═══ 主体 ═══ -->
                    <ctl:DesktopArtwork Grid.Row="1" x:Name="Backdrop" Region="Base" />
                    <Grid Grid.Row="1" x:Name="SideNavHost">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="NavColumn" Width="210" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Grid.ColumnSpan="2" x:Name="NavRail" Panel.ZIndex="99"
                                HorizontalAlignment="Left" Width="210" Background="{DynamicResource NavBackground}"
                                BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="0,0,1,0"
                                ClipToBounds="True" MouseEnter="NavRail_MouseEnter" MouseLeave="NavRail_MouseLeave">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="54" />
                                </Grid.RowDefinitions>
                                <ctl:DesktopArtwork Region="Sidebar" Height="300" VerticalAlignment="Bottom" />
                                <StackPanel x:Name="RailIcons" VerticalAlignment="Top" Margin="0,15,0,0">
                                <Button x:Name="NavOverview" Tag="overview" ToolTip="概览" Style="{StaticResource DesktopNavButton}"
                                        Click="RailIcon_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavTextOverview" Grid.Column="1" Text="概览"
                                                   VerticalAlignment="Center" FontSize="15" />
                                    </Grid>
                                </Button>
                                <Button x:Name="NavConsole" Tag="console" ToolTip="账号与会话" Style="{StaticResource DesktopNavButton}"
                                        Click="RailIcon_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavTextConsole" Grid.Column="1" Text="账号与会话"
                                                   VerticalAlignment="Center" FontSize="15" />
                                    </Grid>
                                </Button>
                                <Button x:Name="NavRemote" Tag="remote" ToolTip="远程控制" Style="{StaticResource DesktopNavButton}"
                                        Click="RailIcon_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavTextRemote" Grid.Column="1" Text="远程控制"
                                                   VerticalAlignment="Center" FontSize="15" />
                                    </Grid>
                                </Button>
                                <Button x:Name="NavDataCenter" Tag="datacenter" ToolTip="数据中心" Style="{StaticResource DesktopNavButton}"
                                        Click="RailIcon_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE1D3;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavTextDataCenter" Grid.Column="1" Text="数据中心"
                                                   VerticalAlignment="Center" FontSize="15" />
                                    </Grid>
                                </Button>
                                <Button x:Name="NavUpdate" Tag="update" ToolTip="更新" Style="{StaticResource DesktopNavButton}"
                                        Click="RailIcon_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavTextUpdate" Grid.Column="1" Text="更新"
                                                   VerticalAlignment="Center" FontSize="15" />
                                    </Grid>
                                </Button>
                                <Button x:Name="NavProcs" Tag="procs" ToolTip="会话瘦身" Style="{StaticResource DesktopNavButton}"
                                        Click="RailIcon_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xEA99;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavTextProcs" Grid.Column="1" Text="会话瘦身"
                                                   VerticalAlignment="Center" FontSize="15" />
                                    </Grid>
                                </Button>
                                <Button x:Name="NavSessions" Tag="sessions" ToolTip="联机大厅" Style="{StaticResource DesktopNavButton}"
                                        Click="RailIcon_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavTextSessions" Grid.Column="1" Text="联机大厅"
                                                   VerticalAlignment="Center" FontSize="15" />
                                    </Grid>
                                </Button>
                                <Button x:Name="NavCli" Tag="cli" ToolTip="命令行" Style="{StaticResource DesktopNavButton}"
                                        Click="RailIcon_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavTextCli" Grid.Column="1" Text="命令行"
                                                   VerticalAlignment="Center" FontSize="15" />
                                    </Grid>
                                </Button>
                                </StackPanel>
                                <Border Grid.Row="1" BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="0,1,0,0" />
                                <Button x:Name="NavSettings" Tag="settings" ToolTip="设置" Style="{StaticResource DesktopNavButton}"
                                        Click="RailIcon_Click" Grid.Row="1" Margin="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavTextSettings" Grid.Column="1" Text="设置"
                                                   VerticalAlignment="Center" FontSize="15" />
                                    </Grid>
                                </Button>
                                <TextBlock x:Name="SelfSessionText" Visibility="Collapsed" />
                                <TextBlock x:Name="SelfUserText" Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <!-- 展开时 NavRail 会移入 OwnedOverlayWindow（见 MainWindow.xaml.cs）。
                             它属于主窗口、非 Topmost、不抢焦点，可覆盖 RDP 的 HWND 空域；
                             收起时 NavRail 放回 NavHomeHost，页面宽度始终不变。 -->
                        <Grid x:Name="NavHomeHost" Grid.Column="0" HorizontalAlignment="Left"
                              Width="56" Height="0" IsHitTestVisible="False" />

                        <!-- 右侧页面容器 -->
                        <Grid Grid.Column="1" x:Name="PageHost" Margin="20,0,20,15">
                            <Grid x:Name="PageOverview">
                                <vm:OverviewPage x:Name="OverviewView" />
                            </Grid>
                            <Grid x:Name="PageAutomation" Visibility="Collapsed">
                                <vm:AutomationPage x:Name="AutomationView" />
                            </Grid>
                            <Grid x:Name="PageLaunch" Visibility="Collapsed">
                                <vm:LaunchPage x:Name="LaunchView" />
                            </Grid>
                            <Grid x:Name="PageConsole" Visibility="Collapsed">
                                <vm:ConsolePage x:Name="ConsoleView" />
                            </Grid>
                            <Grid x:Name="PageDataCenter" Visibility="Collapsed">
                                <vm:DataCenterPage x:Name="DataCenterView" />
                            </Grid>
                            <Grid x:Name="UpdateSection" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,8">
                                    <Button x:Name="UpdateBgiTab" Content="BetterGI 更新" Tag="update" Style="{StaticResource GhostButton}" Click="UpdateTab_Click" />
                                    <Button x:Name="UpdateRouteTab" Content="路线更新" Tag="routeupdate" Margin="7,0,0,0" Style="{StaticResource GhostButton}" Click="UpdateTab_Click" />
                                </StackPanel>
                                <Grid x:Name="PageUpdate" Grid.Row="1" Visibility="Collapsed">
                                    <vm:BgiUpdatePage x:Name="UpdateView" />
                                </Grid>
                                <Grid x:Name="PageRouteUpdate" Grid.Row="1" Visibility="Collapsed">
                                    <vm:RouteUpdatePage x:Name="RouteUpdateView" />
                                </Grid>
                            </Grid>
                            <Grid x:Name="PageRemote" Visibility="Collapsed">
                                <vm:RemoteAdminPage x:Name="RemoteView" />
                            </Grid>
                            <Grid x:Name="PageSessions" Visibility="Collapsed">
                                <vm:LobbyPage x:Name="LobbyView" />
                            </Grid>
                            <Grid x:Name="PageProcs" Visibility="Collapsed">
                                <vm:ProcessPage x:Name="ProcsView" />
                            </Grid>
                            <Grid x:Name="PageCli" Visibility="Collapsed">
                                <vm:CliPage x:Name="CliView" />
                            </Grid>
                            <Grid x:Name="PageSettings" Visibility="Collapsed">
                                <vm:SettingsPage x:Name="SettingsView" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- 拖拽缩放区 -->
                <Grid Margin="8" Background="Transparent" IsHitTestVisible="False" />
            </Grid>
        </Border>
    </Grid>
</Window>


