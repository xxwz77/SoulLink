<Window x:Class="SoulLink.Views.ReadmeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SoulLink.Controls"
        Title="使用说明" Width="720" Height="640" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource WindowBackground}" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}">

    <Grid Margin="0">

        <Border CornerRadius="20" BorderBrush="{DynamicResource StrokeMid}" BorderThickness="1" ClipToBounds="True">
                        <Border.Background><SolidColorBrush Color="{Binding Color, Source={StaticResource DialogSurface}}" /></Border.Background>

            <Grid Margin="24,18,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="DragArea" Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                    <StackPanel>
                        <TextBlock Text="使用说明" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="三分钟上手：从你原来的 bat 到一条命令"
                                   FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource WindowButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Height="28" Click="Close_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource GlassPanel}" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="它做了什么" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource CyanBrush}" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20"
                                           Text="你把原来的 bat 换成界面后，程序会自动完成这些事：① 用 query user 找出目标账号当前的会话 ID（不需要手填）；② 通过 Windows 计划任务的 SYSTEM 身份把指定程序投放到那个用户的桌面上运行；③ 关闭时不弹任何窗，直接结束目标会话里的进程。"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="第一次使用" Style="{StaticResource Label}" Margin="2,18,0,8" />
                        <StackPanel Margin="2,0,0,0">
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="21"
                                       Text="1. 用管理员身份运行 SoulLink.exe（跨会话投送需要管理员令牌）。"/>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="21" Margin="0,4,0,0"
                                       Text="2. 点「新建」，填用户名 + 密码 + 程序路径，选「打开」或「关闭」，保存。"/>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="21" Margin="0,4,0,0"
                                       Text="3. 选中动作点「执行选中动作」，或者直接复制下方那行命令。"/>
                        </StackPanel>

                        <TextBlock Text="从命令行执行" Style="{StaticResource Label}" Margin="2,18,0,8" />
                        <Border Style="{StaticResource GlassPanel}" Padding="14,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Mono}" TextWrapping="Wrap" Margin="0,0,0,7"
                                           Text="SoulLink.exe open  --action &quot;A2 打开 BetterGI&quot; --quiet" />
                                <TextBlock Style="{StaticResource Mono}" TextWrapping="Wrap" Margin="0,0,0,7"
                                           Text="SoulLink.exe close --user A2 --exe &quot;D:\AAA挂机专区\A2\BetterGI\BetterGI.exe&quot;" />
                                <TextBlock Style="{StaticResource Mono}" TextWrapping="Wrap"
                                           Text="SoulLink.exe restart --action &quot;A2 打开 BetterGI&quot;" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,8,0,0" LineHeight="20"
                                   Text="命令是“无感”的：如果 SoulLink 已经在托盘常驻，新调用会把命令转交给它，本身立刻退出，不弹任何窗口；如果没在运行，它会静默执行完再退出。"/>

                        <TextBlock Text="关于投送方式" Style="{StaticResource Label}" Margin="2,18,0,8" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="20"
                                   Text="程序通过 Windows 计划任务以 SYSTEM 身份投送进程：一次性任务用完即删，不安装服务、不重启、不需要任何外部工具。密码也不会出现在任何命令行里。" />

                        <TextBlock Text="安全" Style="{StaticResource Label}" Margin="2,18,0,8" />
                        <StackPanel Margin="2,0,0,0">
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="20"
                                       Text="· 密码用 Windows DPAPI 加密后保存，只有当前 Windows 账号能解密。"/>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="20" Margin="0,4,0,0"
                                       Text="· 密码用 DPAPI 加密保存，全程不出现在进程命令行里（比原来的 bat 安全得多）。"/>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="20" Margin="0,4,0,0"
                                       Text="· 配置文件在 %LOCALAPPDATA%\SoulLink\config.json，可随时导出备份或手动删除。"/>
                        </StackPanel>

                        <TextBlock Text="常见问题" Style="{StaticResource Label}" Margin="2,18,0,8" />
                        <StackPanel Margin="2,0,0,0">
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="20"
                                       Text="Q：提示“找不到会话”？  A：目标账号还没登录，或者已被注销；先让它登录，再点「刷新」。"/>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="20" Margin="0,4,0,0"
                                       Text="Q：提示“访问被拒绝”？  A：确认 SoulLink 是“以管理员身份运行”的。"/>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="20" Margin="0,4,0,0"
                                       Text="Q：登录失败 1326？  A：用户名或密码不对；点「改密码」重新输入。"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Padding="26,10" Click="Close_Click">
                        <TextBlock Text="知道了" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
