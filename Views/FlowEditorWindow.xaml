<Window x:Class="SoulLink.Views.FlowEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SoulLink.Controls"
        Title="SoulLink · 自动化流程" Width="1180" Height="820"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" FontFamily="{StaticResource UiFont}"
        ResizeMode="CanResize"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">

    <Grid>
        <!-- ★ 去掉了窗口外围的黑色投影（用户要求）。
             原来有 Margin=14 + DropShadowEffect，在窗口四周形成一圈黑边。 -->

        <!-- ★ 必须给一个不透明背景：AllowsTransparency=True 时，
             若这里透明，会看到下层窗口（含 RDP 原生控件），
             看起来像"边框没做好"。 -->
        <Border CornerRadius="18" BorderBrush="#55FFFFFF" BorderThickness="1"
                ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF0A1020" Offset="0" />
                    <GradientStop Color="#FF14112B" Offset="0.55" />
                    <GradientStop Color="#FF0B0F22" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <!-- ★ 不用 AuroraBackdrop：它是每帧重绘的粒子动画，
                     在独立窗口里会持续抢占 UI 线程 + 抓鼠标事件，
                     导致编辑器的输入框点不进、打字无反应（用户实测）。
                     这里改成静态渐变，视觉一致且零开销。 -->
                <Grid.Background>
                    <RadialGradientBrush Center="0.25,0.1" GradientOrigin="0.25,0.1"
                                         RadiusX="0.9" RadiusY="1.1">
                        <GradientStop Color="#332F5CFF" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Grid.Background>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ══════════ 标题栏 ══════════ -->
                    <Grid Grid.Row="0" x:Name="TitleRow" Background="Transparent"
                          MouseLeftButtonDown="TitleRow_MouseLeftButtonDown" Margin="24,18,24,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderText" Text="自动化流程" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock x:Name="SubHeader" Text="" FontSize="11.5"
                                       Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- 流程名 + 启用/暂停 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="20,0,12,0">
                            <TextBlock Text="流程名" FontSize="11" Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="NameBox" Width="220" Height="36"
                                     Style="{StaticResource GlassTextBox}"
                                     TextChanged="NameBox_TextChanged" />
                            <CheckBox x:Name="EnabledCheck" Content="启用" IsChecked="True"
                                      Style="{StaticResource GlassCheckBox}"
                                      VerticalAlignment="Center" Margin="14,0,0,0"
                                      Checked="EnabledCheck_Changed" Unchecked="EnabledCheck_Changed" />
                            <CheckBox x:Name="PersistCheck" Content="记住条件" IsChecked="True"
                                      Style="{StaticResource GlassCheckBox}"
                                      VerticalAlignment="Center" Margin="12,0,0,0"
                                      ToolTip="勾选：条件满足后写进配置，程序重启也不会丢&#x0a;取消：条件只在内存里，重启后重新判断"
                                      Checked="PersistCheck_Changed" Unchecked="PersistCheck_Changed" />
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource WindowButton}" Height="30"
                                VerticalAlignment="Center" Click="Close_Click">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                        </Button>
                    </Grid>

                    <!-- ══════════ 主体：左模块库 | 中画布 | 右属性 ══════════ -->
                    <Grid Grid.Row="1" Margin="24,0,24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="290" />
                        </Grid.ColumnDefinitions>

                        <!-- 左：模块库（类别卡片） -->
                        <Border Grid.Column="0" Style="{StaticResource GlassPanel}" Padding="12,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="60" />
                                </Grid.RowDefinitions>

                                <!-- 模块库 -->
                                <Grid Grid.Row="0" Margin="2,0,0,8">
                                    <TextBlock Text="模块库" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="悬停展开 · 拖到画布" FontSize="9"
                                               Foreground="{StaticResource TextMuted}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Grid.Row="1" x:Name="LibPanel" />

                                <Border Grid.Row="2" Height="1" Background="#22FFFFFF" Margin="0,10,0,8" />

                                <!-- 使用说明 -->
                                <TextBlock Grid.Row="3" Text="使用说明" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource CyanBrush}" Margin="2,0,0,6" />

                                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="HelpPanel" />
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- 中：画布 -->
                        <Border Grid.Column="2" CornerRadius="14" Background="#1A0A1226"
                                BorderBrush="#24FFFFFF" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <!-- 网格背景 -->
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <DrawingBrush TileMode="Tile" Viewport="0,0,24,24"
                                                      ViewportUnits="Absolute">
                                            <DrawingBrush.Drawing>
                                                <GeometryDrawing>
                                                    <GeometryDrawing.Geometry>
                                                        <GeometryGroup>
                                                            <LineGeometry StartPoint="0,0" EndPoint="0,24" />
                                                            <LineGeometry StartPoint="0,0" EndPoint="24,0" />
                                                        </GeometryGroup>
                                                    </GeometryDrawing.Geometry>
                                                    <GeometryDrawing.Pen>
                                                        <Pen Brush="#12FFFFFF" Thickness="1" />
                                                    </GeometryDrawing.Pen>
                                                </GeometryDrawing>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto">
                                    <ctl:FlowCanvas x:Name="Canvas" />
                                </ScrollViewer>

                                <!-- 空状态提示 -->
                                <StackPanel x:Name="EmptyHint" VerticalAlignment="Center"
                                            HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                                               HorizontalAlignment="Center" Foreground="#33C8E0FF" />
                                    <TextBlock Text="从左侧点一个【触发器】开始" FontSize="13"
                                               Foreground="{StaticResource TextMuted}"
                                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                                    <TextBlock Text="再点条件/执行器，然后从节点右侧圆点拖线连接" FontSize="11"
                                               Foreground="{StaticResource TextMuted}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 右：顶部=节点属性（主区域），底部=操作提示 -->
                        <Border Grid.Column="4" Style="{StaticResource GlassPanel}" Padding="14,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="180" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 节点属性标题 -->
                                <TextBlock Grid.Row="0" Text="节点属性" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource CyanBrush}" Margin="2,0,0,8" />

                                <!-- 属性内容：占满剩余高度，可滚动 -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="PropPanel">
                                        <TextBlock Text="点击画布上的节点来编辑它的参数"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMuted}" />
                                    </StackPanel>
                                </ScrollViewer>

                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ★ 模块菜单覆盖层：不用 Popup（会跑到其他应用上面），
                         放在窗口内部用 Canvas 绝对定位，只在本窗口内显示 -->
                    <Canvas x:Name="MenuLayer" Grid.Row="0" Grid.RowSpan="3"
                            Background="Transparent" Visibility="Collapsed"
                            Panel.ZIndex="100"
                            MouseDown="MenuLayer_MouseDown">
                        <Border x:Name="KindMenuCard" Canvas.Left="0" Canvas.Top="0"
                                CornerRadius="12" Padding="6"
                                Background="#FF101830" BorderBrush="#66FFFFFF" BorderThickness="1"
                                MinWidth="264" MaxWidth="540"
                                MouseEnter="KindMenuCard_MouseEnter"
                                MouseLeave="KindMenuCard_MouseLeave">
                            <ScrollViewer x:Name="KindMenuScroll" MaxHeight="560"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <WrapPanel x:Name="KindMenu" Orientation="Vertical" ItemWidth="252" />
                            </ScrollViewer>
                        </Border>
                    </Canvas>

                    <!-- ══════════ 底栏 ══════════ -->
                    <Grid Grid.Row="2" Margin="24,12,24,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 条件聚合方式 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                    x:Name="CondModeRow" Visibility="Collapsed">
                            <TextBlock Text="多个条件：" FontSize="11" Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="CondModeCombo" Width="150" Height="34"
                                      SelectionChanged="CondMode_Changed">
                                <ComboBoxItem Content="全部满足（AND）" Tag="All" IsSelected="True" />
                                <ComboBoxItem Content="任一满足（OR）" Tag="Any" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock x:Name="ValidateHint" Text="" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,14,0"
                                       Visibility="Collapsed" TextTrimming="CharacterEllipsis"
                                       MaxWidth="240" />
                            <Button Style="{StaticResource GhostButton}" Padding="16,9" Click="DeleteFlow_Click">
                                <TextBlock Text="删除流程" FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Padding="16,9" Margin="10,0,0,0"
                                    Click="RunNow_Click">
                                <TextBlock Text="立即运行" FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource PrimaryButton}" Padding="24,9" Margin="10,0,0,0"
                                    Click="Save_Click">
                                <TextBlock Text="保存" FontSize="12.5" FontWeight="SemiBold" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
