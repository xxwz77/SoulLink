<Window x:Class="SoulLink.Views.FlowEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SoulLink.Controls"
        Title="SoulLink · 自动化流程" Width="1180" Height="820" MinWidth="1080" MinHeight="740"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" FontFamily="{StaticResource UiFont}"
        ResizeMode="CanResize"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">

    <Grid>
        <!-- ★ 去掉了窗口外围的黑色投影（用户要求）。
             原来有 Margin=14 + DropShadowEffect，在窗口四周形成一圈黑边。 -->

        <!-- ★ 必须给一个不透明背景：AllowsTransparency=True 时，
             若这里透明，会看到下层窗口（含 RDP 原生控件），
             看起来像"边框没做好"。 -->
        <Border CornerRadius="18" BorderBrush="{DynamicResource StrokeMid}" BorderThickness="1"
                ClipToBounds="True" Background="{DynamicResource DialogSurface}">

            <Grid Background="{DynamicResource DialogUnderlay}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ══════════ 标题栏 ══════════ -->
                    <Grid Grid.Row="0" x:Name="TitleRow" Background="Transparent"
                          MouseLeftButtonDown="TitleRow_MouseLeftButtonDown" Margin="24,18,24,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderText" Text="自动化流程" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock x:Name="DailyStateText" FontSize="11" MaxWidth="258" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="14,0,12,0">
                            <TextBlock Text="所属会话" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="OwnerPicker" Width="158" Height="34" AutomationProperties.Name="所属会话"
                                      SelectionChanged="OwnerPicker_SelectionChanged" ToolTip="模块默认使用此会话，可以在模块属性中单独指定。" />
                            <TextBlock Text="流程名" Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center" Margin="16,0,8,0" />
                            <TextBox x:Name="NameBox" Width="170" MinHeight="32"
                                     Style="{StaticResource InlineTextBox}" VerticalContentAlignment="Center"
                                     TextChanged="NameBox_TextChanged" />
                            <CheckBox x:Name="EnabledCheck" Content="启用" IsChecked="True"
                                      Style="{StaticResource GlassCheckBox}" VerticalAlignment="Center" Margin="14,0,0,0"
                                      Checked="EnabledCheck_Changed" Unchecked="EnabledCheck_Changed" />
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource WindowButton}" Height="30"
                                VerticalAlignment="Center" Click="Close_Click">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                        </Button>
                    </Grid>

                    <!-- ══════════ 主体：左模块库 | 中画布 | 右属性 ══════════ -->
                    <Grid Grid.Row="1" Margin="24,0,24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="290" />
                        </Grid.ColumnDefinitions>

                        <!-- 左：模块库（类别卡片） -->
                        <Border Grid.Column="0" Style="{StaticResource GlassPanel}" Padding="12,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="60" />
                                </Grid.RowDefinitions>

                                <!-- 模块库 -->
                                <Grid Grid.Row="0" Margin="2,0,0,8">
                                    <TextBlock Text="模块库" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource CyanBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="悬停展开 · 拖到画布" FontSize="9"
                                               Foreground="{DynamicResource TextMuted}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Grid.Row="1" x:Name="LibPanel" />

                                <Border Grid.Row="2" Height="1" Background="{DynamicResource SubtleSurface}" Margin="0,10,0,8" />

                                <!-- 使用说明 -->
                                <TextBlock Grid.Row="3" Text="使用说明" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource CyanBrush}" Margin="2,0,0,6" />

                                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="HelpPanel" />
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- 中：画布 -->
                        <Border Grid.Column="2" CornerRadius="14" Background="{DynamicResource FieldBackground}"
                                BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <!-- 网格背景 -->
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <DrawingBrush TileMode="Tile" Viewport="0,0,24,24"
                                                      ViewportUnits="Absolute">
                                            <DrawingBrush.Drawing>
                                                <GeometryDrawing>
                                                    <GeometryDrawing.Geometry>
                                                        <GeometryGroup>
                                                            <LineGeometry StartPoint="0,0" EndPoint="0,24" />
                                                            <LineGeometry StartPoint="0,0" EndPoint="24,0" />
                                                        </GeometryGroup>
                                                    </GeometryDrawing.Geometry>
                                                    <GeometryDrawing.Pen>
                                                        <Pen Brush="{DynamicResource StrokeSoft}" Thickness="1" />
                                                    </GeometryDrawing.Pen>
                                                </GeometryDrawing>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto">
                                    <ctl:FlowCanvas x:Name="Canvas" />
                                </ScrollViewer>

                                <!-- 画笔状态单独一行，绝不覆盖底部“能否运行”的校验提示 -->
                                <Border x:Name="PaintBar" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                        Margin="12" Padding="10,7" CornerRadius="8" Visibility="Collapsed"
                                        Background="{DynamicResource PopupBackground}" BorderBrush="{DynamicResource StrokeMid}" BorderThickness="1"
                                        Panel.ZIndex="4" IsHitTestVisible="False">
                                    <TextBlock x:Name="PaintBarText" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimary}" />
                                </Border>

                                <!-- 明确的模式开关：与画布依赖属性双向绑定，Esc 也会同步关闭。 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="12" Panel.ZIndex="3">
                                    <ToggleButton x:Name="PaintModeToggle"
                                                  IsChecked="{Binding PaintMode, ElementName=Canvas, Mode=TwoWay}"
                                                  Padding="14,9" Focusable="False">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton" BasedOn="{StaticResource ChipToggle}">
                                                <Setter Property="Content" Value="画笔模式：已关闭" />
                                                <Setter Property="ToolTip" Value="开启后，从模块下方出口按住左键拖到目标；成功后自动以目标继续。空白处松开结束本次串联，Esc 关闭画笔。" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Content" Value="画笔模式：已开启" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <Border Margin="8,0,0,0" Padding="10,8" CornerRadius="8"
                                            Background="{DynamicResource PopupBackground}" BorderBrush="{DynamicResource StrokeMid}" BorderThickness="1"
                                            VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock Text="依次点击起点和目标 · 也可拖拽 · Esc 退出" FontSize="10.5"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, ElementName=PaintModeToggle}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </StackPanel>

                                <!-- 空状态提示 -->
                                <StackPanel x:Name="EmptyHint" VerticalAlignment="Center"
                                            HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="从左侧添加一个【条件】开始" FontSize="13"
                                               Foreground="{DynamicResource TextMuted}"
                                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                                    <TextBlock Text="再添加条件或动作，从下方出口连接到下一模块" FontSize="11"
                                               Foreground="{DynamicResource TextMuted}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 右：节点属性 -->
                        <Border Grid.Column="4" Style="{StaticResource GlassPanel}" Padding="14,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- 节点属性标题 -->
                                <TextBlock Grid.Row="0" Text="节点属性" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,9" />

                                <!-- 属性内容：占满剩余高度，可滚动 -->
                                <ScrollViewer x:Name="PropScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="PropPanel" Margin="0,0,4,4">
                                        <TextBlock Text="选中画布中的节点以编辑属性。"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </ScrollViewer>

                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 引导层唯一宿主；透明，不再给高亮洞叠加第二次遮罩。 -->
                    <Canvas x:Name="GuideLayer" Grid.Row="0" Grid.RowSpan="3"
                            Background="Transparent" Visibility="Collapsed"
                            Panel.ZIndex="200" />

                    <!-- 窗内菜单。画布空白保留底下控件的鼠标命中。 -->
                    <Canvas x:Name="MenuLayer" Grid.Row="0" Grid.RowSpan="3"
                            Visibility="Collapsed" Panel.ZIndex="100">
                        <Border x:Name="KindMenuCard" Canvas.Left="0" Canvas.Top="0"
                                CornerRadius="12" Padding="6"
                                Background="{DynamicResource PopupBackground}" BorderBrush="{DynamicResource StrokeMid}" BorderThickness="1"
                                MouseEnter="KindMenuCard_MouseEnter"
                                MouseLeave="KindMenuCard_MouseLeave">
                            <ScrollViewer x:Name="KindMenuScroll" Focusable="False"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <Grid x:Name="KindMenu" HorizontalAlignment="Left" KeyboardNavigation.TabNavigation="Cycle">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="0" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel x:Name="KindMenuLeft" />
                                    <StackPanel x:Name="KindMenuRight" Grid.Column="2" Visibility="Collapsed" />
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </Canvas>

                    <Grid Grid.Row="2" Margin="24,12,24,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="ValidateHint" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                MaxWidth="590" Padding="0" Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource TextMuted}" Cursor="Arrow" ToolTip="点击可定位到相关模块" Click="ValidateHint_Click">
                            <TextBlock TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Text="" />
                        </Button>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Padding="16,9" Click="DeleteFlow_Click"><TextBlock Text="删除流程" FontSize="12" /></Button>
                            <Button Style="{StaticResource GhostButton}" Padding="16,9" Margin="10,0,0,0" Click="RunNow_Click"><TextBlock Text="立即运行" FontSize="12" /></Button>
                            <Button Style="{StaticResource PrimaryButton}" Padding="24,9" Margin="10,0,0,0" Click="Save_Click"><TextBlock Text="保存" FontSize="12.5" FontWeight="SemiBold" /></Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
