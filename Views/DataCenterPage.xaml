<UserControl x:Class="SoulLink.Views.DataCenterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题条 -->
        <Grid Grid.Row="0" Margin="2,0,2,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="数据中心" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                <TextBlock x:Name="SubTitle" Text="" FontSize="10.5" Margin="10,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Label Content="摩拉自动拉取间隔" Target="{Binding ElementName=MoraIntervalBox}"
                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="11" />
                <ComboBox x:Name="MoraIntervalBox" Width="78" Margin="2,0,8,0" VerticalAlignment="Center"
                          SelectionChanged="MoraInterval_Changed">
                    <ComboBoxItem Content="1 小时" />
                    <ComboBoxItem Content="2 小时" />
                    <ComboBoxItem Content="3 小时" />
                    <ComboBoxItem Content="4 小时" />
                    <ComboBoxItem Content="5 小时" />
                    <ComboBoxItem Content="6 小时" />
                </ComboBox>
                <Button x:Name="BtnRefresh" Style="{StaticResource GhostButton}" Padding="10,5"
                        Click="BtnRefresh_Click" ToolTip="立即刷新一次">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="刷新" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border x:Name="AccountScopeBar" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,8"
                Padding="10,4" CornerRadius="8" Background="{DynamicResource DesktopPanel}"
                BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="全部账号" Style="{StaticResource DesktopLink}"
                        Click="ShowAllAccounts_Click" />
                <Button DockPanel.Dock="Right" Content="返回概览" Style="{StaticResource DesktopLink}"
                        Click="ReturnToOverview_Click" />
                <TextBlock x:Name="AccountScopeText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" />
            </DockPanel>
        </Border>

        <!-- 账号卡片列表 -->
        <ScrollViewer x:Name="AccountCardsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="CardList" Margin="0,0,4,0" />
        </ScrollViewer>

        <!-- 底部说明 -->
        <Border Grid.Row="3" Margin="0,10,0,0" CornerRadius="10" Background="{DynamicResource DesktopPanel}"
                BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="1" Padding="12,8">
            <TextBlock x:Name="FootNote" FontSize="10.5" TextWrapping="Wrap" LineHeight="17"
                       Foreground="{DynamicResource TextSecondary}" />
        </Border>
    </Grid>
</UserControl>
