<Window x:Class="SoulLink.Views.JoinRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SoulLink" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="{StaticResource UiFont}">

    <Border CornerRadius="16" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF0A1020" Offset="0" />
                <GradientStop Color="#FF14112B" Offset="0.6" />
                <GradientStop Color="#FF0B0F22" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <StackPanel Margin="22,20,22,18">
            <TextBlock Text="加入房间" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" />
            <TextBlock Text="输入房间码，并指定用哪个用户上线。"
                       FontSize="11" Foreground="{StaticResource TextMuted}"
                       Margin="0,6,0,16" TextWrapping="Wrap" />

            <!-- 进哪个房间（大小号房才显示） -->
            <StackPanel x:Name="RoomPickerPanel" Visibility="Collapsed" Margin="0,0,0,12">
                <TextBlock Text="进哪个房间" FontSize="10.5"
                           Foreground="{StaticResource TextMuted}" />
                <ComboBox x:Name="RoomCombo" Height="38" Margin="0,5,0,0"
                          Padding="11,0,6,0" FontSize="13"
                          Foreground="{StaticResource TextPrimary}"
                          Background="#30FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" />
            </StackPanel>

            <!-- 房间码 -->
            <TextBlock Text="房间码" FontSize="10.5" Foreground="{StaticResource TextMuted}" />
            <TextBox x:Name="CodeBox" Height="38" Margin="0,5,0,0"
                     Style="{StaticResource GlassTextBox}"
                     Padding="11,0,11,0" FontSize="13"
                     VerticalContentAlignment="Center" />

            <!-- 用哪个用户 -->
            <TextBlock Text="用哪个用户上线" FontSize="10.5"
                       Foreground="{StaticResource TextMuted}" Margin="0,14,0,0" />
            <ComboBox x:Name="UserCombo" Height="38" Margin="0,5,0,0"
                      Padding="11,0,6,0" FontSize="13"
                      Foreground="{StaticResource TextPrimary}"
                      Background="#30FFFFFF" BorderBrush="#30FFFFFF"
                      BorderThickness="1"
                      VerticalContentAlignment="Center" />
            <TextBlock Text="选择要上线的本机账号。发车时按这个身份确认。"
                       FontSize="9.5" Foreground="{StaticResource TextMuted}"
                       TextWrapping="Wrap" Margin="0,4,0,0" />

            <!-- 小号房才需要的角色名 -->
            <StackPanel x:Name="RolePanel" Visibility="Collapsed">
                <TextBlock Text="角色名（小号房需要）" FontSize="10.5"
                           Foreground="{StaticResource TextMuted}" Margin="0,14,0,0" />
                <TextBox x:Name="RoleBox" Height="38" Margin="0,5,0,0"
                         Style="{StaticResource GlassTextBox}"
                         Padding="11,0,11,0" FontSize="13"
                         VerticalContentAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Text="" FontSize="10.5"
                       Foreground="#FFFF9B9B" TextWrapping="Wrap"
                       Margin="0,10,0,0" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Style="{StaticResource GhostButton}" Padding="18,8" Click="Cancel_Click">
                    <TextBlock Text="取消" FontSize="12" />
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Padding="22,8" Margin="10,0,0,0"
                        Click="Ok_Click">
                    <TextBlock Text="加入" FontSize="12.5" FontWeight="SemiBold" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
