<Window x:Class="SoulLink.Views.ThemedMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SoulLink.Controls"
        Title="SoulLink" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource DialogSurface}"
        ShowInTaskbar="False" FontFamily="{StaticResource UiFont}"
        ResizeMode="NoResize">

    <Border CornerRadius="14" BorderBrush="{DynamicResource StrokeMid}" BorderThickness="1" Margin="0">
                <Border.Background><SolidColorBrush Color="{Binding Color, Source={StaticResource DialogSurface}}" /></Border.Background>

        <Grid ClipToBounds="True">
            <ctl:AuroraBackdrop Opacity="0.48" />
        <StackPanel Margin="22,18,22,16">
            <!-- 标题行：图标 + 标题 -->
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="IconText" Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                           FontSize="16" VerticalAlignment="Center"
                           Foreground="{StaticResource CyanBrush}" />
                <TextBlock x:Name="TitleText" Text="提示" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <!-- 正文（可滚动，长内容不撑爆窗口） -->
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,0">
                <TextBlock x:Name="BodyText" Text="" FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap" LineHeight="21" />
            </ScrollViewer>

            <!-- 按钮 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="BtnCancel" Style="{StaticResource GhostButton}"
                        Padding="20,8" Margin="0,0,10,0" Click="Cancel_Click"
                        Visibility="Collapsed">
                    <TextBlock Text="取消" FontSize="12" />
                </Button>
                <Button x:Name="BtnOk" Style="{StaticResource PrimaryButton}"
                        Padding="24,8" Click="Ok_Click">
                    <TextBlock Text="确定" FontSize="12.5" FontWeight="SemiBold" />
                </Button>
            </StackPanel>
        </StackPanel>
        </Grid>
    </Border>
</Window>
