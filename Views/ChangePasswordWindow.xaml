<Window x:Class="SoulLink.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改密码" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource UiFont}">
    <Border CornerRadius="16" Background="{StaticResource WindowBackground}" BorderBrush="#28FFFFFF" BorderThickness="1" Padding="20">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
            <TextBlock Text="修改 Windows 账户密码，并同步更新 SoulLink 中该账号的连接密码。" FontSize="10.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,12" />
            <PasswordBox x:Name="PwdBox" Style="{StaticResource GlassPasswordBox}" Height="32" VerticalContentAlignment="Center" PasswordChanged="Input_Changed" />
            <TextBlock Text="新密码（至少 6 位，不含用户名）" FontSize="9.5" Foreground="{StaticResource TextMuted}" Margin="1,3,0,8" />
            <PasswordBox x:Name="Pwd2Box" Style="{StaticResource GlassPasswordBox}" Height="32" VerticalContentAlignment="Center" PasswordChanged="Input_Changed" />
            <TextBlock Text="再次输入新密码" FontSize="9.5" Foreground="{StaticResource TextMuted}" Margin="1,3,0,6" />
            <CheckBox x:Name="NeverExpireCheck" Content="密码永不过期" Style="{StaticResource GlassCheckBox}" Margin="0,4,0,6" />
            <TextBlock x:Name="ErrorText" Foreground="#FFFFB4B4" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource GhostButton}" Padding="16,7" Click="Cancel_Click" />
                <Button x:Name="ConfirmButton" Content="修改密码" Style="{StaticResource PrimaryButton}" Padding="16,7" Margin="8,0,0,0" Click="Confirm_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>