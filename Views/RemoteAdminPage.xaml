<UserControl x:Class="SoulLink.Views.RemoteAdminPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 标题 -->
            <RowDefinition Height="2.1*" />   <!-- 用户 -->
            <RowDefinition Height="Auto" />   <!-- RDP Wrapper -->
            <RowDefinition Height="1*" />     <!-- 日志 -->
        </Grid.RowDefinitions>

        <!-- ═══ 标题条 ═══ -->
        <Grid Grid.Row="0" Margin="2,0,2,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="远程管理" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                <TextBlock x:Name="SubTitle" Text="" FontSize="10.5" Margin="10,0,0,0"
                           VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnNewUser" Style="{StaticResource PrimaryButton}" Padding="12,5"
                        Click="BtnNewUser_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="10.5"
                                   VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="新建用户" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnRefresh" Style="{StaticResource GhostButton}" Padding="8,5" Margin="6,0,0,0"
                        Click="BtnRefresh_Click" ToolTip="重新读取账户与服务状态">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══ 用户与账号 ═══ -->
        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="12,10" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="用户与账号" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" x:Name="UserSummary" Text="" FontSize="10.5"
                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                </Grid>

                <!-- 表头 -->
                <Grid Grid.Row="1" Height="24" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="用户名" FontSize="10" Margin="10,0,0,0"
                               VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                    <TextBlock Grid.Column="1" Text="远程" FontSize="10" TextAlignment="Center"
                               VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                    <TextBlock Grid.Column="2" Text="管理员" FontSize="10" TextAlignment="Center"
                               VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                    <TextBlock Grid.Column="3" Text="密码" FontSize="10" TextAlignment="Center"
                               VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                    <TextBlock Grid.Column="4" Text="状态" FontSize="10" Margin="8,0,0,0"
                               VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" />
                </Grid>
                <Border Grid.Row="1" Height="1" Background="#14FFFFFF" VerticalAlignment="Bottom" />

                <!-- 用户行（虚拟滚动，保证一屏内可滚动而不是撑高页面） -->
                <ScrollViewer Grid.Row="2" x:Name="UserScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Margin="0,2,0,0">
                    <StackPanel>
                        <StackPanel x:Name="UserList" />
                        <TextBlock x:Name="NoUserHint" Text="正在读取用户列表…" Style="{StaticResource Caption}"
                                   Margin="10,8,10,8" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══ RDP Wrapper（紧凑单行） ═══ -->
        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="12,9" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="RDP Wrapper" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" x:Name="WrapDirBox" Style="{StaticResource GlassTextBox}"
                             Margin="10,0,0,0" Height="26" FontSize="11"
                             FontFamily="{StaticResource MonoFont}" VerticalContentAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button x:Name="BtnBrowseWrap" Style="{StaticResource GhostButton}" Padding="8,4"
                                Click="BtnBrowseWrap_Click" Content="…" ToolTip="选择目录" />
                        <Button x:Name="BtnRestoreWrap" Style="{StaticResource GhostButton}" Padding="10,4"
                                Margin="6,0,0,0" Click="BtnRestoreWrap_Click" Content="恢复"
                                ToolTip="恢复到安装前的原始配置并重启服务" />
                        <Button x:Name="BtnInstallWrap" Style="{StaticResource PrimaryButton}" Padding="12,4"
                                Margin="6,0,0,0" Click="BtnInstallWrap_Click" Content="安装并重启" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="WrapStatusText" Text="检测中…" FontSize="10.5"
                               FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Grid.Column="1" x:Name="WrapDetail" Text="" FontSize="10" Margin="12,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextMuted}" FontFamily="{StaticResource MonoFont}" />
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ 日志 ═══ -->
        <Border Grid.Row="3" Style="{StaticResource GlassCard}" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="操作日志" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Padding="8,3"
                            Click="BtnClearLog_Click" Content="清空" FontSize="10" />
                </Grid>
                <ScrollViewer Grid.Row="1" x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Margin="0,5,0,0">
                    <TextBlock x:Name="LogText" Text="" FontSize="10" LineHeight="15"
                               FontFamily="{StaticResource MonoFont}"
                               Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
