<UserControl x:Class="SoulLink.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SoulLink.Controls"
             FontFamily="{StaticResource UiFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="390" />
        </Grid.ColumnDefinitions>

        <!-- 左：设置 -->
        <Border Grid.Column="0" Style="{StaticResource GlassCardStrong}" Padding="20,18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="设置" Style="{StaticResource Title}" />
                    <TextBlock Text="只需要配置一次；程序会自动记住。"
                               Style="{StaticResource Caption}" Margin="0,4,0,16" TextWrapping="Wrap" />

                    <!-- 投送引擎 -->
                    <TextBlock Text="跨会话投送" Style="{StaticResource Label}" />
                    <Border Style="{StaticResource GlassPanel}" Padding="14,13">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ctl:GlowDot x:Name="EngineDot" Width="18" Height="18" VerticalAlignment="Center"
                                             Color="#FF41F0C0" />
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock x:Name="EngineState" Text="检测中…" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock x:Name="EnginePath" Text="—" Style="{StaticResource Mono}"
                                               TextWrapping="Wrap" MaxWidth="360" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <Border Style="{StaticResource Divider}" Margin="0,12" />

                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Text="投送进程走 Windows 计划任务（SYSTEM 身份），免安装、不需要任何外部工具。唯一要求是「以管理员身份运行」——这也是 RDP 画面注入所必需的。" />

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource GhostButton}" Padding="14,8" Click="Redetect_Click">
                                    <TextBlock Text="重新检测" FontSize="11.5" />
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Padding="14,8" Margin="8,0,0,0" Click="RestartAsAdmin_Click">
                                    <TextBlock Text="以管理员身份重启" FontSize="11.5" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="RDP 账号请在「中控台 → 用户配置」中维护。"
                               Style="{StaticResource Caption}" Margin="0,18,0,8" />

                    <!-- 行为 -->
                    <TextBlock Text="行为" Style="{StaticResource Label}" Margin="0,18,0,6" />
                    <Border Style="{StaticResource GlassPanel}" Padding="14,12">
                        <StackPanel>
                            <CheckBox x:Name="TrayCheck" Content="关闭窗口时最小化到托盘（后台命令继续可用）"
                                      Style="{StaticResource GlassCheckBox}" Checked="Option_Changed" Unchecked="Option_Changed" />
                            <CheckBox x:Name="RemoteCheck" Content="允许命令行 / 其它程序调用执行动作"
                                      Style="{StaticResource GlassCheckBox}" Margin="0,10,0,0"
                                      Checked="Option_Changed" Unchecked="Option_Changed" />
                            <CheckBox x:Name="FallbackCheck" Content="找不到会话时，允许回退到当前用户会话"
                                      Style="{StaticResource GlassCheckBox}" Margin="0,10,0,0"
                                      Checked="Option_Changed" Unchecked="Option_Changed" />
                        </StackPanel>
                    </Border>

                    <!-- 开机自启 -->
                    <TextBlock Text="开机自启" Style="{StaticResource Label}" Margin="0,18,0,6" />
                    <Border Style="{StaticResource GlassPanel}" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="用计划任务实现：只在指定 Windows 账户登录时启动，以最高权限运行，不弹 UAC。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="18" />

                            <!-- ① 启动账户：谁登录时拉起程序（默认当前用户） -->
                            <TextBlock Text="启动账户（该账户登录时启动程序）" FontSize="10.5"
                                       Foreground="{StaticResource TextMuted}" Margin="0,12,0,0" />
                            <ComboBox x:Name="AutoStartUserCombo" Margin="0,5,0,0" />

                            <!-- ② 启动后自动连接的 RDP 用户：可多选 -->
                            <TextBlock Text="启动后自动连接（可多选）" FontSize="10.5"
                                       Foreground="{StaticResource TextMuted}" Margin="0,12,0,0" />
                            <Border Style="{StaticResource GlassPanel}" Padding="10,8" Margin="0,5,0,0">
                                <StackPanel x:Name="AutoConnectList" />
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="AutoStartButton" Style="{StaticResource PrimaryButton}" Padding="18,8"
                                        Click="AutoStart_Click">
                                    <TextBlock x:Name="AutoStartButtonText" Text="开启自启" FontSize="11.5" />
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="AutoStartStatus" Style="{StaticResource Caption}"
                                       Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- 配置 -->
                    <TextBlock Text="配置文件" Style="{StaticResource Label}" Margin="0,18,0,6" />
                    <Border Style="{StaticResource GlassPanel}" Padding="14,12">
                        <StackPanel>
                            <TextBlock x:Name="ConfigPathText" Style="{StaticResource Mono}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource GhostButton}" Padding="14,8" Click="OpenConfig_Click">
                                    <TextBlock Text="打开配置目录" FontSize="11.5" />
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Padding="14,8" Margin="8,0,0,0" Click="Export_Click">
                                    <TextBlock Text="导出配置" FontSize="11.5" />
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Padding="14,8" Margin="8,0,0,0" Click="Import_Click">
                                    <TextBlock Text="导入配置" FontSize="11.5" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 右：运行日志 -->
        <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,12">
                    <StackPanel>
                        <TextBlock Text="运行日志" Style="{StaticResource Title}" />
                        <TextBlock Text="最近 600 条 · 实时" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="ClearLog_Click" ToolTip="清空">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                    </Button>
                </Grid>

                <Border Grid.Row="1" CornerRadius="13" Background="#33000000" BorderBrush="#22FFFFFF" BorderThickness="1" Padding="10,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LogList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TimeText}" Style="{StaticResource Mono}"
                                                   Foreground="#66C8E0FF" FontSize="10.5" VerticalAlignment="Top" />
                                        <ctl:GlowDot Grid.Column="1" Width="9" Height="9" Margin="7,4,7,0" VerticalAlignment="Top"
                                                     Color="{Binding DotColor}" Pulse="False" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="11.5"
                                                       Foreground="{Binding TextColor}" />
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="10.5"
                                                       Foreground="#6688A8D0" Margin="0,2,0,0"
                                                       Visibility="{Binding DetailVisibility}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,12,2,0">
                    <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="14,7"
                            Margin="0,0,0,0" Click="OpenReadme_Click">
                        <TextBlock Text="使用说明" FontSize="11.5" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
