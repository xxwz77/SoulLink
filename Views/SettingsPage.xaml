<UserControl x:Class="SoulLink.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SoulLink.Controls"
             FontFamily="{StaticResource UiFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="390" />
        </Grid.ColumnDefinitions>

        <!-- 左：设置 -->
        <Border Grid.Column="0" Style="{StaticResource GlassCardStrong}" Padding="20,18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="设置" Style="{StaticResource Title}" />
                    <TextBlock Text="只需要配置一次；程序会自动记住。"
                               Style="{StaticResource Caption}" Margin="0,4,0,16" TextWrapping="Wrap" />

                    <!-- 投送引擎 -->
                    <TextBlock Text="跨会话投送" Style="{StaticResource Label}" />
                    <Border Style="{StaticResource GlassPanel}" Padding="14,13">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ctl:GlowDot x:Name="EngineDot" Width="18" Height="18" VerticalAlignment="Center"
                                             Color="#FF41F0C0" />
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock x:Name="EngineState" Text="检测中…" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock x:Name="EnginePath" Text="—" Style="{StaticResource Mono}"
                                               TextWrapping="Wrap" MaxWidth="360" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <Border Style="{StaticResource Divider}" Margin="0,12" />

                            <!-- ★ 投送方式：三选一（用户要求"三种模式互斥，现在能同时勾选多种"）。
                                 原来 Broker 和手动代理是两个独立 CheckBox，
                                 可以同时勾上，语义互斥但界面允许 —— 这是设计缺陷。
                                 改成下拉单选，从结构上杜绝多选。 -->
                            <TextBlock Text="投送方式" FontSize="10.5"
                                       Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4" />
                            <ComboBox x:Name="DeliveryModeCombo" Margin="0,0,0,0"
                                      SelectionChanged="DeliveryMode_Changed">
                                <ComboBoxItem Content="SYSTEM 计划任务（默认，自动投送）" />
                                <ComboBoxItem Content="SYSTEM Broker 管理员代理（自动投送）" />
                                <ComboBoxItem Content="手动代理模式（不自动投送）" />
                            </ComboBox>

                            <TextBlock x:Name="DeliveryModeHint" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="所有跨会话启动的程序和管理员代理均强制管理员权限；无法取得管理员令牌时拒绝执行，不降级。" />

                            <!-- Broker 专用 -->
                            <StackPanel x:Name="BrokerPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                <Button Content="安装 / 管理服务" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="BrokerManage_Click" />
                            </StackPanel>

                            <!-- 手动代理专用 -->
                            <StackPanel x:Name="ManualPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                <Button Content="导出手动代理" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="ExportAgent_Click" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource GhostButton}" Padding="14,8" Click="Redetect_Click">
                                    <TextBlock Text="重新检测" FontSize="11.5" />
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Padding="14,8" Margin="8,0,0,0" Click="RestartAsAdmin_Click">
                                    <TextBlock Text="以管理员身份重启" FontSize="11.5" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="RDP 账号请在「中控台 → 用户配置」中维护。"
                               Style="{StaticResource Caption}" Margin="0,18,0,8" />

                    <!-- 行为 -->
                    <TextBlock Text="行为" Style="{StaticResource Label}" Margin="0,18,0,6" />
                    <Border Style="{StaticResource GlassPanel}" Padding="14,12">
                        <StackPanel>
                            <CheckBox x:Name="TrayCheck" Content="关闭窗口时最小化到托盘（后台命令继续可用）"
                                      Style="{StaticResource GlassCheckBox}" Checked="Option_Changed" Unchecked="Option_Changed" />
                            <CheckBox x:Name="RemoteCheck" Content="允许命令行 / 其它程序调用执行动作"
                                      Style="{StaticResource GlassCheckBox}" Margin="0,10,0,0"
                                      Checked="Option_Changed" Unchecked="Option_Changed" />
                            <CheckBox x:Name="OnlyAutomationCheck" Content="仅管理挂机账号（全局隐藏主用户及其地址、更新、自动化选项）"
                                      Style="{StaticResource GlassCheckBox}" Margin="0,10,0,0"
                                      Checked="Option_Changed" Unchecked="Option_Changed"
                                      ToolTip="只隐藏，不删除已保存数据；开启后主用户不会被后台作为执行目标。" />
                            <CheckBox x:Name="FallbackCheck" Content="找不到会话时，允许回退到当前用户会话"
                                      Style="{StaticResource GlassCheckBox}" Margin="0,10,0,0"
                                      Checked="Option_Changed" Unchecked="Option_Changed" />
                            <TextBlock Text="界面动效（性能档位）" FontSize="10.5"
                                       Foreground="{DynamicResource TextMuted}" Margin="0,12,0,4" />
                            <ComboBox x:Name="EffectTierCombo" SelectionChanged="EffectTier_Changed">
                                <ComboBoxItem Content="高（完整动效）· 前台约 1 核" />
                                <ComboBoxItem Content="中（关闭动态背景，保留呼吸灯）· 推荐" />
                                <ComboBoxItem Content="低（全部静止）· 挂机最省电" />
                            </ComboBox>
                            <TextBlock x:Name="EffectTierHint" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="实测：动态背景约占 61 个单核百分点，呼吸灯约占 27 个。窗口失去焦点时动画会自动暂停，所以挂机时即使选「高」也会自动降下来。" />
                        </StackPanel>
                    </Border>

                    <!-- ══════════ ① 开机自启（按钮紧跟设置项，避免误以为管下面的自动连接）══════════ -->
                    <TextBlock Text="开机自启" Style="{StaticResource Label}" Margin="0,18,0,6" />
                    <Border Style="{StaticResource GlassPanel}" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="用计划任务实现：只在指定 Windows 账户登录时启动，以最高权限运行，不弹 UAC。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="18" />

                            <TextBlock Text="启动账户（该账户登录时启动程序）" FontSize="10.5"
                                       Foreground="{DynamicResource TextMuted}" Margin="0,12,0,0" />
                            <ComboBox x:Name="AutoStartUserCombo" Margin="0,5,0,0" />

                            <!-- 按钮紧跟它所控制的设置项，文案写清作用对象 -->
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="AutoStartButton" Style="{StaticResource PrimaryButton}" Padding="18,8"
                                        Click="AutoStart_Click"
                                        ToolTip="只控制上面的计划任务，不影响自动连接">
                                    <TextBlock x:Name="AutoStartButtonText" Text="启用开机自启" FontSize="11.5" />
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="AutoStartStatus" Style="{StaticResource Caption}"
                                       Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- ══════════ ② 启动后自动连接（独立区域，与开机自启无关）══════════ -->
                    <TextBlock Text="启动后自动连接" Style="{StaticResource Label}" Margin="0,18,0,6" />
                    <Border Style="{StaticResource GlassPanel}" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="SoulLink 启动后自动连接这些 RDP 账号，并投送控制通道。勾选即生效，与开机自启无关。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="18" />

                            <Border Style="{StaticResource GlassPanel}" Padding="10,8" Margin="0,10,0,0">
                                <StackPanel x:Name="AutoConnectList" />
                            </Border>

                            <TextBlock x:Name="AutoConnectStatus" Style="{StaticResource Caption}"
                                       Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- ══════════ BetterGI 路径 ══════════ -->
                    <TextBlock Text="BetterGI 路径" Style="{StaticResource Label}" Margin="0,18,0,6" />
                    <Border Style="{StaticResource GlassPanel}" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="只有在这里绑定过的账号才会被读取日志（未绑定 = 完全不读文件，界面显示「BGI 未绑定」）。点「从进程取」自动填入正在运行的 BetterGI，也可以直接输入路径后回车。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="18" />

                            <Border Style="{StaticResource GlassPanel}" Padding="10,8" Margin="0,10,0,0">
                                <StackPanel x:Name="BgiPathList" />
                            </Border>

                            <TextBlock x:Name="BgiPathStatus" Style="{StaticResource Caption}"
                                       Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- ══════════ ③ 联机大厅服务器 ══════════ -->
                    <TextBlock Text="联机大厅" Style="{StaticResource Label}" Margin="0,18,0,6" />
                    <Border Style="{StaticResource GlassPanel}" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="联机大厅服务端地址。改完立即生效，不用重启。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="18" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 输入框 + 空时的占位提示 -->
                                <Grid Grid.Column="0">
                                    <TextBox x:Name="LobbyServerBox" Height="36"
                                             Style="{StaticResource GlassTextBox}"
                                             Padding="11,0,11,0" FontSize="12.5"
                                             VerticalContentAlignment="Center"
                                             TextChanged="LobbyServerBox_TextChanged" />

                                    <TextBlock x:Name="LobbyServerPlaceholder"
                                               Text="留空 = 使用内置默认地址"
                                               FontSize="12" Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Foreground="{DynamicResource TextMuted}" />
                                </Grid>

                                <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                                        Padding="14,7" Margin="8,0,0,0" Click="LobbyServerTest_Click">
                                    <TextBlock Text="测试连接" FontSize="11.5" />
                                </Button>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Padding="16,7"
                                        Click="LobbyServerSave_Click">
                                    <TextBlock Text="保存" FontSize="11.5" FontWeight="SemiBold" />
                                </Button>
                                <TextBlock x:Name="LobbyServerStatus" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 配置 -->
                    <TextBlock Text="配置文件" Style="{StaticResource Label}" Margin="0,18,0,6" />
                    <Border Style="{StaticResource GlassPanel}" Padding="14,12">
                        <StackPanel>
                            <TextBlock x:Name="ConfigPathText" Style="{StaticResource Mono}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource GhostButton}" Padding="14,8" Click="OpenConfig_Click">
                                    <TextBlock Text="打开配置目录" FontSize="11.5" />
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Padding="14,8" Margin="8,0,0,0" Click="Export_Click">
                                    <TextBlock Text="导出配置" FontSize="11.5" />
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Padding="14,8" Margin="8,0,0,0" Click="Import_Click">
                                    <TextBlock Text="导入配置" FontSize="11.5" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 右：运行日志 -->
        <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,12">
                    <StackPanel>
                        <TextBlock Text="运行日志" Style="{StaticResource Title}" />
                        <TextBlock Text="最近 600 条 · 实时" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="ClearLog_Click" ToolTip="清空">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                    </Button>
                </Grid>

                <Border Grid.Row="1" CornerRadius="13" Background="{DynamicResource FieldBackground}" BorderBrush="#22FFFFFF" BorderThickness="1" Padding="10,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LogList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TimeText}" Style="{StaticResource Mono}"
                                                   Foreground="#66C8E0FF" FontSize="10.5" VerticalAlignment="Top" />
                                        <ctl:GlowDot Grid.Column="1" Width="9" Height="9" Margin="7,4,7,0" VerticalAlignment="Top"
                                                     Color="{Binding DotColor}" Pulse="False" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="11.5"
                                                       Foreground="{Binding TextColor}" />
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="10.5"
                                                       Foreground="#6688A8D0" Margin="0,2,0,0"
                                                       Visibility="{Binding DetailVisibility}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,12,2,0">
                    <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="14,7"
                            Margin="0,0,0,0" Click="OpenReadme_Click">
                        <TextBlock Text="使用说明" FontSize="11.5" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
