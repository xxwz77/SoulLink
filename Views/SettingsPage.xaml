<UserControl x:Class="SoulLink.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SoulLink.Controls"
             FontFamily="{StaticResource UiFont}">

    <UserControl.Resources>
        <Style x:Key="ThemePreviewChoice" TargetType="RadioButton" BasedOn="{StaticResource DesktopChoice}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="ThemePreviewCheck" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DesktopAccent}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="104" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <ctl:DesktopArtwork Region="Header" />
            <StackPanel VerticalAlignment="Center" Margin="2,0,0,0">
                <TextBlock Text="设置" FontSize="14" Foreground="{DynamicResource TextSecondary}" />
                <TextBlock x:Name="SettingsHeading" Text="常规" FontSize="31" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <RadioButton x:Name="GeneralTab" Content="常规" GroupName="SettingsSection" IsChecked="True"
                             Style="{StaticResource DesktopChoice}" Click="SettingsSection_Click" />
                <RadioButton x:Name="AppearanceTab" Content="外观" GroupName="SettingsSection"
                             Style="{StaticResource DesktopChoice}" Margin="6,0,0,0" Click="SettingsSection_Click" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" x:Name="AppearancePanel" Visibility="Collapsed" TextElement.Foreground="{DynamicResource TextPrimary}">
            <ctl:DesktopArtwork Region="Log" Height="90" VerticalAlignment="Bottom" Opacity=".64" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource DesktopCard}" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,22,0">
                                <TextBlock Text="卡片透明度" FontSize="21" FontWeight="SemiBold" />
                                <TextBlock Text="0% 不透明 · 100% 透明" FontSize="13"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Slider x:Name="CardTransparencySlider" Grid.Column="1" VerticalAlignment="Center"
                                    Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="1"
                                    IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" ValueChanged="CardTransparency_Changed"
                                    AutomationProperties.Name="卡片透明度" AutomationProperties.HelpText="0% 不透明，100% 透明" />
                            <TextBlock Grid.Column="2" MinWidth="43" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding Value, ElementName=CardTransparencySlider, StringFormat={}{0:0}%}"
                                       Margin="14,0,0,0" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DesktopCard}" Padding="15" Margin="0,15,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,13">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <RadioButton x:Name="ThemeFollowSystem" Tag="0" Content="跟随系统" GroupName="DesktopMode"
                                                 Style="{StaticResource DesktopChoice}" Click="DesktopMode_Click" />
                                    <RadioButton x:Name="ThemeLightMode" Tag="1" Content="浅色" GroupName="DesktopMode"
                                                 Style="{StaticResource DesktopChoice}" Click="DesktopMode_Click" Margin="5,0" />
                                    <RadioButton x:Name="ThemeDarkMode" Tag="2" Content="深色" GroupName="DesktopMode"
                                                 Style="{StaticResource DesktopChoice}" Click="DesktopMode_Click" />
                                </StackPanel>
                                <TextBlock Text="主题" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Background="{DynamicResource StrokeSoft}" Height="1" />
                            <TextBlock Text="浅色主题" FontSize="15" FontWeight="SemiBold" Margin="0,13,0,7" />
                            <WrapPanel x:Name="ThemeLightChoices" />
                            <Border Background="{DynamicResource StrokeSoft}" Height="1" Margin="0,8,0,0" />
                            <TextBlock Text="深色主题" FontSize="15" FontWeight="SemiBold" Margin="0,13,0,7" />
                            <WrapPanel x:Name="ThemeDarkChoices" />
                            <Border Background="{DynamicResource StrokeSoft}" Height="1" Margin="0,8,0,0" />
                            <TextBlock Text="原图主题" FontSize="15" FontWeight="SemiBold" Margin="0,13,0,7" />
                            <WrapPanel x:Name="ThemePortraitChoices" />
                            <WrapPanel Margin="0,8,0,1">
                                <Button x:Name="CustomArtworkButton" Content="自定义原图…" Click="CustomArtwork_Click"
                                        Style="{StaticResource DesktopButton}" Padding="12,6" Margin="0,0,10,4" />
                                <TextBlock x:Name="CustomArtworkHint" VerticalAlignment="Center" Margin="0,0,0,4"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DesktopCard}" Padding="15" Margin="0,15,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="EffectHigh" Tag="0" Content="高" GroupName="DesktopEffects" MinWidth="60"
                                             Style="{StaticResource DesktopChoice}" Click="EffectTier_Click" />
                                <RadioButton x:Name="EffectMedium" Tag="1" Content="中" GroupName="DesktopEffects" MinWidth="60"
                                             Style="{StaticResource DesktopChoice}" Click="EffectTier_Click" Margin="5,0" />
                                <RadioButton x:Name="EffectLow" Tag="2" Content="低" GroupName="DesktopEffects" MinWidth="60"
                                             Style="{StaticResource DesktopChoice}" Click="EffectTier_Click" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="性能档位" FontSize="21" FontWeight="SemiBold" />
                                <TextBlock x:Name="EffectTierHint" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="1" x:Name="GeneralPanel" TextElement.Foreground="{DynamicResource TextPrimary}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="390" />
        </Grid.ColumnDefinitions>

        <!-- 左：设置 -->
        <Border Grid.Column="0" Style="{StaticResource GlassCardStrong}" Padding="20,18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="设置" Style="{StaticResource Title}" />
                    <TextBlock Text="只需要配置一次；程序会自动记住。"
                               Style="{StaticResource Caption}" Margin="0,4,0,16" TextWrapping="Wrap" />

                    <!-- 投送引擎 -->
                    <TextBlock Text="跨会话投送" Style="{StaticResource Label}" />
                    <Border Style="{StaticResource GlassPanel}" Padding="14,13">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <!-- ★ 2026-11-24 P0-2：默认值改中性灰（检测中…），
                                     原绿色 #FF41F0C0 是「未检测先显示就绪」的假绿。 -->
                                <ctl:GlowDot x:Name="EngineDot" Width="18" Height="18" VerticalAlignment="Center"
                                             Color="#FF8B9CC8" />
                                <StackPanel Margin="10,0,0,0">
                                    <!-- ★ 2026-11-24 P0-2：三方版本行「当前程序 X · 服务 Y · 注入代理 Z」
                                         数据源 = AgentSync.Inspect / AgentSync.LastVerdict（t1 单一判据），
                                         由 DetectAsync 的 Broker 分支刷新；未检测前保持占位「—」。 -->
                                    <TextBlock x:Name="EngineState" Text="检测中…" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock x:Name="EnginePath" Text="—" Style="{StaticResource Mono}"
                                               TextWrapping="Wrap" MaxWidth="360" Margin="0,3,0,0" />
                                    <TextBlock x:Name="EngineVer" Text="当前程序 — · 服务 — · 注入代理 —"
                                               Style="{StaticResource Mono}" FontSize="10.5" Opacity="0.85"
                                               TextWrapping="Wrap" MaxWidth="360" Margin="0,4,0,0"
                                               ToolTipService.ShowDuration="15000" />
                                </StackPanel>
                            </StackPanel>

                            <Button x:Name="BtnRepairAgent" Content="更新引擎组件" Visibility="Collapsed"
                                    Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                    Margin="0,10,0,0" Click="RepairAgent_Click" />

                            <Border Style="{StaticResource Divider}" Margin="0,12" />

                            <!-- ★ 投送方式：三选一（用户要求"三种模式互斥，现在能同时勾选多种"）。
                                 原来 Broker 和手动代理是两个独立 CheckBox，
                                 可以同时勾上，语义互斥但界面允许 —— 这是设计缺陷。
                                 改成下拉单选，从结构上杜绝多选。 -->
                            <TextBlock Text="投送方式" FontSize="10.5"
                                       Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4" />
                            <ComboBox x:Name="DeliveryModeCombo" Margin="0,0,0,0"
                                      SelectionChanged="DeliveryMode_Changed">
                                <ComboBoxItem Content="SYSTEM 计划任务（默认，自动投送）" />
                                <ComboBoxItem Content="SYSTEM Broker 管理员代理（自动投送）" />
                                <ComboBoxItem Content="手动代理模式（不自动投送）" />
                            </ComboBox>

                            <TextBlock x:Name="DeliveryModeHint" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="所有跨会话启动的程序和管理员代理均强制管理员权限；无法取得管理员令牌时拒绝执行，不降级。" />

                            <!-- Broker 专用 -->
                            <StackPanel x:Name="BrokerPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                <Button Content="安装 / 管理服务" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="BrokerManage_Click" />
                            </StackPanel>

                            <!-- 手动代理专用 -->
                            <StackPanel x:Name="ManualPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                <Button Content="导出手动代理" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="ExportAgent_Click" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource GhostButton}" Padding="14,8" Click="Redetect_Click">
                                    <TextBlock Text="重新检测" FontSize="11.5" />
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Padding="14,8" Margin="8,0,0,0" Click="RestartAsAdmin_Click">
                                    <TextBlock Text="以管理员身份重启" FontSize="11.5" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="RDP 账号请在「账号与会话 → 用户配置」中维护。"
                               Style="{StaticResource Caption}" Margin="0,18,0,8" />

                    <!-- 行为 -->
                    <TextBlock Text="行为" Style="{StaticResource Label}" Margin="0,18,0,6" />
                    <Border Style="{StaticResource GlassPanel}" Padding="14,12">
                        <StackPanel>
                            <CheckBox x:Name="TrayCheck" Content="关闭窗口时最小化到托盘（后台命令继续可用）"
                                      Style="{StaticResource GlassCheckBox}" Checked="Option_Changed" Unchecked="Option_Changed" />
                            <CheckBox x:Name="RemoteCheck" Content="允许命令行 / 其它程序调用执行动作"
                                      Style="{StaticResource GlassCheckBox}" Margin="0,10,0,0"
                                      Checked="Option_Changed" Unchecked="Option_Changed" />
                            <CheckBox x:Name="OnlyAutomationCheck" Content="仅管理挂机账号（可在概览中管理主账号流程）"
                                      Style="{StaticResource GlassCheckBox}" Margin="0,10,0,0"
                                      Checked="Option_Changed" Unchecked="Option_Changed"
                                      ToolTip="主账号的远程连接、投送和更新受限。主账号自己的自动化流程可在概览中管理。" />
                            <CheckBox x:Name="FallbackCheck" Content="找不到会话时，允许回退到当前用户会话"
                                      Style="{StaticResource GlassCheckBox}" Margin="0,10,0,0"
                                      Checked="Option_Changed" Unchecked="Option_Changed" />
                        </StackPanel>
                    </Border>

                    <!-- ══════════ ① 开机自启（按钮紧跟设置项，避免误以为管下面的自动连接）══════════ -->
                    <TextBlock Text="开机自启" Style="{StaticResource Label}" Margin="0,18,0,6" />
                    <Border Style="{StaticResource GlassPanel}" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="用计划任务实现：只在指定 Windows 账户登录时启动，以最高权限运行，不弹 UAC。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="18" />

                            <TextBlock Text="启动账户（该账户登录时启动程序）" FontSize="10.5"
                                       Foreground="{DynamicResource TextMuted}" Margin="0,12,0,0" />
                            <ComboBox x:Name="AutoStartUserCombo" Margin="0,5,0,0" />

                            <!-- 按钮紧跟它所控制的设置项，文案写清作用对象 -->
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="AutoStartButton" Style="{StaticResource PrimaryButton}" Padding="18,8"
                                        Click="AutoStart_Click"
                                        ToolTip="只控制上面的计划任务，不影响自动连接">
                                    <TextBlock x:Name="AutoStartButtonText" Text="启用开机自启" FontSize="11.5" />
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="AutoStartStatus" Style="{StaticResource Caption}"
                                       Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- ══════════ ② 启动后自动连接（独立区域，与开机自启无关）══════════ -->
                    <TextBlock Text="启动后自动连接" Style="{StaticResource Label}" Margin="0,18,0,6" />
                    <Border Style="{StaticResource GlassPanel}" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="SoulLink 启动后自动连接这些 RDP 账号，并投送控制通道。勾选即生效，与开机自启无关。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="18" />

                            <Border Style="{StaticResource GlassPanel}" Padding="10,8" Margin="0,10,0,0">
                                <StackPanel x:Name="AutoConnectList" />
                            </Border>

                            <TextBlock x:Name="AutoConnectStatus" Style="{StaticResource Caption}"
                                       Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- ══════════ BetterGI 路径 ══════════ -->
                    <TextBlock Text="BetterGI 路径" Style="{StaticResource Label}" Margin="0,18,0,6" />
                    <Border Style="{StaticResource GlassPanel}" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="只有在这里绑定过的账号才会被读取日志（未绑定 = 完全不读文件，界面显示「BGI 未绑定」）。点「从进程取」自动填入正在运行的 BetterGI，也可以直接输入路径后回车。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="18" />

                            <Border Style="{StaticResource GlassPanel}" Padding="10,8" Margin="0,10,0,0">
                                <StackPanel x:Name="BgiPathList" />
                            </Border>

                            <TextBlock x:Name="BgiPathStatus" Style="{StaticResource Caption}"
                                       Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- ══════════ ③ 服务器 ══════════ -->
                    <TextBlock Text="服务器" Style="{StaticResource Label}" Margin="0,18,0,6" />
                    <Border Style="{StaticResource GlassPanel}" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="服务器地址（联机大厅 / 路线更新 / 客户端更新三处共用）。留空 = 不联网。改完立即生效，不用重启。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="18" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 输入框 + 空时的占位提示 -->
                                <Grid Grid.Column="0">
                                    <TextBox x:Name="LobbyServerBox" Height="36"
                                             Style="{StaticResource GlassTextBox}"
                                             Padding="11,0,11,0" FontSize="12.5"
                                             VerticalContentAlignment="Center"
                                             TextChanged="LobbyServerBox_TextChanged" />

                                    <TextBlock x:Name="LobbyServerPlaceholder"
                                               Text="留空 = 未配置服务器（不联网）"
                                               FontSize="12" Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Foreground="{DynamicResource TextMuted}" />
                                </Grid>

                                <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                                        Padding="14,7" Margin="8,0,0,0" Click="LobbyServerTest_Click">
                                    <TextBlock Text="测试连接" FontSize="11.5" />
                                </Button>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Padding="16,7"
                                        Click="LobbyServerSave_Click">
                                    <TextBlock Text="保存" FontSize="11.5" FontWeight="SemiBold" />
                                </Button>
                                <TextBlock x:Name="LobbyServerStatus" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ══════════ 网页访问 ══════════
                         ★ 这是**全局**功能：不只是录像，将来还要看截图、状态等，
                           所以放在应用设置而不是 RDP 通用设置（那是单账号范围）。
                         ★ 用户要求：「在设置里填写个端口号，ip+端口号可以打开网页」 -->
                    <TextBlock Text="网页访问" Style="{StaticResource Label}" Margin="0,18,0,6" />
                    <Border Style="{StaticResource GlassPanel}" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="在局域网内用浏览器查看录制回放。填 0 或不填 = 不开启。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="18" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="端口号" Style="{StaticResource Label}"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox Grid.Column="1" x:Name="WebPortBox" Height="36"
                                         Style="{StaticResource GlassTextBox}"
                                         Padding="11,0,11,0" FontSize="12.5"
                                         VerticalContentAlignment="Center"
                                         TextChanged="WebPortBox_TextChanged" />

                                <Button Grid.Column="2" Style="{StaticResource GhostButton}"
                                        Padding="14,7" Margin="8,0,0,0" Click="WebOpen_Click">
                                    <TextBlock Text="打开网页" FontSize="11.5" />
                                </Button>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="访问口令" Style="{StaticResource Label}"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox Grid.Column="1" x:Name="WebPasswordBox" Height="36"
                                         Style="{StaticResource GlassTextBox}"
                                         Padding="11,0,11,0" FontSize="12.5"
                                         VerticalContentAlignment="Center"
                                         TextChanged="WebPasswordBox_TextChanged" />
                            </Grid>
                            <TextBlock Text="留空 = 不校验，局域网内任何人可访问并操作。建议设置口令。"
                                       Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />

                            <TextBlock x:Name="WebStatus" Style="{StaticResource Caption}"
                                       Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="18" />
                        </StackPanel>
                    </Border>

                    <!-- 配置 -->
                    <TextBlock Text="配置文件" Style="{StaticResource Label}" Margin="0,18,0,6" />
                    <Border Style="{StaticResource GlassPanel}" Padding="14,12">
                        <StackPanel>
                            <TextBlock x:Name="DataDirModeText" Style="{StaticResource Caption}" Margin="0,0,0,4"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ConfigPathText" Style="{StaticResource Mono}" TextWrapping="Wrap" />
                            <TextBlock x:Name="StorageUsageText" Style="{StaticResource Caption}" Margin="0,8,0,0"
                                       TextWrapping="Wrap" />
                            <!-- ★ 2.21.0：旧版数据迁移。只在检测到旧目录有数据时显示
                                 ★ 3.1.2：改用主题资源（原来硬编码 #22FFC46B 底色 + #FFFFC46B 文字，
                                   在亮色主题下几乎看不见，且与玻璃卡片风格不搭）。 -->
                            <Border x:Name="LegacyDataPanel" Visibility="Collapsed" Margin="0,10,0,0"
                                    CornerRadius="12" Padding="14,12"
                                    Background="{DynamicResource PanelBackground}"
                                    BorderBrush="{DynamicResource AmberBrush}" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Foreground="{DynamicResource AmberBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="检测到旧版本的数据" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AmberBrush}" FontSize="12"
                                                   Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="LegacyDataHint" Style="{StaticResource Caption}"
                                               Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Style="{StaticResource PrimaryButton}" Padding="14,7"
                                                Click="MigrateLegacy_Click">
                                            <TextBlock Text="迁移到当前目录" FontSize="11.5" FontWeight="SemiBold" />
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Padding="14,7" Margin="8,0,0,0"
                                                Click="OpenLegacy_Click">
                                            <TextBlock Text="打开旧目录看看" FontSize="11.5" />
                                        </Button>
                                    </StackPanel>
                                    <TextBlock x:Name="MigrateProgressText" Style="{StaticResource Caption}"
                                               Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource GhostButton}" Padding="14,8" Click="OpenConfig_Click">
                                    <TextBlock Text="打开数据目录" FontSize="11.5" />
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Padding="14,8" Margin="8,0,0,0" Click="Export_Click">
                                    <TextBlock Text="导出配置" FontSize="11.5" />
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Padding="14,8" Margin="8,0,0,0" Click="Import_Click">
                                    <TextBlock Text="导入配置" FontSize="11.5" />
                                </Button>
                            </StackPanel>

                            <!-- ★ 3.1.2：两个数字输入框改用 CompactTextBox，与主题一致。
                                 原来没写 Style，用的是 WPF 默认白底黑边框，和深色玻璃主题完全冲突。 -->
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="BGI 备份保留" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="BackupKeepBox" Width="58" Height="26" Margin="8,0,0,0"
                                         Style="{StaticResource CompactTextBox}" FontSize="12.5"
                                         LostFocus="BackupKeepBox_LostFocus"
                                         ToolTip="留空 = 不限制，保留全部历史" />
                                <TextBlock Text="次（留空 = 不限制，保留全部历史）" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                                <Button Style="{StaticResource GhostButton}" Padding="12,6" Margin="10,0,0,0"
                                        Click="PruneBackups_Click">
                                    <TextBlock Text="立即清理" FontSize="11.5" />
                                </Button>
                            </StackPanel>

                            <!-- ★ 2.21.2：路线包缓存按天过期 -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="路线包缓存保留" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="CacheKeepBox" Width="58" Height="26" Margin="8,0,0,0"
                                         Style="{StaticResource CompactTextBox}" FontSize="12.5"
                                         LostFocus="CacheKeepBox_LostFocus"
                                         ToolTip="留空 = 不限制；缓存删了可重新下载" />
                                <TextBlock Text="天（留空 = 不限制；缓存删了可重新下载）" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                                <Button Style="{StaticResource GhostButton}" Padding="12,6" Margin="10,0,0,0"
                                        Click="PruneCache_Click">
                                    <TextBlock Text="立即清理" FontSize="11.5" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 右：运行日志 -->
        <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,12">
                    <StackPanel>
                        <TextBlock Text="运行日志" Style="{StaticResource Title}" />
                        <TextBlock Text="最近 600 条 · 实时" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="ClearLog_Click" ToolTip="清空">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                    </Button>
                </Grid>

                <Border Grid.Row="1" CornerRadius="13" BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="1" Padding="10,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LogList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TimeText}" Style="{StaticResource Mono}"
                                                   Foreground="{DynamicResource TextSecondary}" FontSize="10.5" VerticalAlignment="Top" />
                                        <ctl:GlowDot Grid.Column="1" Width="9" Height="9" Margin="7,4,7,0" VerticalAlignment="Top"
                                                     Color="{Binding Foreground.Color, ElementName=LogMessage}" Pulse="False" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="LogMessage" Text="{Binding Text}" TextWrapping="Wrap" FontSize="11.5">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="Ok"><Setter Property="Foreground" Value="{DynamicResource MintBrush}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Warn"><Setter Property="Foreground" Value="{DynamicResource AmberBrush}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource RoseBrush}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="Run"><Setter Property="Foreground" Value="{DynamicResource CyanBrush}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"
                                                       Visibility="{Binding DetailVisibility}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,12,2,0">
                    <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="14,7"
                            Margin="0,0,0,0" Click="OpenReadme_Click">
                        <TextBlock Text="使用说明" FontSize="11.5" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</UserControl>
