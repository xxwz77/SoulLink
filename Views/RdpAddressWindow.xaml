<Window x:Class="SoulLink.Views.RdpAddressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="用户与 RDP 设置"
        Width="560" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid Margin="18">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.8" Color="#FF05070F" />
        </Grid.Effect>

        <Border CornerRadius="20" Background="{DynamicResource DialogSurface}" BorderBrush="{DynamicResource StrokeMid}" BorderThickness="1"
                ClipToBounds="True" Padding="24,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="TitleText" Text="用户与 RDP 设置" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock x:Name="SubText" Text="配置中控台接入这个用户时使用的参数"
                               FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,5,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="显示名称" Style="{StaticResource Label}" />
                        <TextBox x:Name="NameBox" Style="{StaticResource GlassTextBox}" Margin="0,6,0,0" />

                        <TextBlock Text="RDP 地址" Style="{StaticResource Label}" Margin="0,14,0,0" />
                        <TextBox x:Name="HostBox" Style="{StaticResource GlassTextBox}" Margin="0,6,0,0"
                                 FontFamily="{StaticResource MonoFont}" />
                        <TextBlock Text="留空 = 自动探测。多用户环回一般是 127.0.0.3 这类地址。"
                                   Style="{StaticResource Caption}" Margin="2,6,0,0" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="端口" Style="{StaticResource Label}" />
                                <TextBox x:Name="PortBox" Style="{StaticResource GlassTextBox}" Margin="0,6,0,0"
                                         FontFamily="{StaticResource MonoFont}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="RDP 登录名" Style="{StaticResource Label}" />
                                <TextBox x:Name="UserBox" Style="{StaticResource GlassTextBox}" Margin="0,6,0,0"
                                         FontFamily="{StaticResource MonoFont}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="画面" Style="{StaticResource Label}" Margin="0,18,0,0" />
                        <Border Style="{StaticResource GlassPanel}" Padding="12,10" Margin="0,6,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="宽" FontSize="10.5" Foreground="{DynamicResource TextMuted}" />
                                        <TextBox x:Name="WidthBox" Style="{StaticResource GlassTextBox}" Margin="0,4,0,0"
                                                 FontFamily="{StaticResource MonoFont}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="高" FontSize="10.5" Foreground="{DynamicResource TextMuted}" />
                                        <TextBox x:Name="HeightBox" Style="{StaticResource GlassTextBox}" Margin="0,4,0,0"
                                                 FontFamily="{StaticResource MonoFont}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="缩放模式" FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                                           Margin="0,10,0,4" />
                                <ComboBox x:Name="ScaleCombo" >
                                    <ComboBoxItem Content="跟随窗口（自动调整远端分辨率）" Tag="0" />
                                    <ComboBoxItem Content="拉伸（固定分辨率，画面撑满）" Tag="1" />
                                    <ComboBoxItem Content="原大小（固定分辨率，不缩放）" Tag="2" />
                                </ComboBox>

                                <TextBlock Text="色深" FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                                           Margin="0,10,0,4" />
                                <ComboBox x:Name="DepthCombo" >
                                    <ComboBoxItem Content="32 位（最佳画质）" Tag="32" />
                                    <ComboBoxItem Content="16 位（省带宽）" Tag="16" />
                                    <ComboBoxItem Content="8 位（最省）" Tag="8" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="连接行为" Style="{StaticResource Label}" Margin="0,18,0,0" />
                        <Border Style="{StaticResource GlassPanel}" Padding="12,10" Margin="0,6,0,0">
                            <StackPanel>
                                <CheckBox x:Name="AutoDiscCheck" Style="{StaticResource GlassCheckBox}"
                                          Content="连接前先把目标会话踢成断开（RDP 才能复用真实桌面）" />
                                <CheckBox x:Name="LowBwCheck" Style="{StaticResource GlassCheckBox}" Margin="0,8,0,0"
                                          Content="低带宽模式（关闭壁纸与动画）" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassPanel}" Padding="12,10" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="关于地址" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource AmberBrush}" />
                                <TextBlock TextWrapping="Wrap" FontSize="10.5" LineHeight="16"
                                           Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0"
                                           Text="本机所有环回 RDP 客户端在服务端看来都是 127.0.0.1，所以「会话 8 就用 127.0.0.8」不成立。哪个地址能落到目标会话只能实测，用 1Remote 里能连的那个最稳。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="取消" Style="{StaticResource GhostButton}" Padding="20,9" Click="Cancel_Click" />
                    <Button Content="保存" Style="{StaticResource PrimaryButton}" Padding="24,9"
                            Margin="10,0,0,0" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>