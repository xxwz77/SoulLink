<Window x:Class="SoulLink.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SoulLink.Controls"
        Title="软件更新" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="False"
        Background="{DynamicResource DialogSurface}"
        ShowInTaskbar="False" FontFamily="{StaticResource UiFont}"
        ResizeMode="NoResize">

    <Border CornerRadius="14" BorderBrush="{DynamicResource StrokeMid}" BorderThickness="1" Margin="0">
        <Border.Background><SolidColorBrush Color="{Binding Color, Source={StaticResource DialogSurface}}" /></Border.Background>

        <Grid ClipToBounds="True">
            <ctl:AuroraBackdrop Opacity="0.48" />
            <StackPanel Margin="22,18,22,16">

                <!-- 标题行 -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets"
                               FontSize="16" VerticalAlignment="Center"
                               Foreground="{StaticResource CyanBrush}" />
                    <TextBlock Text="发现新版本" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 版本对比 -->
                <Border Background="{DynamicResource FieldBackground}" CornerRadius="10"
                        BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1"
                        Padding="14,10" Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="当前版本" FontSize="11.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMuted}" />
                        <TextBlock x:Name="LocalVersionText" Text="v—" FontSize="12.5" FontWeight="SemiBold"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Margin="14,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMuted}" />
                        <TextBlock Text="最新版本" FontSize="11.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMuted}" />
                        <TextBlock x:Name="RemoteVersionText" Text="v—" FontSize="12.5" FontWeight="SemiBold"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource CyanBrush}" />
                    </StackPanel>
                </Border>

                <!-- 更新说明 -->
                <TextBlock Text="更新说明" FontSize="11.5" Margin="0,16,0,0"
                           Foreground="{DynamicResource TextMuted}" />
                <Border Background="{DynamicResource FieldBackground}" CornerRadius="10"
                        BorderBrush="{DynamicResource ButtonBorder}" BorderThickness="1"
                        Padding="14,12" Margin="0,7,0,0">
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="NotesText" Text="" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap" LineHeight="20" />
                    </ScrollViewer>
                </Border>

                <!-- 进度条 -->
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,14,0,0">
                    <ProgressBar x:Name="ProgressBar" Height="4" Minimum="0" Maximum="100"
                                 Background="{DynamicResource FieldBackground}"
                                 Foreground="{StaticResource CyanBrush}"
                                 BorderThickness="0" />
                    <TextBlock x:Name="ProgressText" Text="准备下载…" FontSize="11"
                               Margin="0,7,0,0"
                               Foreground="{DynamicResource TextMuted}" />
                </StackPanel>

                <!-- 错误提示 -->
                <TextBlock x:Name="ErrorText" Text="" FontSize="11.5" Margin="0,12,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{StaticResource AmberBrush}" />

                <!-- 按钮 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="BtnCancel" Style="{StaticResource GhostButton}"
                            Padding="20,8" Margin="0,0,10,0" Click="Cancel_Click">
                        <TextBlock Text="取消" FontSize="12" />
                    </Button>
                    <Button x:Name="BtnConfirm" Style="{StaticResource PrimaryButton}"
                            Padding="24,8" Click="Confirm_Click">
                        <TextBlock Text="确认更新" FontSize="12.5" FontWeight="SemiBold" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
