<Window x:Class="SoulLink.Views.InputDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SoulLink.Controls"
        Title="SoulLink" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="{StaticResource UiFont}">

    <Border CornerRadius="16" BorderBrush="{DynamicResource StrokeMid}" BorderThickness="1" Margin="10">
                <Border.Background><SolidColorBrush Color="{Binding Color, Source={StaticResource DialogSurface}}" /></Border.Background>

        <Grid ClipToBounds="True">
            <ctl:AuroraBackdrop Opacity="0.48" />
        <StackPanel Margin="22,20,22,18">
            <TextBlock x:Name="TitleText" Text="输入" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" />
            <TextBlock x:Name="HintText" Text="" FontSize="11"
                       Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0"
                       TextWrapping="Wrap" />
            <TextBox x:Name="Input" Height="38" Margin="0,14,0,0"
                     Style="{StaticResource GlassTextBox}"
                     Padding="11,0,11,0" FontSize="13"
                     VerticalContentAlignment="Center"
                     KeyDown="Input_KeyDown" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Style="{StaticResource GhostButton}" Padding="18,8" Click="Cancel_Click">
                    <TextBlock Text="取消" FontSize="12" />
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Padding="22,8" Margin="10,0,0,0"
                        Click="Ok_Click">
                    <TextBlock Text="确定" FontSize="12.5" FontWeight="SemiBold" />
                </Button>
            </StackPanel>
        </StackPanel>
        </Grid>
    </Border>
</Window>
