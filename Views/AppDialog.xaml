<Window x:Class="SoulLink.Views.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SoulLink.Controls"
        Width="460" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="NoResize" FontFamily="{StaticResource UiFont}">
    <Grid Margin="18">
        <Grid.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.8" Color="#FF03050D" /></Grid.Effect>
        <Border CornerRadius="20" Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource StrokeMid}"
                BorderThickness="1" ClipToBounds="True">
            <Grid>
                <ctl:AuroraBackdrop Opacity="0.5" IsHitTestVisible="False" />
                <StackPanel Margin="26,24,26,22">
                    <Grid MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                        <TextBlock x:Name="IconText" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                   Foreground="{StaticResource CyanBrush}" VerticalAlignment="Top" />
                        <TextBlock x:Name="TitleText" Text="SoulLink" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="38,0,0,0" />
                    </Grid>
                    <TextBlock x:Name="MessageText" Margin="0,18,0,0" FontSize="12.5" LineHeight="22"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button x:Name="CancelButton" Content="取消" Style="{StaticResource GhostButton}" Padding="22,9"
                                Click="Cancel_Click" IsCancel="True" />
                        <Button x:Name="OkButton" Content="确定" Style="{StaticResource PrimaryButton}" Padding="26,9"
                                Margin="10,0,0,0" Click="Ok_Click" IsDefault="True" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>