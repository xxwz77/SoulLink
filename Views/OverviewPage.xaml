<UserControl x:Class="SoulLink.Views.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SoulLink.Views"
             Foreground="{DynamicResource TextPrimary}" FontSize="13">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="OverviewBooleanVisibility" />
        <Style x:Key="OverviewRowSplitter" TargetType="GridSplitter">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="ResizeDirection" Value="Rows" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="KeyboardIncrement" Value="12" />
            <Setter Property="Cursor" Value="SizeNS" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border x:Name="Grip" Width="42" Height="3" CornerRadius="2"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource StrokeMid}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="{DynamicResource DesktopAccent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="{DynamicResource DesktopAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TableCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style x:Key="OverviewAccountRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Summary.AccessibleName}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <Border x:Name="RowPlate" CornerRadius="4" BorderThickness="1"
                                    BorderBrush="Transparent" Background="Transparent" />
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowPlate" Property="Background" Value="{DynamicResource HoverFill}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowPlate" Property="Background" Value="{DynamicResource DesktopSelection}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="RowPlate" Property="BorderBrush" Value="{DynamicResource DesktopAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OverviewDetailValue" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="OverviewMetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="OverviewMetricValue" TargetType="TextBlock" BasedOn="{StaticResource OverviewDetailValue}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MoraCompositionLink" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource DesktopAccent}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="LinkFocus" BorderThickness="1" BorderBrush="Transparent" CornerRadius="3"
                                Margin="-1" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkFocus" Property="Background" Value="{DynamicResource HoverFill}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="LinkFocus" Property="BorderBrush" Value="{DynamicResource DesktopAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MoraCompositionBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="2.5" Background="{DynamicResource HoverFill}" />
                            <Border x:Name="PART_Indicator" CornerRadius="2.5" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DrawingImage x:Key="MoraJarIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#380F0806">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="12,21.1" RadiusX="7.6" RadiusY="1.5" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M 8,7 L 16,7 C 16.2,9 19.5,10.4 20,13.5 C 20.7,16.5 19.1,19.3 16.7,20.8 C 14.2,21.7 9.8,21.7 7.3,20.8 C 4.9,19.3 3.3,16.5 4,13.5 C 4.5,10.4 7.8,9 8,7 Z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0.25" EndPoint="1,0.85">
                                <GradientStop Color="#E5A071" Offset="0" />
                                <GradientStop Color="#BC6A46" Offset="0.55" />
                                <GradientStop Color="#743B31" Offset="1" />
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#68372C" Thickness="0.8" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#9D4C35"
                                     Geometry="M 4.1,13.3 C 8,14.7 16,14.7 19.9,13.3 L 20,15 C 15.2,16.5 8.8,16.5 4,15 Z" />
                    <GeometryDrawing Brush="#F4C196"
                                     Geometry="M 6.8,11.1 C 8.2,9.6 9.3,9 9.5,8.1 L 10.7,8.3 C 10.4,9.5 8.5,10.5 7.1,12.4 Z" />
                    <GeometryDrawing Brush="#C47651"
                                     Geometry="M 6.9,4.3 C 6.9,3.4 9.1,2.8 12,2.8 C 14.9,2.8 17.1,3.4 17.1,4.3 L 16.5,7 C 15.4,8.3 8.6,8.3 7.5,7 Z">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#68372C" Thickness="0.8" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#64362D">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="12,4.4" RadiusX="4" RadiusY="1" />
                        </GeometryDrawing.Geometry>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#E3AA7F" Thickness="0.85" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </UserControl.Resources>

    <Grid x:Name="OverviewRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel VerticalAlignment="Center" Margin="2,0,0,0" HorizontalAlignment="Left">
                <TextBlock Text="概览" FontSize="31" FontWeight="Bold" />
                <TextBlock Text="查看 BetterGI 运行状态与在线会话" FontSize="14"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
            </StackPanel>
            <Button x:Name="RefreshButton" Style="{StaticResource DesktopButton}" Click="Refresh_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" VerticalAlignment="Center" FontSize="15" />
                    <TextBlock Text="刷新" Margin="7,0,0,0" />
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock Grid.Row="1" x:Name="MoraRefreshStatus" Margin="3,0,3,10" Visibility="Collapsed"
                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.12*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="AccountsRow" Height="1.6*" MinHeight="122" />
                <RowDefinition Height="8" />
                <RowDefinition x:Name="LogRow" Height="*" MinHeight="80" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource DesktopCard}" Background="{DynamicResource OverviewAccountsCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="1,0,0,8">
                        <Button x:Name="OpenSelectedData" DockPanel.Dock="Right" Content="完整数据"
                                Style="{StaticResource DesktopLink}" Click="OpenAccountData_Click" ToolTip="查看所选账号的完整数据" />
                        <TextBlock Text="运行状态" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <Border Grid.Row="1" Background="{DynamicResource DesktopRow}" CornerRadius="4" Padding="6,0" Height="37">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width=".78*" />
                                <ColumnDefinition Width="1.03*" />
                                <ColumnDefinition Width="1.01*" />
                                <ColumnDefinition Width="1.16*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="账号" Style="{StaticResource TableCell}" />
                            <TextBlock Grid.Column="1" Text="会话" Style="{StaticResource TableCell}" />
                            <TextBlock Grid.Column="2" Text="BetterGI" Style="{StaticResource TableCell}" />
                            <TextBlock Grid.Column="3" Text="当前配置组" Style="{StaticResource TableCell}" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <ListBox x:Name="AccountsList" BorderThickness="0" Padding="0" Background="Transparent"
                                 Foreground="{DynamicResource TextPrimary}"
                                 ItemContainerStyle="{StaticResource OverviewAccountRow}" SelectionMode="Single"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 KeyboardNavigation.TabNavigation="Continue" SelectionChanged="AccountsList_SelectionChanged"
                                 PreviewKeyDown="AccountsList_PreviewKeyDown"
                                 AutomationProperties.Name="账号运行状态"
                                 AutomationProperties.HelpText="使用方向键选择账号，查看所选账号的快捷动作和运行日志。">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,0" BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="28" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width=".78*" />
                                                    <ColumnDefinition Width="1.03*" />
                                                    <ColumnDefinition Width="1.01*" />
                                                    <ColumnDefinition Width="1.16*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Summary.Caption}" ToolTip="{Binding Summary.Caption}" Style="{StaticResource TableCell}" FontWeight="SemiBold" />
                                                <DockPanel Grid.Column="1" Margin="4,0">
                                                    <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource TextMuted}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Summary.Session}" Value="已登录">
                                                                        <Setter Property="Fill" Value="{DynamicResource MintBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Summary.Session}" Value="已断开">
                                                                        <Setter Property="Fill" Value="{DynamicResource AmberBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Summary.Session}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <DockPanel Grid.Column="2" Margin="4,0">
                                                    <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource TextMuted}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Summary.BgiRunning}" Value="True">
                                                                        <Setter Property="Fill" Value="{DynamicResource MintBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Summary.Bgi}" Value="—">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Summary.Bgi}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <TextBlock Grid.Column="3" Text="{Binding Summary.Group}" ToolTip="{Binding Summary.Group}" Style="{StaticResource TableCell}" />
                                                <Grid Grid.Row="1" Grid.ColumnSpan="4" Margin="4,0,4,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="1.2*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,5,0">
                                                        <TextBlock Text="今日 A/B 线" Style="{StaticResource OverviewMetricLabel}"
                                                                   ToolTip="BetterGI 狗粮收尾记录，业务日从 04:00 开始。" />
                                                        <TextBlock Text="{Binding Summary.Ending}" Style="{StaticResource OverviewMetricValue}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="0,0,5,0">
                                                        <TextBlock Text="狗粮经验汇总" Style="{StaticResource OverviewMetricLabel}"
                                                                   ToolTip="汇总各 BetterGI 配置组的狗粮经验，业务日从 04:00 开始。" />
                                                        <TextBlock Text="{Binding Summary.DogfoodExp}" Style="{StaticResource OverviewMetricValue}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="0,0,5,0">
                                                        <TextBlock Text="狗粮摩拉汇总" Style="{StaticResource OverviewMetricLabel}"
                                                                   ToolTip="汇总各 BetterGI 配置组的狗粮摩拉，业务日从 04:00 开始。" />
                                                        <TextBlock Text="{Binding Summary.DogfoodMora}" Style="{StaticResource OverviewMetricValue}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3">
                                                        <TextBlock Text="今日摩拉总收益" Style="{StaticResource OverviewMetricLabel}"
                                                                   ToolTip="显示默认或唯一原神角色在米游社旅行者札记中的今日获得，凌晨 04:00 换日。尚未同步到札记总额时，显示该业务日已采集流水并标为部分。" />
                                                        <Button Style="{StaticResource MoraCompositionLink}" Click="OpenMoraComposition_Click"
                                                                ToolTip="查看今日收益构成与本地流水明细"
                                                                AutomationProperties.Name="{Binding Summary.MoraAccessibleName}">
                                                            <TextBlock Text="{Binding Summary.MoraIncome}" TextDecorations="Underline"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="NoAccounts" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="暂无已配置账号" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                            <Button Content="管理账号" Style="{StaticResource DesktopLink}" Click="ManageAccounts_Click" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="2" Grid.RowSpan="3">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ActionsRow" Height="*" MinHeight="88" />
                    <RowDefinition Height="10" />
                    <RowDefinition x:Name="AutomationRow" Height="3*" MinHeight="100" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource DesktopCard}" Background="{DynamicResource OverviewActionsCard}" Padding="13,10">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="0,0,0,1" Padding="0,0,0,4">
                            <DockPanel>
                                <Button x:Name="NewActionButton" DockPanel.Dock="Right" Content="＋ 新建" Style="{StaticResource DesktopLink}"
                                        IsEnabled="False" Click="NewAction_Click" />
                                <Button x:Name="ManageActionsButton" DockPanel.Dock="Right" Content="管理" Style="{StaticResource DesktopLink}"
                                        IsEnabled="False" Click="ManageActions_Click" />
                                <TextBlock Text="快捷动作" Style="{StaticResource SectionTitle}" />
                            </DockPanel>
                        </Border>
                        <TextBlock DockPanel.Dock="Top" x:Name="NoActions" Text="请选择一个账号" Foreground="{DynamicResource TextSecondary}" Margin="2,13,0,0" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="QuickActionsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource DesktopButton}" Padding="8,6" Margin="0,4,3,0"
                                            HorizontalContentAlignment="Stretch" MinHeight="32" Tag="{Binding Model}"
                                            AutomationProperties.Name="{Binding AccessibleName}" ToolTip="{Binding Name}" Click="RunAction_Click">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="执行中…" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" Text="{Binding Icon}"
                                                       VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource DesktopAccent}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <GridSplitter x:Name="ActionsFlowSplitter" Grid.Row="1" Style="{StaticResource OverviewRowSplitter}"
                              DragCompleted="Splitter_DragCompleted" KeyUp="Splitter_KeyUp"
                              ToolTip="上下拖动调整快捷动作与自动化的高度" AutomationProperties.Name="调整快捷动作与自动化高度" />
                <Border Grid.Row="2" Style="{StaticResource DesktopCard}" Background="{DynamicResource OverviewAutomationCard}" Padding="13,10">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="0,0,0,1" Padding="0,0,0,5">
                            <DockPanel>
                                <Button x:Name="NewFlowButton" DockPanel.Dock="Right" Content="＋ 新建"
                                        Style="{StaticResource DesktopLink}" Click="NewFlow_Click" />
                                <Button DockPanel.Dock="Right" Content="管理" Style="{StaticResource DesktopLink}" Click="ManageFlows_Click" />
                                <TextBlock Text="自动化" Style="{StaticResource SectionTitle}" />
                            </DockPanel>
                        </Border>
                        <TextBlock x:Name="NoFlows" DockPanel.Dock="Top" Text="暂无自动化流程" Foreground="{DynamicResource TextSecondary}" Margin="2,9,0,0" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="FlowsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="0,0,0,1">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,1,0">
                                                <views:AutomationTodayButton Tag="{Binding}" Click="ClearFlowToday_Click"
                                                        Visibility="{Binding Status.DoneToday, Converter={StaticResource OverviewBooleanVisibility}}"
                                                        IsEnabled="{Binding CanClearToday}" Margin="0,3,0,0" />
                                                <Button Content="{Binding ToggleText}" Tag="{Binding}" Click="ToggleFlow_Click" Margin="0,3,0,3" Padding="7,1"
                                                        AutomationProperties.Name="{Binding ToggleName}" ToolTip="{Binding ToggleName}"
                                                        HorizontalAlignment="Right">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource DesktopButton}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanToggle}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                            <Button Style="{StaticResource DesktopLink}" Foreground="{DynamicResource TextPrimary}"
                                                    HorizontalContentAlignment="Stretch" Tag="{Binding}" Click="Flow_Click" Padding="1,5"
                                                    IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{Binding AccessibleName}"
                                                    AutomationProperties.HelpText="{Binding EditHint}" ToolTip="{Binding EditTooltip}"
                                                    ToolTipService.ShowOnDisabled="True">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                               Foreground="{DynamicResource DesktopAccent}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Owner}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                                                        <DockPanel HorizontalAlignment="Stretch" ToolTip="{Binding Status.Text}">
                                                            <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,6,0"
                                                                     Fill="{Binding Status.Indicator}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Status.Text}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Executions}" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Executions}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
            <GridSplitter x:Name="LogSplitter" Grid.Row="1" Style="{StaticResource OverviewRowSplitter}"
                          DragCompleted="Splitter_DragCompleted" KeyUp="Splitter_KeyUp"
                          ToolTip="上下拖动调整日志高度" AutomationProperties.Name="调整日志高度" />
        <Border Grid.Row="2" Style="{StaticResource DesktopCard}" Background="{DynamicResource OverviewLogCard}" Padding="10,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button x:Name="HideLogButton" Style="{StaticResource DesktopLink}" Content="隐藏" Click="HideLog_Click"
                            DockPanel.Dock="Right" />
                    <CheckBox x:Name="FollowLog" Content="自动跟随" IsChecked="True" DockPanel.Dock="Right"
                              Style="{StaticResource GlassCheckBox}" VerticalAlignment="Center" Checked="FollowLog_Checked" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="运行日志" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource DesktopSelection}" CornerRadius="5" Padding="8,3" Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="LogAccount" Text="—" Foreground="{DynamicResource DesktopAccent}" MaxWidth="95"
                                       Style="{StaticResource OverviewDetailValue}" />
                        </Border>
                    </StackPanel>
                </DockPanel>
                <Border x:Name="LogContent" Grid.Row="1" Margin="0,3,0,0" CornerRadius="6" BorderThickness="1"
                        BorderBrush="{DynamicResource StrokeSoft}" ClipToBounds="True">
                    <TextBox x:Name="LogText" Style="{x:Null}" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimary}" FontFamily="Cascadia Mono, Microsoft YaHei UI"
                             FontSize="12" Padding="7,3" IsReadOnly="True" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                </Border>
            </Grid>
        </Border>
        </Grid>
        <Grid x:Name="MoraCompositionOverlay" Grid.RowSpan="3" Panel.ZIndex="20"
              Visibility="Collapsed" ClipToBounds="True" SizeChanged="MoraCompositionLayout_SizeChanged">
            <Border Background="Transparent" MouseDown="MoraCompositionOutside_MouseDown" />
            <Canvas>
                <Border x:Name="MoraCompositionPanel" Padding="13" CornerRadius="9" BorderThickness="1"
                    Background="{DynamicResource PopupBackground}" BorderBrush="{DynamicResource StrokeMid}"
                    TextElement.Foreground="{DynamicResource TextPrimary}" TextElement.FontSize="12"
                    KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="MoraComposition_PreviewKeyDown"
                    SizeChanged="MoraCompositionLayout_SizeChanged" ClipToBounds="True"
                    AutomationProperties.Name="今日摩拉收益构成与明细">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,3">
                                <Button x:Name="CloseMoraCompositionButton" DockPanel.Dock="Right" Content="关闭"
                                        Style="{StaticResource DesktopLink}" Padding="6,2" Click="CloseMoraComposition_Click"/>
                                <Image Width="24" Height="24" Margin="0,0,6,0" Source="/Assets/Mora/coin.png" />
                                <TextBlock Text="收益构成" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock x:Name="MoraCompositionSubtitle" Foreground="{DynamicResource TextSecondary}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="MoraCompositionTotal" FontWeight="SemiBold" Margin="0,4,0,7" />
                        </StackPanel>
                        <ScrollViewer x:Name="MoraCompositionScroll" Grid.Row="1" Focusable="False"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <ItemsControl x:Name="MoraCompositionParts">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="1" CornerRadius="6"
                                                    Padding="8,5" Margin="0,0,0,5">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Share}" VerticalAlignment="Center" />
                                                        <Image Width="24" Height="24" Margin="0,0,6,0">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Source" Value="{Binding Icon}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                            <Setter Property="Source" Value="{StaticResource MoraJarIcon}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <DockPanel Margin="0,1,0,4">
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Summary}" />
                                                        <TextBlock Text="{Binding EliteTiers}" Margin="8,0,0,0" TextAlignment="Right"
                                                                   TextWrapping="Wrap" FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondary}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding EliteTiers}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DockPanel>
                                                    <ProgressBar Style="{StaticResource MoraCompositionBar}" Value="{Binding Progress, Mode=OneWay}"
                                                                 Foreground="{Binding Tint}" AutomationProperties.Name="{Binding Label}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="MoraCompositionNote" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                                <Expander x:Name="MoraCompositionDetails" Header="流水明细" Margin="0,6,0,0"
                                          Expanded="MoraCompositionDetails_Expanded">
                                    <ListBox x:Name="MoraCompositionEntries" BorderThickness="0" Background="Transparent"
                                             Foreground="{DynamicResource TextPrimary}" MaxHeight="150"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                             AutomationProperties.Name="今日摩拉流水明细">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,1">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Amount}" Margin="5,0,0,0" />
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Margin="0,0,6,0"
                                                               Foreground="{DynamicResource TextSecondary}" />
                                                    <TextBlock Text="{Binding Source}" ToolTip="{Binding Source}" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Canvas>
        </Grid>
    </Grid>
</UserControl>
