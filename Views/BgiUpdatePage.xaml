<UserControl x:Class="SoulLink.Views.BgiUpdatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <Grid Margin="18,16,18,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ══════════ 左：配置 ══════════ -->
        <Border Grid.Column="0" Style="{StaticResource GlassCardStrong}" Padding="18,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />   <!-- 标题 -->
                    <RowDefinition Height="Auto" />   <!-- 更新包 -->
                    <RowDefinition Height="Auto" />   <!-- 选项 -->
                    <RowDefinition Height="Auto" />   <!-- 账号标题 -->
                    <RowDefinition Height="*" />      <!-- 账号列表 -->
                    <RowDefinition Height="Auto" />   <!-- 按钮 -->
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="更新 BGI" Style="{StaticResource Title}" />
                    <TextBlock x:Name="SubText" Text="把本地更新包解压覆盖到各账号的 BGI 目录"
                               Style="{StaticResource Caption}" Margin="0,3,0,0" />
                </StackPanel>

                <!-- 更新包 -->
                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <TextBlock Text="更新源" Style="{StaticResource Label}" />
                    <ComboBox x:Name="UpdateSourceBox" SelectedIndex="0" Margin="0,7,0,0"
                              AutomationProperties.Name="BGI 更新源">
                        <ComboBoxItem Content="本地更新包" />
                        <ComboBoxItem Content="LCB / NexusBGI（GitHub Releases）" />
                    </ComboBox>
                    <StackPanel x:Name="LocalSourcePanel">
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="ZipBox" Grid.Column="0" Height="38"
                                 Style="{StaticResource GlassTextBox}"
                                 Padding="11,0,11,0" FontSize="12"
                                 VerticalContentAlignment="Center"
                                 IsReadOnly="True" />

                        <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                                Padding="14,8" Margin="8,0,0,0" Click="PickZip_Click">
                            <TextBlock Text="选择文件" FontSize="11.5" />
                        </Button>
                    </Grid>

                    <TextBlock Text="支持 zip / 7z / rar / tar / gz。解压后覆盖到 BGI 目录，包内多一层 BetterGI 文件夹会自动识别。"
                               Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Margin="0,5,0,0" />
                    </StackPanel>
                    <Grid x:Name="GitHubSourcePanel" Margin="0,7,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="GitHubReleaseText" Text="尚未检查 GitHub 发行版"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button x:Name="BtnCheckGitHub" Grid.Column="1" Style="{StaticResource GhostButton}"
                                Padding="14,8" Margin="8,0,0,0" Click="CheckGitHubRelease_Click"
                                Content="检查版本" />
                    </Grid>
                </StackPanel>

                <!-- 选项 -->
                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <CheckBox x:Name="BackupUserCheck"
                              Content="更新前备份 User 目录（保留配置和自定义脚本）"
                              Style="{StaticResource GlassCheckBox}"
                              IsChecked="True" FontSize="11.5" />
                    <StackPanel Orientation="Horizontal" Margin="20,3,0,0">
                        <TextBlock Text="备份到 SoulLink 数据目录，不占 BGI 空间、不会覆盖已有备份"
                                   Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button x:Name="BtnOpenBackup" Style="{StaticResource GhostButton}"
                                Padding="10,3" Margin="10,0,0,0" Click="OpenBackup_Click"
                                ToolTip="打开备份目录">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="10" VerticalAlignment="Center" />
                                <TextBlock Text="打开备份目录" Margin="5,0,0,0"
                                           FontSize="10.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- 账号列表 -->
                <StackPanel Grid.Row="3" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="选择要更新的账号" Style="{StaticResource Label}"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Padding="10,5"
                                    Click="SelectAll_Click" ToolTip="全选">
                                <TextBlock Text="全选" FontSize="11" />
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Padding="10,5"
                                    Margin="6,0,0,0" Click="SelectNone_Click" ToolTip="全不选">
                                <TextBlock Text="清空" FontSize="11" />
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Padding="10,5"
                                    Margin="6,0,0,0" Click="AddUser_Click" ToolTip="添加账号">
                                <TextBlock Text="+ 添加" FontSize="11" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- 账号列表滚动区 -->
                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                    <StackPanel x:Name="UserList" />
                </ScrollViewer>

                <!-- 底部按钮 -->
                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="BtnUpdate" Style="{StaticResource PrimaryButton}"
                            Padding="22,9" Click="StartUpdate_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="开始更新" Margin="7,0,0,0" FontSize="12"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnCancel" Style="{StaticResource GhostButton}"
                            Padding="18,9" Margin="10,0,0,0" Click="Cancel_Click"
                            Visibility="Collapsed">
                        <TextBlock Text="停止" FontSize="11.5" />
                    </Button>

                    <TextBlock x:Name="StatusText" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="14,0,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════ 右：进度 / 日志 ══════════ -->
        <Border Grid.Column="1" Width="380" Style="{StaticResource GlassCard}"
                Padding="16,16" Margin="14,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="更新进度" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" Margin="2,0,0,10" />

                <!-- 总进度条 -->
                <StackPanel Grid.Row="1" Margin="2,0,2,12">
                    <Grid Height="6">
                        <Border CornerRadius="3" Background="#18FFFFFF" />
                        <Border x:Name="ProgressFill" CornerRadius="3"
                                Background="{StaticResource CyanBrush}"
                                HorizontalAlignment="Left" Width="0" />
                    </Grid>
                    <TextBlock x:Name="ProgressText" Text="等待开始"
                               Style="{StaticResource Caption}" Margin="0,7,0,0" />
                </StackPanel>

                <!-- 日志 -->
                <Border Grid.Row="2" Style="{StaticResource GlassPanel}" Padding="11,9">
                    <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LogText" Text="" FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap" LineHeight="18"
                                   FontFamily="Consolas" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
