<Window x:Class="SoulLink.Views.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:SoulLink.Controls"
        Title="选择运行中的程序" Width="720" Height="520" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource WindowBackground}" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}">

    <Grid Margin="0">

        <Border CornerRadius="20" BorderBrush="{DynamicResource StrokeMid}" BorderThickness="1" ClipToBounds="True" Background="{DynamicResource DialogSurface}">

            <Grid Margin="22,18,22,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="DragArea" Grid.Row="0" Background="Transparent" MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                    <StackPanel>
                        <TextBlock Text="选择运行中的程序" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock x:Name="SubText" Text="从目标用户当前运行的程序里选一个，自动填好路径"
                                   FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource WindowButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Height="28" Click="Cancel_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                </Grid>

                <Border Grid.Row="1" CornerRadius="11" Background="{DynamicResource FieldBackground}" BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="1" Margin="0,14,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="12,0,8,0" />
                        <TextBox Grid.Column="1" x:Name="SearchBox" Style="{StaticResource GlassTextBox}"
                                 Background="Transparent" BorderThickness="0" Padding="0,9" TextChanged="SearchBox_TextChanged" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" CornerRadius="14" Background="{DynamicResource SubtleSurface}" BorderBrush="{DynamicResource StrokeSoft}" BorderThickness="1" Padding="2">
                    <ListBox x:Name="List" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource SessionItem}"
                             MouseDoubleClick="List_MouseDoubleClick">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ScrollViewer Focusable="False">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="{Binding ExePath}" FontSize="10.5"
                                                   Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Pid}" Style="{StaticResource Mono}"
                                               VerticalAlignment="Center" Margin="10,0,4,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButton}" Width="34" Height="34" Click="Reload_Click" ToolTip="刷新">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Padding="20,9" Margin="8,0,0,0" Click="Cancel_Click">
                            <TextBlock Text="取消" />
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Padding="24,9" Margin="10,0,0,0" Click="Ok_Click">
                            <TextBlock Text="使用这个程序" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
