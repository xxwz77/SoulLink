<UserControl x:Class="SoulLink.Views.LaunchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SoulLink.Controls"
             FontFamily="{StaticResource UiFont}">

    <UserControl.Resources>
        <Storyboard x:Key="SpinRefresh">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:0.7" RepeatBehavior="2x" />
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="LayoutRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <!-- ★★ 2.17.39：行高必须是 *，不能是 Auto ★★
             原本三行全 Auto：外层 Grid 的高度由内容决定，
             于是左侧 Border 里的 ScrollViewer **拿不到高度约束**（可用高度=无限），
             WPF 的 ScrollViewer 在无限高度下不会出现滚动条、也不会裁剪内容 ——
             表现就是用户看到的"主界面的框没有自适应大小了，滚动条也没了"，
             窗口缩小时内容溢出到面板之外。
             改成 * 后，Border 撑满窗口高度，ScrollViewer 拿到确定的高度：
               · 内容放得下 → 无需滚动，区块按内容自适应；
               · 内容放不下 → 出现竖向滚动条。
             左右两栏用同一套行定义，保证分隔线贯通、两栏等高。 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══════════ 左：运行状态 / 快捷动作 / 自动化 ══════════ -->
        <Border x:Name="LeftPanel" Grid.Column="0" Style="{StaticResource GlassCardStrong}" Padding="18,16">
            <!-- ★ 整栏可以滚动：内容（状态+动作+自动化）变多时不会互相遮挡。
                 用 ScrollViewer 包住整个 Grid，而不是让某一区域单独滚动 ——
                 这样三块的相对位置永远稳定，滚动条也只有一个。 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />   <!-- 标题 -->
                    <RowDefinition Height="Auto" />   <!-- 运行状态 -->
                    <RowDefinition Height="Auto" />   <!-- 快捷动作列表 -->
                    <RowDefinition Height="Auto" />   <!-- 自动化流程 -->
                </Grid.RowDefinitions>

                <!-- 页面标题：固定为"运行状态"（左栏主题） -->
                <Grid Grid.Row="0" Margin="2,0,2,12">
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Text="运行状态" Style="{StaticResource Title}" />
                        <TextBlock x:Name="PageSubtitle" Text="监控各挂机账号的 BGI 运行情况"
                                   Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <!-- 快捷动作：放在运行状态下方 -->
                <Grid Grid.Row="2" x:Name="ActionPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2,0,2,8">
                        <TextBlock Text="快捷动作" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                        <!-- 执行结果提示：出现在标题行中间，6 秒后自动消失 -->
                        <TextBlock x:Name="RunHint" Text="" FontSize="10.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="260"
                                   Visibility="Collapsed" Margin="70,0,70,0" />
                        <Button x:Name="BtnNewAction" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Right" Padding="10,5"
                                Click="NewAction_Click" ToolTip="新建动作">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" />
                                <TextBlock Text="新建" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                <!-- ★ ListBox 在 ScrollViewer 里会"无限高"（撑开整页），
                     所以给它一个上限高度并让它自己滚动。
                     这样：动作少时高度自适应，动作多时只在本区域内滚动。 -->
                <ListBox Grid.Row="1" x:Name="ActionList" Style="{StaticResource ActionListBox}"
                         MaxHeight="240"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="ActionList_SelectionChanged" Padding="0,2,4,2">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="11" VerticalAlignment="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#336C5CE7" Offset="0" />
                                            <GradientStop Color="#334FE3FF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="#FFEAF3FF" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding AccountName}" FontSize="11" Foreground="{StaticResource CyanBrush}" />
                                        <TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                        <TextBlock Text="{Binding ExeName}" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                    </StackPanel>

                                    <!-- 定时信息：只有配了定时的动作才显示 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                                Visibility="{Binding ScheduleVisibility}">
                                        <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                                        <TextBlock Text="{Binding NextRunText}" FontSize="10.5"
                                                   Foreground="{Binding NextRunBrush}"
                                                   VerticalAlignment="Center" Margin="5,0,0,0" />

                                    </StackPanel>
                                </StackPanel>

                                <!-- ★★ 2.17.26：四个按钮必须各有各的样子 ★★
                                     原来全是同一个灰色 IconButton + 30x30，
                                     而「定时暂停/恢复」和「立即执行」用的都是 ▶/⏸，
                                     肉眼完全分不清哪个是"定时计划"、哪个是"现在跑一次"。
                                     现在按语义分三档：
                                       · 定时开关 = 胶囊 + 文字（绿=定时生效 / 灰=定时已暂停）
                                       · 立即执行 = 胶囊 + ⚡ + "执行"（一次性，中性色）
                                       · 编辑/删除 = 小图标，中性色，删除 hover 变红 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border CornerRadius="7" Padding="8,3" Background="{Binding BadgeBg}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding KindText}" FontSize="10.5" Foreground="{Binding BadgeFg}" FontWeight="SemiBold" />
                                    </Border>

                                    <!-- 定时开关：只有配了定时的动作才显示（胶囊，带文字） -->
                                    <Button Style="{StaticResource PillButton}" Height="26" MinWidth="72"
                                            Margin="6,0,0,0" Padding="9,0,9,0"
                                            Click="PauseSchedule_Click" Tag="{Binding}"
                                            ToolTip="{Binding PauseTip}"
                                            Background="{Binding ScheduleToggleBg}"
                                            BorderBrush="{Binding ScheduleToggleBorder}"
                                            Visibility="{Binding ScheduleVisibility}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PauseGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                       VerticalAlignment="Center" Foreground="{Binding ScheduleToggleFg}" />
                                            <TextBlock Text="{Binding ScheduleToggleText}" FontSize="10.5" Margin="5,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{Binding ScheduleToggleFg}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- 立即执行：胶囊 + ⚡ + 文字（一次性，与定时开关无关） -->
                                    <Button Style="{StaticResource PillButton}" Height="26" MinWidth="64"
                                            Margin="6,0,0,0" Padding="9,0,9,0"
                                            Click="RunAction_Click" Tag="{Binding}"
                                            ToolTip="立即执行一次（不影响定时计划）"
                                            Background="#1FFFFFFF" BorderBrush="#40FFFFFF">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                       VerticalAlignment="Center" Foreground="#FFC8D6F0" />
                                            <TextBlock Text="执行" FontSize="10.5" Margin="5,0,0,0"
                                                       VerticalAlignment="Center" Foreground="#FFC8D6F0" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource IconButton}" Width="30" Height="30" Margin="4,0,0,0"
                                            Click="EditAction_Click" Tag="{Binding}" ToolTip="编辑">
                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="#FF9FB0D0" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="30" Height="30" Margin="2,0,0,0"
                                            Click="DeleteAction_Click" Tag="{Binding}" ToolTip="删除">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="#FFD08AA0" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                    <!-- 空状态提示：叠在动作列表区域内 -->
                    <StackPanel x:Name="EmptyHintHost" Grid.Row="1" IsHitTestVisible="False"
                                Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="66" Height="66" HorizontalAlignment="Center">
                            <Ellipse Stroke="#33C8E0FF" StrokeThickness="1.5" />
                            <Ellipse Width="40" Height="40">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#5533C3FF" Offset="0" />
                                        <GradientStop Color="#00113355" Offset="1" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="7" Height="7" Fill="#FF9FE8FF">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="1" Color="#FF4FE3FF" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <TextBlock Text="还没有快捷动作" FontSize="13" Foreground="{DynamicResource TextSecondary}"
                                   HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <TextBlock Text="点上方「新建」，只需要：账号 + 程序路径" FontSize="11.5"
                                   Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>

                <!-- 运行状态（当前所选会话的 BGI 运行情况） -->
                <Border Grid.Row="1" x:Name="StatusPanel" Style="{StaticResource GlassPanel}"
                        Padding="14,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 这里不再重复"运行状态"标题：外层 PageTitle 会按会话切换 -->
                        <TextBlock x:Name="StatusMeta" Grid.Row="0" Text="未检测"
                                   FontSize="10" Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" />

                        <!-- ① 单个账号的详细状态（选中挂机账号时） -->
                        <Grid x:Name="SingleStatusGrid" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="配置组 / 脚本" FontSize="9.5"
                                           Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Grid.Row="1" x:Name="StatusGroup" Text="—"
                                           FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource CyanBrush}"
                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                            </Grid>

                            <!-- 右列：轮次/角色 + 今日报错 -->
                            <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="8,0,0,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="轮次 / 角色" FontSize="9.5"
                                           Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Grid.Row="1" x:Name="StatusRound" Text="—"
                                           FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextWrapping="Wrap" Margin="0,3,0,0" />

                                <!-- 每日报错次数：有错误/失败才显示 -->
                                <TextBlock Grid.Row="2" x:Name="StatusErrorTitle" Text="今日报错"
                                           FontSize="9.5" Foreground="{DynamicResource TextMuted}"
                                           Margin="0,10,0,0" Visibility="Collapsed" />
                                <TextBlock Grid.Row="3" x:Name="StatusError" Text=""
                                           FontSize="10.5" TextWrapping="Wrap"
                                           Margin="0,3,0,0" Visibility="Collapsed" />
                            </Grid>

                            <!-- ★ 用 Grid 代替 StackPanel：StackPanel 在水平方向给子元素的
                                 可用宽度是"无限大"，TextWrapping 根本不会触发，
                                 路线名一长就撑出卡片（用户实测"文字太长不会换行"）。
                                 Grid 会把真实宽度传给子元素，换行才能生效。 -->
                            <Grid Grid.Row="1" Grid.ColumnSpan="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="当前路线" FontSize="9.5"
                                           Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Grid.Row="1" x:Name="StatusRoute" Text="—"
                                           FontSize="11" Foreground="{DynamicResource TextPrimary}"
                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                                <TextBlock Grid.Row="2" x:Name="StatusEta" Text=""
                                           FontSize="10" Foreground="{DynamicResource TextMuted}"
                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                            </Grid>

                            <!-- ③ 本次拾取：独占整行。点标题可展开"全天 / 按配置组" -->
                            <Border x:Name="StatusPicksBox" Grid.Row="3" Grid.ColumnSpan="2"
                                    Margin="0,8,0,0" Padding="10,8" CornerRadius="8"
                                    Background="#1AB8E6C8" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid x:Name="PicksHeader" Background="Transparent"
                                          Cursor="Hand" MouseLeftButtonUp="PicksHeader_Click">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 组名：允许换行，不再被截断 -->
                                        <TextBlock x:Name="StatusPicksTitle" Grid.Column="0" Text="本次拾取"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="PicksExpandHint" Grid.Column="1" Text="▾ 展开全天"
                                                   FontSize="9.5" Foreground="{DynamicResource TextMuted}"
                                                   VerticalAlignment="Top" Margin="8,0,0,0" />
                                    </Grid>
                                    <TextBlock x:Name="StatusPicks" Text=""
                                               FontSize="11.5" Foreground="#FFC8F0D8"
                                               TextWrapping="Wrap" LineHeight="19"
                                               Margin="0,4,0,0" />

                                    <!-- 展开后的"全天 / 按配置组"：
                                         组名用粗体+亮色，材料用细体+暗色，视觉上分层 -->
                                    <Border x:Name="DailyPicksPanel" Visibility="Collapsed"
                                            Margin="0,8,0,0" Padding="9,8" CornerRadius="6"
                                            Background="{DynamicResource FieldBackground}">
                                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="DailyPicksList" />
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- ④ 异常/失败信息：单独一行，红色，只在出问题时显示 -->
                            <Border x:Name="StatusProblemBox" Grid.Row="2" Grid.ColumnSpan="2"
                                    Margin="0,6,0,0" Padding="8,6" CornerRadius="6"
                                    Background="#2AFF6B6B" Visibility="Collapsed">
                                <TextBlock x:Name="StatusProblem" Text=""
                                           FontSize="10" Foreground="#FFFFB4B4"
                                           TextWrapping="Wrap" />
                            </Border>
                        </Grid>

                        <!-- ② 所有账号的运行监控总览（选中主会话时） -->
                        <StackPanel x:Name="OverviewPanel" Grid.Row="1" Margin="0,8,0,0"
                                    Visibility="Collapsed">
                            <TextBlock Text="正在监控以下挂机账号的 BGI 运行情况"
                                       FontSize="9.5" Foreground="{DynamicResource TextMuted}"
                                       Margin="0,0,0,8" />
                            <!-- 每个账号一行，运行时生成 -->
                            <StackPanel x:Name="OverviewList" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 自动化流程：标题在框外（与其他区域标题一致），内容在框内 -->
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 标题行：和「快捷动作」同款样式，且不在玻璃框内 -->
                    <Grid Grid.Row="0" Margin="2,0,2,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="自动化" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock x:Name="AutomationMeta" Text=""
                                       FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <Button x:Name="BtnNewAutomation" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Right" Padding="10,5"
                                Click="NewAutomation_Click" ToolTip="为当前账号新建一个自动化流程">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="新建" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 内容框：不加 MaxHeight / 不内嵌滚动条，
                         外层 ScrollViewer 统一滚动，避免"双重滚动条" -->
                    <Border Grid.Row="1" x:Name="AutomationPanel" Style="{StaticResource GlassPanel}"
                            Padding="10,8">
                        <StackPanel x:Name="AutomationList" />
                    </Border>
                </Grid>
            </Grid>
            </ScrollViewer>
        </Border>

        <!-- ══════════ 右：实时会话 ══════════ -->
        <Border x:Name="SessionPanel" Grid.Column="2" Style="{StaticResource GlassCard}" Padding="16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,12">
                    <StackPanel>
                        <TextBlock Text="在线会话" Style="{StaticResource Title}" />
                        <TextBlock Text="自动从系统会话读取（qwinsta）" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="RefreshSessions_Click" ToolTip="刷新">
                        <TextBlock x:Name="RefreshGlyph" Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="0" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>
                </Grid>

                <!-- ★ 2.17.39：会话列表放在 Grid 行 "*" 里，必须能自己滚动，
                     否则外层拿到确定高度后内容多会被直接裁掉（看不到的会话等于丢失）。 -->
                <ListBox Grid.Row="1" x:Name="SessionList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource SessionItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="SessionList_SelectionChanged">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ctl:GlowDot Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center"
                                             Color="{Binding DotColor}" Pulse="{Binding IsActive}" />
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <!-- 优先显示备注名：A2 · 山客 -->
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <!-- 单行：状态 ● 通道 ● BGI
                                         分隔圆点颜色固定（灰），不随任何状态变化，
                                         避免把颜色含义混淆到文字上 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding StateText}" FontSize="10.5"
                                                   Foreground="{Binding StateBrush}" />
                                        <TextBlock Text=" ● " FontSize="8" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMuted}" />
                                        <TextBlock Text="{Binding ChannelText}" FontSize="10.5"
                                                   Foreground="{Binding ChannelBrush}" />
                                        <TextBlock Text=" ● " FontSize="8" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Visibility="{Binding BgiVisibility}" />
                                        <TextBlock Text="{Binding BgiText}" FontSize="10.5"
                                                   Foreground="{Binding BgiBrush}"
                                                   Visibility="{Binding BgiVisibility}" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="2" CornerRadius="6" Padding="7,2" Background="#1CFFFFFF" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SideText}" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 底部：BGI 实时日志（点击会话即切换到这里显示该账号的日志） -->
                <Border Grid.Row="2" Style="{StaticResource GlassPanel}" Padding="12,10" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock x:Name="LogTitle" Text="原始日志"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource CyanBrush}" />
                            <TextBlock x:Name="LogMeta" Text="点击上方会话查看"
                                       FontSize="10" Foreground="{DynamicResource TextMuted}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock x:Name="TipText" Grid.Row="1"
                                   Text="实时跟随所选会话的 BetterGI 日志。"
                                   FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                                   TextWrapping="Wrap" Margin="0,5,0,0" />

                        <!-- 日志正文：等宽字体，只读，自动滚到底
                             ★ 2.17.39：去掉 MaxHeight 改用 MaxHeight 下限 + 自适应：
                               行高为 Auto 时 MaxHeight 是必要的（避免无限撑高），
                               但外层行高改成 * 后，这里应让日志区**填满剩余空间**，
                               同时保留 220 的上限，避免窗口很高时日志区无限拉长。 -->
                        <ScrollViewer x:Name="LogScroll" Grid.Row="2" Margin="0,6,0,0"
                                      MinHeight="80" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="LogText" Text=""
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="10" LineHeight="15"
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>