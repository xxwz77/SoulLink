<UserControl x:Class="SoulLink.Views.LaunchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:SoulLink.Controls"
             FontFamily="{StaticResource UiFont}">

    <UserControl.Resources>
        <Storyboard x:Key="SpinRefresh">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:0.7" RepeatBehavior="2x" />
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="330" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- ══════════ 左：快捷动作 ══════════ -->
        <Border Grid.Column="0" Style="{StaticResource GlassCardStrong}" Padding="18,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />   <!-- 标题 -->
                    <RowDefinition Height="Auto" />   <!-- 运行状态（始终在顶部） -->
                    <RowDefinition Height="*" />      <!-- 快捷动作列表（仅主会话） -->
                    <RowDefinition Height="Auto" />   <!-- 执行按钮（仅主会话） -->
                </Grid.RowDefinitions>

                <!-- 页面标题：固定为"运行状态"（左栏主题） -->
                <Grid Grid.Row="0" Margin="2,0,2,12">
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Text="运行状态" Style="{StaticResource Title}" />
                        <TextBlock x:Name="PageSubtitle" Text="监控各挂机账号的 BGI 运行情况"
                                   Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <!-- 快捷动作：放在运行状态下方 -->
                <Grid Grid.Row="2" x:Name="ActionPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2,0,2,8">
                        <TextBlock Text="快捷动作" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                        <Button x:Name="BtnNewAction" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Right" Padding="10,5"
                                Click="NewAction_Click" ToolTip="新建动作">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" />
                                <TextBlock Text="新建" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                <ListBox Grid.Row="1" x:Name="ActionList" Style="{StaticResource ActionListBox}"
                         SelectionChanged="ActionList_SelectionChanged" Padding="0,2,4,2">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="11" VerticalAlignment="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#336C5CE7" Offset="0" />
                                            <GradientStop Color="#334FE3FF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="#FFEAF3FF" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding AccountName}" FontSize="11" Foreground="{StaticResource CyanBrush}" />
                                        <TextBlock Text=" · " FontSize="11" Foreground="{StaticResource TextMuted}" />
                                        <TextBlock Text="{Binding ExeName}" FontSize="11" Foreground="{StaticResource TextMuted}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border CornerRadius="7" Padding="8,3" Background="{Binding BadgeBg}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding KindText}" FontSize="10.5" Foreground="{Binding BadgeFg}" FontWeight="SemiBold" />
                                    </Border>
                                    <Button Style="{StaticResource IconButton}" Width="30" Height="30" Margin="6,0,0,0"
                                            Click="RunAction_Click" Tag="{Binding}" ToolTip="立即执行">
                                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="30" Height="30"
                                            Click="EditAction_Click" Tag="{Binding}" ToolTip="编辑">
                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="1" x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed" IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center">
                        <Grid Width="66" Height="66" HorizontalAlignment="Center">
                            <Ellipse Stroke="#33C8E0FF" StrokeThickness="1.5" />
                            <Ellipse Width="40" Height="40">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#5533C3FF" Offset="0" />
                                        <GradientStop Color="#00113355" Offset="1" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="7" Height="7" Fill="#FF9FE8FF">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="1" Color="#FF4FE3FF" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <TextBlock Text="还没有快捷动作" FontSize="13" Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <TextBlock Text="点右上角「新建」，只需要：账号 + 程序路径" FontSize="11.5"
                                   Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
                </Grid>

                <!-- 运行状态（当前所选会话的 BGI 运行情况） -->
                <Border Grid.Row="1" x:Name="StatusPanel" Style="{StaticResource GlassPanel}"
                        Padding="14,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 这里不再重复"运行状态"标题：外层 PageTitle 会按会话切换 -->
                        <TextBlock x:Name="StatusMeta" Grid.Row="0" Text="未检测"
                                   FontSize="10" Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" />

                        <!-- ① 单个账号的详细状态（选中挂机账号时） -->
                        <Grid x:Name="SingleStatusGrid" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                <TextBlock Text="配置组 / 脚本" FontSize="9.5"
                                           Foreground="{StaticResource TextMuted}" />
                                <TextBlock x:Name="StatusGroup" Text="—"
                                           FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource CyanBrush}"
                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>

                            <!-- 右列：轮次/角色 + 本路线拾取（占满右侧空白） -->
                            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="8,0,0,8">
                                <TextBlock Text="轮次 / 角色" FontSize="9.5"
                                           Foreground="{StaticResource TextMuted}" />
                                <TextBlock x:Name="StatusRound" Text="—"
                                           FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           TextWrapping="Wrap" Margin="0,3,0,0" />

                                <!-- 每日报错次数：有错误/失败才显示 -->
                                <TextBlock x:Name="StatusErrorTitle" Text="今日报错"
                                           FontSize="9.5" Foreground="{StaticResource TextMuted}"
                                           Margin="0,10,0,0" Visibility="Collapsed" />
                                <TextBlock x:Name="StatusError" Text=""
                                           FontSize="10.5" TextWrapping="Wrap"
                                           Margin="0,3,0,0" Visibility="Collapsed" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                                <TextBlock Text="当前路线" FontSize="9.5"
                                           Foreground="{StaticResource TextMuted}" />
                                <TextBlock x:Name="StatusRoute" Text="—"
                                           FontSize="11" Foreground="{StaticResource TextPrimary}"
                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                                <TextBlock x:Name="StatusEta" Text=""
                                           FontSize="10" Foreground="{StaticResource TextMuted}"
                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>

                            <!-- ③ 本次拾取：独占整行。点标题可展开"全天 / 按配置组" -->
                            <Border x:Name="StatusPicksBox" Grid.Row="3" Grid.ColumnSpan="2"
                                    Margin="0,8,0,0" Padding="10,8" CornerRadius="8"
                                    Background="#1AB8E6C8" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid x:Name="PicksHeader" Background="Transparent"
                                          Cursor="Hand" MouseLeftButtonUp="PicksHeader_Click">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 组名：允许换行，不再被截断 -->
                                        <TextBlock x:Name="StatusPicksTitle" Grid.Column="0" Text="本次拾取"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMuted}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="PicksExpandHint" Grid.Column="1" Text="▾ 展开全天"
                                                   FontSize="9.5" Foreground="{StaticResource TextMuted}"
                                                   VerticalAlignment="Top" Margin="8,0,0,0" />
                                    </Grid>
                                    <TextBlock x:Name="StatusPicks" Text=""
                                               FontSize="11.5" Foreground="#FFC8F0D8"
                                               TextWrapping="Wrap" LineHeight="19"
                                               Margin="0,4,0,0" />

                                    <!-- 展开后的"全天 / 按配置组"：
                                         组名用粗体+亮色，材料用细体+暗色，视觉上分层 -->
                                    <Border x:Name="DailyPicksPanel" Visibility="Collapsed"
                                            Margin="0,8,0,0" Padding="9,8" CornerRadius="6"
                                            Background="#18000000">
                                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="DailyPicksList" />
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- ④ 异常/失败信息：单独一行，红色，只在出问题时显示 -->
                            <Border x:Name="StatusProblemBox" Grid.Row="2" Grid.ColumnSpan="2"
                                    Margin="0,6,0,0" Padding="8,6" CornerRadius="6"
                                    Background="#2AFF6B6B" Visibility="Collapsed">
                                <TextBlock x:Name="StatusProblem" Text=""
                                           FontSize="10" Foreground="#FFFFB4B4"
                                           TextWrapping="Wrap" />
                            </Border>
                        </Grid>

                        <!-- ② 所有账号的运行监控总览（选中主会话时） -->
                        <StackPanel x:Name="OverviewPanel" Grid.Row="1" Margin="0,8,0,0"
                                    Visibility="Collapsed">
                            <TextBlock Text="正在监控以下挂机账号的 BGI 运行情况"
                                       FontSize="9.5" Foreground="{StaticResource TextMuted}"
                                       Margin="0,0,0,8" />
                            <!-- 每个账号一行，运行时生成 -->
                            <StackPanel x:Name="OverviewList" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 底部：执行 + 命令 -->
                <Border Grid.Row="3" x:Name="RunPanel" Style="{StaticResource GlassPanel}" Padding="14,12" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Row="0" Grid.Column="0" x:Name="BtnRun" Style="{StaticResource PrimaryButton}"
                                Click="RunSelected_Click" Margin="0,0,12,0" MinWidth="132">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="执行选中动作" Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border Grid.Row="0" Grid.Column="1" CornerRadius="10" Background="#14000000"
                                BorderBrush="#22FFFFFF" BorderThickness="1" Padding="10,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="CmdPreview" Text="—" Style="{StaticResource Mono}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="26" Height="26"
                                        Click="CopyCmd_Click" ToolTip="复制命令">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                                </Button>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,11,0,0">
                            <Button Style="{StaticResource GhostButton}" Click="ChangePassword_Click" Padding="11,6">
                                <TextBlock Text="改密码" FontSize="11.5" />
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="DeleteAction_Click" Padding="11,6" Margin="8,0,0,0">
                                <TextBlock Text="删除动作" FontSize="11.5" />
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="BrowseExe_Click" Padding="11,6" Margin="8,0,0,0">
                                <TextBlock Text="换程序" FontSize="11.5" />
                            </Button>
                            <TextBlock x:Name="LastRunText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                       Margin="14,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════ 右：实时会话 ══════════ -->
        <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,12">
                    <StackPanel>
                        <TextBlock Text="在线会话" Style="{StaticResource Title}" />
                        <TextBlock Text="自动从 query user 读取" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="RefreshSessions_Click" ToolTip="刷新">
                        <TextBlock x:Name="RefreshGlyph" Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="0" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>
                </Grid>

                <ListBox Grid.Row="1" x:Name="SessionList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource SessionItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="SessionList_SelectionChanged">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ctl:GlowDot Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center"
                                             Color="{Binding DotColor}" Pulse="{Binding IsActive}" />
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <!-- 优先显示备注名：A2 · 山客 -->
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <!-- 单行：状态 ● 通道 ● BGI
                                         分隔圆点颜色固定（灰），不随任何状态变化，
                                         避免把颜色含义混淆到文字上 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding StateText}" FontSize="10.5"
                                                   Foreground="{Binding StateBrush}" />
                                        <TextBlock Text=" ● " FontSize="8" VerticalAlignment="Center"
                                                   Foreground="#66AABBCC" />
                                        <TextBlock Text="{Binding ChannelText}" FontSize="10.5"
                                                   Foreground="{Binding ChannelBrush}" />
                                        <TextBlock Text=" ● " FontSize="8" VerticalAlignment="Center"
                                                   Foreground="#66AABBCC"
                                                   Visibility="{Binding BgiVisibility}" />
                                        <TextBlock Text="{Binding BgiText}" FontSize="10.5"
                                                   Foreground="{Binding BgiBrush}"
                                                   Visibility="{Binding BgiVisibility}" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="2" CornerRadius="6" Padding="7,2" Background="#1CFFFFFF" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SideText}" FontSize="10" Foreground="{StaticResource TextSecondary}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 底部：BGI 实时日志（点击会话即切换到这里显示该账号的日志） -->
                <Border Grid.Row="2" Style="{StaticResource GlassPanel}" Padding="12,10" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock x:Name="LogTitle" Text="原始日志"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource CyanBrush}" />
                            <TextBlock x:Name="LogMeta" Text="点击上方会话查看"
                                       FontSize="10" Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock x:Name="TipText" Grid.Row="1"
                                   Text="实时跟随所选会话的 BetterGI 日志。"
                                   FontSize="10.5" Foreground="{StaticResource TextMuted}"
                                   TextWrapping="Wrap" Margin="0,5,0,0" />

                        <!-- 日志正文：等宽字体，只读，自动滚到底 -->
                        <ScrollViewer x:Name="LogScroll" Grid.Row="2" Margin="0,6,0,0"
                                      MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="LogText" Text=""
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="10" LineHeight="15"
                                       Foreground="{StaticResource TextSecondary}"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>